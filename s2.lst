     995/    128C :                     
     996/    128C :                     		include "_inc/DMA-Queue.asm"
(1)    1/    128C :                     ; ---------------------------------------------------------------------------
(1)    2/    128C :                     ; MACRO ResetDMAQueue
(1)    3/    128C :                     ; Clears the DMA queue, discarding all previously-queued DMAs.
(1)    4/    128C :                     ; ---------------------------------------------------------------------------
(1)    5/    128C :                     ; ROUTINE Process_DMA_Queue / ProcessDMAQueue
(1)    6/    128C :                     ; Performs all queued DMA transfers and clears the DMA queue.
(1)    7/    128C :                     ;
(1)    8/    128C :                     ; Output:
(1)    9/    128C :                     ; 	a1,a5	trashed
(1)   10/    128C :                     ; ---------------------------------------------------------------------------
(1)   11/    128C :                     ; ROUTINE InitDMAQueue
(1)   12/    128C :                     ; Pre-initializes the DMA queue with VDP register numbers in alternating bytes.
(1)   13/    128C :                     ; Must be called before the queue is used, and the queue expects that only it
(1)   14/    128C :                     ; write to this region of RAM.
(1)   15/    128C :                     ;
(1)   16/    128C :                     ; Output:
(1)   17/    128C :                     ; 	a0,d0,d1	trashed
(1)   18/    128C :                     ; ---------------------------------------------------------------------------
(1)   19/    128C :                     ; ROUTINE Add_To_DMA_Queue / QueueDMATransfer
(1)   20/    128C :                     ; Queues a DMA with parameters given in registers.
(1)   21/    128C :                     ;
(1)   22/    128C :                     ; Options:
(1)   23/    128C :                     ; 	AssumeSourceAddressInBytes (default 1)
(1)   24/    128C :                     ; 	AssumeSourceAddressIsRAMSafe (default 0)
(1)   25/    128C :                     ; 	UseRAMSourceSafeDMA (default 1&(AssumeSourceAddressIsRAMSafe==0))
(1)   26/    128C :                     ; 	Use128kbSafeDMA (default 0)
(1)   27/    128C :                     ; 	UseVIntSafeDMA (default 0)
(1)   28/    128C :                     ; Input:
(1)   29/    128C :                     ; 	d1	Source address (in bytes, or in words if AssumeSourceAddressInBytes is
(1)   30/    128C :                     ; 		set to 0)
(1)   31/    128C :                     ; 	d2	Destination address
(1)   32/    128C :                     ; 	d3	Transfer length (in words)
(1)   33/    128C :                     ; Output:
(1)   34/    128C :                     ; 	d0,d1,d2,d3,a1	trashed
(1)   35/    128C :                     ;
(1)   36/    128C :                     ; With the default settings, runs in:
(1)   37/    128C :                     ; * 48(11/0) cycles if queue is full (DMA discarded)
(1)   38/    128C :                     ; * 184(29/9) cycles otherwise (DMA queued)
(1)   39/    128C :                     ;
(1)   40/    128C :                     ; With Use128kbSafeDMA = 1, runs in:
(1)   41/    128C :                     ; * 48(11/0) cycles if queue is full at the start (DMA discarded)
(1)   42/    128C :                     ; * 200(32/9) cycles if the DMA does not cross a 128kB boundary (DMA queued)
(1)   43/    128C :                     ; * 226(38/9) cycles if the DMA crosses a 128kB boundary, and the first piece
(1)   44/    128C :                     ;   fills the queue (second piece is discarded)
(1)   45/    128C :                     ; * 338(56/17) cycles if the DMA crosses a 128kB boundary, and the queue has
(1)   46/    128C :                     ;   space for both pieces (both pieces queued)
(1)   47/    128C :                     ;
(1)   48/    128C :                     ; Setting UseVIntSafeDMA to 1 adds 46(6/1) cycles to all times.
(1)   49/    128C :                     ;
(1)   50/    128C :                     ; Setting AssumeSourceAddressInBytes to 0 reduces all times by 10(1/0) cycles,
(1)   51/    128C :                     ; but only if the DMA is not entirely discarded. However, all callers must be
(1)   52/    128C :                     ; edited to make sure the adresss given is in the correct form; you can use
(1)   53/    128C :                     ; the dmaSource function for that, which also sanitizes RAM addresses.
(1)   54/    128C :                     ;
(1)   55/    128C :                     ; Setting AssumeSourceAddressIsRAMSafe to 1, or UseRAMSourceSafeDMA to 0,
(1)   56/    128C :                     ; reduces all times by 14(2/0) cycles, but only if the DMA is not entirely
(1)   57/    128C :                     ; discarded. However, all callers must be edited to make sure the adresss given
(1)   58/    128C :                     ; in the correct form.
(1)   59/    128C :                     ; ---------------------------------------------------------------------------
(1)   60/    128C :                     ; MACRO QueueStaticDMA
(1)   61/    128C :                     ; Directly queues a DMA on the spot. Requires all parameters to be known at
(1)   62/    128C :                     ; assembly time; that is, no registers. Gives assembly errors when the DMA
(1)   63/    128C :                     ; crosses a 128kB boundary, is at an odd ROM location, or is zero length.
(1)   64/    128C :                     ;
(1)   65/    128C :                     ; The destination parameter can be either:
(1)   66/    128C :                     ; * a VRAM address literal;
(1)   67/    128C :                     ; * a register initialized with `move.l	#vdpComm(dest,VRAM,DMA)`
(1)   68/    128C :                     ; * a register initialized with `vdpCommReg <reg>,VRAM,DMA`
(1)   69/    128C :                     ;
(1)   70/    128C :                     ; Options:
(1)   71/    128C :                     ; 	UseVIntSafeDMA (default 0)
(1)   72/    128C :                     ; Input:
(1)   73/    128C :                     ; 	Source address (in bytes), transfer length (in bytes), destination address
(1)   74/    128C :                     ; Output:
(1)   75/    128C :                     ; 	d0,a1	trashed; avoid using these for passing destination as a register
(1)   76/    128C :                     ;
(1)   77/    128C :                     ; With the default settings, runs in:
(1)   78/    128C :                     ; * 32(7/0) cycles if queue is full (DMA discarded)
(1)   79/    128C :                     ; * 122(21/8) cycles otherwise (DMA queued)
(1)   80/    128C :                     ; Passing a register as destination is faster by 8(2/0) when the DMA is queued,
(1)   81/    128C :                     ; but requires initializing the register elsewhere, which is probably slower.
(1)   82/    128C :                     ;
(1)   83/    128C :                     ; Setting UseVIntSafeDMA to 1 adds 46(6/1) cycles to both cases.
(1)   84/    128C :                     ; ===========================================================================
(1)   85/    128C :                     ; option: AssumeSourceAddressInBytes
(1)   86/    128C :                     ;
(1)   87/    128C :                     ; This option makes the function work as a drop-in replacement of the original
(1)   88/    128C :                     ; functions. If you modify all callers to supply a position in words instead of
(1)   89/    128C :                     ; bytes (i.e., divide source address by 2) you can set this to 0 to gain 10(1/0)
(1)   90/    128C : =$1                  AssumeSourceAddressInBytes = 1
(1)   91/    128C :                     ; ===========================================================================
(1)   92/    128C :                     ; option: AssumeSourceAddressIsRAMSafe
(1)   93/    128C :                     ;
(1)   94/    128C :                     ; This option (which is disabled by default) makes the DMA queue assume that the
(1)   95/    128C :                     ; source address is given to the function in a way that makes them safe to use
(1)   96/    128C :                     ; with RAM sources. You need to edit all callers to ensure this.
(1)   97/    128C :                     ; Enabling this option turns off UseRAMSourceSafeDMA, and saves 14(2/0).
(1)   98/    128C : =$0                  AssumeSourceAddressIsRAMSafe = 0
(1)   99/    128C :                     ; ===========================================================================
(1)  100/    128C :                     ; option: UseRAMSourceSafeDMA
(1)  101/    128C :                     ;
(1)  102/    128C :                     ; This option (which is enabled by default) makes source addresses in RAM safe
(1)  103/    128C :                     ; at the cost of 14(2/0). If you modify all callers so as to clear the top byte
(1)  104/    128C :                     ; of source addresses (i.e., by ANDing them with $FFFFFF).
(1)  105/    128C : =$1                  UseRAMSourceSafeDMA = 1&(AssumeSourceAddressIsRAMSafe==0)
(1)  106/    128C :                     ; ===========================================================================
(1)  107/    128C :                     ; option: Use128kbSafeDMA
(1)  108/    128C :                     ;
(1)  109/    128C :                     ; This option breaks DMA transfers that crosses a 128kB block into two. It is
(1)  110/    128C :                     ; disabled by default because you can simply align the art in ROM and avoid the
(1)  111/    128C :                     ; issue altogether. It is here so that you have a high-performance routine to do
(1)  112/    128C :                     ; the job in situations where you can't align it in ROM.
(1)  113/    128C : =$0                  Use128kbSafeDMA = 0
(1)  114/    128C :                     ; ===========================================================================
(1)  115/    128C :                     ; option UseVIntSafeDMA
(1)  116/    128C :                     ;
(1)  117/    128C :                     ; Option to mask interrupts while updating the DMA queue. This fixes many race
(1)  118/    128C :                     ; conditions in the DMA funcion, but it costs 46(6/1) cycles. The better way to
(1)  119/    128C :                     ; handle these race conditions would be to make unsafe callers (such as S3&K's
(1)  120/    128C :                     ; KosM decoder) prevent these by masking off interrupts before calling and then
(1)  121/    128C :                     ; restore interrupts after.
(1)  122/    128C : =$0                  UseVIntSafeDMA = 0
