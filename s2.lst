(2)  543/   74164 :                     
(2)  544/   74164 :                     ; EFxx[yy] - Set Voice of FM channel to xx; xx < 0 means yy present
(2)  545/   74164 :                     smpsFMvoice macro voice,songID
(2)  546/   74164 :                     	if (SonicDriverVer>=3)&&("songID"<>"")
(2)  547/   74164 :                     		dc.b	$EF,voice|$80,songID+$81
(2)  548/   74164 :                     	else
(2)  549/   74164 :                     		dc.b	$EF,voice
(2)  550/   74164 :                     	endif
(2)  551/   74164 :                     	endm
(2)  552/   74164 :                     
(2)  553/   74164 :                     ; F0wwxxyyzz - Modulation - ww: wait time - xx: modulation speed - yy: change per step - zz: number of steps
(2)  554/   74164 :                     smpsModSet macro wait,speed,change,step
(2)  555/   74164 :                     	dc.b	$F0
(2)  556/   74164 :                     	if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  557/   74164 :                     		dc.b	wait+1,speed,change,((step+1) * speed) & $FF
(2)  558/   74164 :                     	elseif (SonicDriverVer<3)&&(SourceDriver>=3)
(2)  559/   74164 :                     		dc.b	wait-1,speed,change,conv0To256(step)/conv0To256(speed)-1
(2)  560/   74164 :                     	else
(2)  561/   74164 :                     		dc.b	wait,speed,change,step
(2)  562/   74164 :                     	endif
(2)  563/   74164 :                     	;dc.b	speed,change,step
(2)  564/   74164 :                     	endm
(2)  565/   74164 :                     
(2)  566/   74164 :                     ; Turn on Modulation
