(2)  789/   74164 :                     ; Macros for FM instruments
(2)  790/   74164 :                     ; Voices - Feedback
(2)  791/   74164 :                     smpsVcFeedback macro val
(2)  792/   74164 :                     vcFeedback eval val
(2)  793/   74164 :                     	endm
(2)  794/   74164 :                     
(2)  795/   74164 :                     ; Voices - Algorithm
(2)  796/   74164 :                     smpsVcAlgorithm macro val
(2)  797/   74164 :                     vcAlgorithm eval val
(2)  798/   74164 :                     	endm
(2)  799/   74164 :                     
(2)  800/   74164 :                     smpsVcUnusedBits macro val,d1r1,d1r2,d1r3,d1r4
(2)  801/   74164 :                     vcUnusedBits eval val
(2)  802/   74164 :                     	if ("d1r1"<>"")&&("d1r2"<>"")&&("d1r3"<>"")&&("d1r4"<>"")
(2)  803/   74164 :                     		eval vcD1R1Unk,d1r1<<5
(2)  804/   74164 :                     		eval vcD1R2Unk,d1r2<<5
(2)  805/   74164 :                     		eval vcD1R3Unk,d1r3<<5
(2)  806/   74164 :                     		eval vcD1R4Unk,d1r4<<5
(2)  807/   74164 :                     	else
(2)  808/   74164 :                     		eval vcD1R1Unk,0
(2)  809/   74164 :                     		eval vcD1R2Unk,0
(2)  810/   74164 :                     		eval vcD1R3Unk,0
(2)  811/   74164 :                     		eval vcD1R4Unk,0
(2)  812/   74164 :                     	endif
(2)  813/   74164 :                     	endm
(2)  814/   74164 :                     
(2)  815/   74164 :                     ; Voices - Detune
(2)  816/   74164 :                     smpsVcDetune macro op1,op2,op3,op4
(2)  817/   74164 :                     	eval vcDT1,op1
(2)  818/   74164 :                     	eval vcDT2,op2
(2)  819/   74164 :                     	eval vcDT3,op3
(2)  820/   74164 :                     	eval vcDT4,op4
(2)  821/   74164 :                     	endm
(2)  822/   74164 :                     
(2)  823/   74164 :                     ; Voices - Coarse-Frequency
(2)  824/   74164 :                     smpsVcCoarseFreq macro op1,op2,op3,op4
(2)  825/   74164 :                     	eval vcCF1,op1
(2)  826/   74164 :                     	eval vcCF2,op2
(2)  827/   74164 :                     	eval vcCF3,op3
(2)  828/   74164 :                     	eval vcCF4,op4
(2)  829/   74164 :                     	endm
(2)  830/   74164 :                     
(2)  831/   74164 :                     ; Voices - Rate Scale
(2)  832/   74164 :                     smpsVcRateScale macro op1,op2,op3,op4
(2)  833/   74164 :                     	eval vcRS1,op1
(2)  834/   74164 :                     	eval vcRS2,op2
(2)  835/   74164 :                     	eval vcRS3,op3
(2)  836/   74164 :                     	eval vcRS4,op4
(2)  837/   74164 :                     	endm
(2)  838/   74164 :                     
(2)  839/   74164 :                     ; Voices - Attack Rate
(2)  840/   74164 :                     smpsVcAttackRate macro op1,op2,op3,op4
(2)  841/   74164 :                     	eval vcAR1,op1
(2)  842/   74164 :                     	eval vcAR2,op2
(2)  843/   74164 :                     	eval vcAR3,op3
(2)  844/   74164 :                     	eval vcAR4,op4
(2)  845/   74164 :                     	endm
(2)  846/   74164 :                     
(2)  847/   74164 :                     ; Voices - Amplitude Modulation
(2)  848/   74164 :                     ; The original SMPS2ASM erroneously assumed the 6th and 7th bits
(2)  849/   74164 :                     ; were the Amplitude Modulation.
(2)  850/   74164 :                     ; According to several docs, however, it's actually the high bit.
(2)  851/   74164 :                     smpsVcAmpMod macro op1,op2,op3,op4
(2)  852/   74164 :                     	if SourceSMPS2ASM==0
(2)  853/   74164 :                     		eval vcAM1,op1<<5
(2)  854/   74164 :                     		eval vcAM2,op2<<5
(2)  855/   74164 :                     		eval vcAM3,op3<<5
(2)  856/   74164 :                     		eval vcAM4,op4<<5
(2)  857/   74164 :                     	else
(2)  858/   74164 :                     		eval vcAM1,op1<<7
(2)  859/   74164 :                     		eval vcAM2,op2<<7
(2)  860/   74164 :                     		eval vcAM3,op3<<7
(2)  861/   74164 :                     		eval vcAM4,op4<<7
(2)  862/   74164 :                     	endif
(2)  863/   74164 :                     	endm
(2)  864/   74164 :                     
(2)  865/   74164 :                     ; Voices - First Decay Rate
(2)  866/   74164 :                     smpsVcDecayRate1 macro op1,op2,op3,op4
(2)  867/   74164 :                     	eval vcD1R1,op1
(2)  868/   74164 :                     	eval vcD1R2,op2
(2)  869/   74164 :                     	eval vcD1R3,op3
(2)  870/   74164 :                     	eval vcD1R4,op4
(2)  871/   74164 :                     	endm
(2)  872/   74164 :                     
(2)  873/   74164 :                     ; Voices - Second Decay Rate
(2)  874/   74164 :                     smpsVcDecayRate2 macro op1,op2,op3,op4
(2)  875/   74164 :                     	eval vcD2R1,op1
(2)  876/   74164 :                     	eval vcD2R2,op2
(2)  877/   74164 :                     	eval vcD2R3,op3
(2)  878/   74164 :                     	eval vcD2R4,op4
(2)  879/   74164 :                     	endm
(2)  880/   74164 :                     
(2)  881/   74164 :                     ; Voices - Decay Level
(2)  882/   74164 :                     smpsVcDecayLevel macro op1,op2,op3,op4
(2)  883/   74164 :                     	eval vcDL1,op1
(2)  884/   74164 :                     	eval vcDL2,op2
(2)  885/   74164 :                     	eval vcDL3,op3
(2)  886/   74164 :                     	eval vcDL4,op4
(2)  887/   74164 :                     	endm
(2)  888/   74164 :                     
(2)  889/   74164 :                     ; Voices - Release Rate
(2)  890/   74164 :                     smpsVcReleaseRate macro op1,op2,op3,op4
(2)  891/   74164 :                     	eval vcRR1,op1
(2)  892/   74164 :                     	eval vcRR2,op2
(2)  893/   74164 :                     	eval vcRR3,op3
(2)  894/   74164 :                     	eval vcRR4,op4
(2)  895/   74164 :                     	endm
(2)  896/   74164 :                     
(2)  897/   74164 :                     smpsNotZ80 function cpu,(cpu<>128)&&(cpu<>32988)
(2)  898/   74164 :                     
(2)  899/   74164 :                     smpsDcb macro
(2)  900/   74164 :                     		if smpsNotZ80(MOMCPU)
(2)  901/   74164 :                     			dc.b ALLARGS
(2)  902/   74164 :                     		else
(2)  903/   74164 :                     			db ALLARGS
(2)  904/   74164 :                     		endif
(2)  905/   74164 :                     	endm
(2)  906/   74164 :                     
(2)  907/   74164 :                     ; Voices - Total Level
(2)  908/   74164 :                     ; The original SMPS2ASM decides TL high bits automatically,
(2)  909/   74164 :                     ; but later versions leave it up to the user.
(2)  910/   74164 :                     ; Alternatively, if we're converting an SMPS 68k song to SMPS Z80,
(2)  911/   74164 :                     ; then we *want* the TL bits to match the algorithm, because SMPS 68k
(2)  912/   74164 :                     ; prefers the algorithm over the TL bits, ignoring the latter, while
(2)  913/   74164 :                     ; SMPS Z80 does the opposite.
(2)  914/   74164 :                     ; Unfortunately, there's nothing we can do if we're trying to convert
(2)  915/   74164 :                     ; an SMPS Z80 song to SMPS 68k. It will ignore the bits no matter
(2)  916/   74164 :                     ; what we do, so we just print a warning.
(2)  917/   74164 :                     smpsVcTotalLevel macro op1,op2,op3,op4
(2)  918/   74164 :                     	eval vcTL1,op1
(2)  919/   74164 :                     	eval vcTL2,op2
(2)  920/   74164 :                     	eval vcTL3,op3
(2)  921/   74164 :                     	eval vcTL4,op4
(2)  922/   74164 :                     	smpsDcb	(vcUnusedBits<<6)+(vcFeedback<<3)+vcAlgorithm
(2)  923/   74164 :                     ;   0     1     2     3     4     5     6     7
(2)  924/   74164 :                     ;%1000,%1000,%1000,%1000,%1010,%1110,%1110,%1111
(2)  925/   74164 :                     	if SourceSMPS2ASM==0
(2)  926/   74164 :                     		eval vcTLMask4,((vcAlgorithm==7)<<7)
(2)  927/   74164 :                     		eval vcTLMask3,((vcAlgorithm>=4)<<7)
(2)  928/   74164 :                     		eval vcTLMask2,((vcAlgorithm>=5)<<7)
(2)  929/   74164 :                     		eval vcTLMask1,128
(2)  930/   74164 :                     	else
(2)  931/   74164 :                     		eval vcTLMask4,0
(2)  932/   74164 :                     		eval vcTLMask3,0
(2)  933/   74164 :                     		eval vcTLMask2,0
(2)  934/   74164 :                     		eval vcTLMask1,0
(2)  935/   74164 :                     	endif
(2)  936/   74164 :                     
(2)  937/   74164 :                     	if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  938/   74164 :                     		eval vcTLMask4,((vcAlgorithm==7)<<7)
(2)  939/   74164 :                     		eval vcTLMask3,((vcAlgorithm>=4)<<7)
(2)  940/   74164 :                     		eval vcTLMask2,((vcAlgorithm>=5)<<7)
(2)  941/   74164 :                     		eval vcTLMask1,128
