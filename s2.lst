   13828/   4164C :                     ; ---------------------------------------------------------------------------
   13829/   4164C :                     ; Leftover symbol tables due to compiler weirdness; these are formatted
   13830/   4164C :                     ; with a Unix ($0A) line break instead of a DOS ($0D0A) line break and it's
   13831/   4164C :                     ; also using big-endian integers, which suggest Sonic 2 wasn't developed in
   13832/   4164C :                     ; DOS (or at least a little-endian environment.)
   13833/   4164C :                     ; in addition, the locations that can be extracted don't even match up with
   13834/   4164C :                     ; the prototype.
   13835/   4164C :                     ;
   13836/   4164C :                     ; Read more about it here:
   13837/   4164C :                     ; https://clownacy.wordpress.com/2022/03/30/everything-that-i-know-about-sonic-the-hedgehogs-source-code/
   13838/   4164C :                     ; https://tcrf.net/Proto:Sonic_the_Hedgehog_2_(Genesis)/Nick_Arcade_Prototype/Symbol_Tables
   13839/   4164C :                     ; ---------------------------------------------------------------------------
   13840/   4164C :                     		binclude	"leftovers/symbols/symbol1.bin"
