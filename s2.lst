    2088/    2AA0 :                     ; Subroutine to generate a pseudo-random number in d0
    2089/    2AA0 :                     ; d0 = (RNG & $FFFF0000) | ((RNG*41 & $FFFF) + ((RNG*41 & $FFFF0000) >> 16))
    2090/    2AA0 :                     ; RNG = ((RNG*41 + ((RNG*41 & $FFFF) << 16)) & $FFFF0000) | (RNG*41 & $FFFF)
    2091/    2AA0 :                     ; ---------------------------------------------------------------------------
    2092/    2AA0 :                     
    2093/    2AA0 :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
    2094/    2AA0 :                     
    2095/    2AA0 :                     ; PseudoRandomNumber:
    2096/    2AA0 :                     RandomNumber:
    2097/    2AA0 : 2238 F636           		move.l	(v_random).w,d1
    2098/    2AA4 : 6606                		bne.s	loc_2C9C
    2099/    2AA6 : 223C 2A6D 365A      		move.l	#$2A6D365A,d1
    2100/    2AAC :                     
    2101/    2AAC :                     loc_2C9C:
    2102/    2AAC :                     		; set the high word of d0 to be the high word of the RNG
    2103/    2AAC :                     		; and multiply the RNG by 41
    2104/    2AAC : 2001                		move.l	d1,d0
    2105/    2AAE : E581                		asl.l	#2,d1
    2106/    2AB0 : D280                		add.l	d0,d1
    2107/    2AB2 : E781                		asl.l	#3,d1
    2108/    2AB4 : D280                		add.l	d0,d1
    2109/    2AB6 :                     
    2110/    2AB6 :                     		; add the low word of the RNG to the high word of the RNG
    2111/    2AB6 :                     		; and set the low word of d0 to be the result
    2112/    2AB6 : 3001                		move.w	d1,d0
    2113/    2AB8 : 4841                		swap	d1
    2114/    2ABA : D041                		add.w	d1,d0
    2115/    2ABC : 3200                		move.w	d0,d1
    2116/    2ABE : 4841                		swap	d1
    2117/    2AC0 :                     
    2118/    2AC0 : 21C1 F636           		move.l	d1,(v_random).w
    2119/    2AC4 : 4E75                		rts
    2120/    2AC6 :                     ; End of function RandomNumber
