    9593/    F240 :                     ; Solid object subroutines (includes spikes, blocks, rocks etc)
    9594/    F240 :                     ; These check collision of Sonic/Tails with objects on the screen
    9595/    F240 :                     ;
    9596/    F240 :                     ; input variables:
    9597/    F240 :                     ; d1 = object width
    9598/    F240 :                     ; d2 = object height / 2 (when jumping)
    9599/    F240 :                     ; d3 = object height / 2 (when walking)
    9600/    F240 :                     ; d4 = object x-axis position
    9601/    F240 :                     ;
    9602/    F240 :                     ; address registers:
    9603/    F240 :                     ; a0 = the object to check collision with
    9604/    F240 :                     ; a1 = sonic or tails (set inside these subroutines)
    9605/    F240 :                     ; ---------------------------------------------------------------------------
