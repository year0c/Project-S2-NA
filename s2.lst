    8412/    D83C :                     ; Objects Manager
    8413/    D83C :                     ; Subroutine that keeps track of any objects that need to remember
    8414/    D83C :                     ; their state, such as monitors or enemies.
    8415/    D83C :                     ;
    8416/    D83C :                     ; input variables:
    8417/    D83C :                     ;  -none-
    8418/    D83C :                     ;
    8419/    D83C :                     ; writes:
    8420/    D83C :                     ;  d0, d1
    8421/    D83C :                     ;  d2 = respawn index of object to load
    8422/    D83C :                     ;  d6 = camera position
    8423/    D83C :                     ;
    8424/    D83C :                     ;  a0 = address in object placement list
    8425/    D83C :                     ;  a2 = respawn table
    8426/    D83C :                     ; ---------------------------------------------------------------------------
