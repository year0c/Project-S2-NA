(2)  771/   74160 :                     	endm
(2)  772/   74160 :                     
(2)  773/   74160 :                     smpsAlterPitch macro
(2)  774/   74160 :                     	smpsChangeTransposition	ALLARGS
(2)  775/   74160 :                     	endm
(2)  776/   74160 :                     
(2)  777/   74160 :                     smpsFMFlutter macro
(2)  778/   74160 :                     	smpsFMVolEnv	ALLARGS
(2)  779/   74160 :                     	endm
(2)  780/   74160 :                     
(2)  781/   74160 :                     smpsWeirdD1LRR macro
(2)  782/   74160 :                     	smpsMaxRelRate ALLARGS
(2)  783/   74160 :                     	endm
(2)  784/   74160 :                     
