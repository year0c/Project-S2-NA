   15886/   19A94 : 3C1A                		move.w	(a2)+,d6			; Get number of scripts in list
   15887/   19A96 :                     
   15888/   19A96 :                     .loc_1AACA:
   15889/   19A96 : 5313                		subq.b	#1,(a3)				; Tick down frame duration
   15890/   19A98 : 6A42                		bpl.s	.loc_1AB10			; If frame isn't over, move on to next script
   15891/   19A9A :                     
   15892/   19A9A : 7000                		moveq	#0,d0
   15893/   19A9C : 102B 0001           		move.b	1(a3),d0			; Get current frame
   15894/   19AA0 : B02A 0006           		cmp.b	6(a2),d0			; Have we processed the last frame in the script?
   15895/   19AA4 : 6506                		blo.s	.loc_1AAE0
   15896/   19AA6 : 7000                		moveq	#0,d0				; If so, reset to first frame
   15897/   19AA8 : 1740 0001           		move.b	d0,1(a3)
   15898/   19AAC :                     
   15899/   19AAC :                     .loc_1AAE0:
   15900/   19AAC : 522B 0001           		addq.b	#1,1(a3)			; Consider this frame processed; set counter to next frame
   15901/   19AB0 : 1692                		move.b	(a2),(a3)			; Set frame duration to global duration value
   15902/   19AB2 : 6A06                		bpl.s	.loc_1AAEE
   15903/   19AB4 :                     		; If script uses per-frame durations, use those instead
   15904/   19AB4 : D040                		add.w	d0,d0
   15905/   19AB6 : 16B2 0009           		move.b	9(a2,d0.w),(a3)			; Set frame duration to current frame's duration value
   15906/   19ABA :                     
   15907/   19ABA :                     .loc_1AAEE:
   15908/   19ABA :                     		; Prepare for DMA transfer
   15909/   19ABA :                     		; Get relative address of frame's art
   15910/   19ABA : 1032 0008           		move.b	8(a2,d0.w),d0			; Get tile ID
   15911/   19ABE : EB48                		lsl.w	#5,d0				; Turn it into an offset
   15912/   19AC0 :                     		; Get VRAM destination address
   15913/   19AC0 : 342A 0004           		move.w	4(a2),d2
   15914/   19AC4 :                     		; Get ROM source address
   15915/   19AC4 : 2212                		move.l	(a2),d1				; Get start address of animated tile art
   15916/   19AC6 : 0281 00FF FFFF      		andi.l	#$FFFFFF,d1
   15917/   19ACC : D280                		add.l	d0,d1				; Offset into art, to get the address of new frame
   15918/   19ACE :                     		; Get size of art to be transferred
   15919/   19ACE : 7600                		moveq	#0,d3
   15920/   19AD0 : 162A 0007           		move.b	7(a2),d3
   15921/   19AD4 : E94B                		lsl.w	#4,d3				; Turn it into actual size (in words)
   15922/   19AD6 :                     		; Use d1, d2 and d3 to queue art for transfer
   15923/   19AD6 : 4EB9 0000 13A0      		jsr	($13A0).l	;	QueueDMATransfer
   15924/   19ADC :                     
   15925/   19ADC :                     .loc_1AB10:
   15926/   19ADC : 102A 0006           		move.b	6(a2),d0			; Get total size of frame data
   15927/   19AE0 : 4A12                		tst.b	(a2)				; Is per-frame duration data present?
   15928/   19AE2 : 6A02                		bpl.s	.loc_1AB1A			; If not, keep the current size; it's correct
   15929/   19AE4 : D000                		add.b	d0,d0				; Double size to account for the additional frame duration data
   15930/   19AE6 :                     
   15931/   19AE6 :                     .loc_1AB1A:
   15932/   19AE6 : 5200                		addq.b	#1,d0
   15933/   19AE8 : 0240 00FE           		andi.w	#$FE,d0				; Round to next even address, if it isn't already
   15934/   19AEC : 45F2 0008           		lea	8(a2,d0.w),a2			; Advance to next script in list
   15935/   19AF0 : 544B                		addq.w	#2,a3				; Advance to next script's slot in a3 (usually Anim_Counters)
   15936/   19AF2 : 51CE FFA2           		dbf	d6,.loc_1AACA
   15937/   19AF6 : 4E75                		rts
