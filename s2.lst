    9606/    F184 :                     SolidObject_cont:
    9607/    F184 :                     		; We now perform the x portion of a bounding box check.  To do this, we assume a
    9608/    F184 :                     		; coordinate system where the x origin is at the object's left edge.
    9609/    F184 : 3029 0008           		move.w	obX(a1),d0			; load Sonic's x position...
    9610/    F188 : 9068 0008           		sub.w	obX(a0),d0			; ... and calculate his x position relative to the object
    9611/    F18C : D041                		add.w	d1,d0				; assume object's left edge is at (0,0).  This is also Sonic's distance to the object's left edge.
    9612/    F18E : 6B00 00C4           		bmi.w	SolidObject_TestClearPush	; branch, if Sonic is outside the object's left edge
    9613/    F192 : 3601                		move.w	d1,d3
    9614/    F194 : D643                		add.w	d3,d3				; calculate object's width
    9615/    F196 : B043                		cmp.w	d3,d0
    9616/    F198 : 6200 00BA           		bhi.w	SolidObject_TestClearPush	; branch, if Sonic is outside the object's right edge
    9617/    F19C :                     		; We now perform the y portion of a bounding box check.  To do this, we assume a
    9618/    F19C :                     		; coordinate system where the y origin is at the highest y position relative to the object
    9619/    F19C :                     		; at which Sonic would still collide with it.  This point is
    9620/    F19C :                     		;   y_pos(object) - width(object)/2 - y_radius(Sonic) - 4,
    9621/    F19C :                     		; where object is stored in (a0), Sonic in (a1), and height(object)/2 in d2.  This way
    9622/    F19C :                     		; of doing it causes the object's hitbox to be vertically off-center by -4 pixels.
    9623/    F19C : 1629 0016           		move.b	obHeight(a1),d3			; load Sonic's y radius
    9624/    F1A0 : 4883                		ext.w	d3
    9625/    F1A2 : D443                		add.w	d3,d2				; calculate maximum distance for a top collision
    9626/    F1A4 : 3629 000C           		move.w	obY(a1),d3			; load Sonic's y position
    9627/    F1A8 : 9668 000C           		sub.w	obY(a0),d3			; ... and calculate his y position relative to the object
    9628/    F1AC : 5843                		addq.w	#4,d3				; assume a slightly lower position for Sonic
    9629/    F1AE : D642                		add.w	d2,d3				; assume the highest position where Sonic would still be colliding with the object to be (0,0)
    9630/    F1B0 : 6B00 00A2           		bmi.w	SolidObject_TestClearPush	; branch, if Sonic is above this point
    9631/    F1B4 : 3802                		move.w	d2,d4
    9632/    F1B6 : D844                		add.w	d4,d4				; calculate minimum distance for a bottom collision
    9633/    F1B8 : B644                		cmp.w	d4,d3
    9634/    F1BA : 6400 0098           		bhs.w	SolidObject_TestClearPush	; branch, if Sonic is below this point
