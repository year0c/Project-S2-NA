   13287/   1BB68 :                     
   13288/   1BB68 : (MACRO)              		jmpTos0	JmpTo10_Adjust2PArtPointer
   13288/   1BB68 :  (MACRO-2)                   jmpTosInternal FALSE,JmpTo10_Adjust2PArtPointer
   13288/   1BB68 :                     
   13288/   1BB68 :                                     shift
   13288/   1BB68 :                     
   13288/   1BB68 :   (MACRO-3)                          jmpTosInternal2 JmpTo10_Adjust2PArtPointer
   13288/   1BB68 : =$1BB68              JmpTo10_Adjust2PArtPointer label *
   13288/   1BB68 : 4EF9 0000 D252              jmp     (extractJmpToName("JmpTo10_Adjust2PArtPointer")).l
   13288/   1BB6E :                     
   13288/   1BB6E :   (MACRO-3)                          align 4
   13288/   1BB6E :    (MACRO-4)                 cnop 0,4
   13288/   1BB6E :     (MACRO-5)                        org (*-1+(4)-((*-1+(-(0)))#(4)))
   13288/   1BB70 :                                             !org (*-1+(4)-((*-1+(-(0)))#(4)))
   13289/   1BB70 :                     ; ===========================================================================
   13290/   1BB70 :                     
   13291/   1BB70 :                     		include	"_inc/LevelHeaders.asm"
(1)    1/   1BB70 :                     ; ---------------------------------------------------------------------------
(1)    2/   1BB70 :                     ; "MAIN LEVEL LOAD BLOCK" (after Nemesis)
(1)    3/   1BB70 :                     ;
(1)    4/   1BB70 :                     ; This struct array tells the engine where to find all the art associated with
(1)    5/   1BB70 :                     ; a particular zone. Each zone gets four longwords, in which it stores four
(1)    6/   1BB70 :                     ; pointers (in the lower 24 bits) and three jump table indeces (in the upper eight
(1)    7/   1BB70 :                     ; bits). The assembled data looks something like this:
(1)    8/   1BB70 :                     ;
(1)    9/   1BB70 :                     ; aaBBBBBB
(1)   10/   1BB70 :                     ; ccDDDDDD
(1)   11/   1BB70 :                     ; EEEEEE
(1)   12/   1BB70 :                     ; ffgghhii
(1)   13/   1BB70 :                     ;
(1)   14/   1BB70 :                     ; aa = index for primary pattern load request list
(1)   15/   1BB70 :                     ; BBBBBB = unused, pointer to level art
(1)   16/   1BB70 :                     ; cc = index for secondary pattern load request list
(1)   17/   1BB70 :                     ; DDDDDD = pointer to 16x16 block mappings
(1)   18/   1BB70 :                     ; EEEEEE = pointer to 128x128 block mappings
(1)   19/   1BB70 :                     ; ff = unused, always 0
(1)   20/   1BB70 :                     ; gg = unused, music track
(1)   21/   1BB70 :                     ; hh = unused, palette
(1)   22/   1BB70 :                     ; ii = palette
(1)   23/   1BB70 :                     ;
(1)   24/   1BB70 :                     ; Nemesis refers to this as the "main level load block". However, that name implies
(1)   25/   1BB70 :                     ; that this is code (obviously, it isn't), or at least that it points to the level's
(1)   26/   1BB70 :                     ; collision, object and ring placement arrays (it only points to palettes and 16x16
(1)   27/   1BB70 :                     ; mappings although the 128x128 mappings do affect the actual level layout and collision)
(1)   28/   1BB70 :                     ; ---------------------------------------------------------------------------
(1)   29/   1BB70 :                     
(1)   30/   1BB70 :                     ; macro for declaring a "main level load block" (MLLB)
(1)   31/   1BB70 :                     levartptrs macro plc1,plc2,art,map16x16,map128x128,music,palette
(1)   32/   1BB70 :                     	dc.l (plc1<<24)|art
(1)   33/   1BB70 :                     	dc.l (plc2<<24)|map16x16
(1)   34/   1BB70 :                     	dc.l map128x128
(1)   35/   1BB70 :                     	dc.b 0,music,palette,palette
(1)   36/   1BB70 :                     	endm
(1)   37/   1BB70 :                     
(1)   38/   1BB70 :                     ; MainLoadBlocks:
(1)   39/   1BB70 :                     LevelArtPointers:
(1)   40/   1BB70 : (MACRO)              		levartptrs plcid_GHZ, plcid_GHZ2, Nem_GHZ, Map16_GHZ, Map128_GHZ, bgm_GHZ, palid_GHZ ; GHZ  ; GREEN HILL ZONE
(1)   40/   1BB70 : 040D 8C34                   dc.l (plcid_GHZ<<24)|Nem_GHZ
(1)   40/   1BB74 : 050D 7E34                   dc.l (plcid_GHZ2<<24)|Map16_GHZ
(1)   40/   1BB78 : 000D D850                   dc.l Map128_GHZ
(1)   40/   1BB7C : 0081 0404                   dc.b 0,bgm_GHZ,palid_GHZ,palid_GHZ
(1)   41/   1BB80 : (MACRO)              		levartptrs plcid_LZ, plcid_LZ2, Nem_CPZ, Map16_CPZ, Map128_CPZ, bgm_LZ, palid_LZ ; LZ   ; LABYRINTH ZONE
(1)   41/   1BB80 : 060C C8F4                   dc.l (plcid_LZ<<24)|Nem_CPZ
(1)   41/   1BB84 : 070C B314                   dc.l (plcid_LZ2<<24)|Map16_CPZ
