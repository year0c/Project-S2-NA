     851/    10F6 :                     ; ---------------------------------------------------------------------------
     852/    10F6 :                     ; VDP register settings to use for the game. Do note that a handful of these
     853/    10F6 :                     ; are getting rewritten for every game mode change, though the majority
     854/    10F6 :                     ; will stay at their initial settings defined in this array.
     855/    10F6 :                     ; ---------------------------------------------------------------------------
     856/    10F6 :                     ; See here for details on VDP registers:
     857/    10F6 :                     ; https://segaretro.org/Sega_Mega_Drive/VDP_registers
     858/    10F6 :                     ; ---------------------------------------------------------------------------
     859/    10F6 :                     
     860/    10F6 :                     VDPSetupArray:
     861/    10F6 : 8004                		dc.w $8000|%00000100			; 8-color mode
     862/    10F8 : 8134                		dc.w $8100|%00110100			; vertical interrupts, DMA, Mega Drive display
     863/    10FA : 8230                		dc.w $8200|(vram_fg>>10)		; foreground nametable address
     864/    10FC : 8328                		dc.w $8300|($A000>>10)			; window nametable address
     865/    10FE : 8407                		dc.w $8400|(vram_bg>>13)		; background nametable address
     866/    1100 : 857C                		dc.w $8500|(vram_sprites>>9)		; sprite table address
     867/    1102 : 8600                		dc.w $8600				; (unused, only relevant for 128KB VRAM mode)
     868/    1104 : 8700                		dc.w $8700|$00				; background colour (palette line 0, entry 0)
     869/    1106 : 8800                		dc.w $8800				; (unused, only relevant for Master System)
     870/    1108 : 8900                		dc.w $8900				; (unused, only relevant for Master System)
     871/    110A : 8A00                		dc.w $8A00|$00				; horizontal interrupt register
     872/    110C : 8B00                		dc.w $8B00|%00000000			; full-screen vertical scrolling
     873/    110E : 8C81                		dc.w $8C00|%10000001			; 40-cell display mode
     874/    1110 : 8D3F                		dc.w $8D00|(vram_hscroll>>10)		; background H-scroll address
     875/    1112 : 8E00                		dc.w $8E00				; (unused, only relevant for 128KB VRAM mode)
     876/    1114 : 8F02                		dc.w $8F00|$02				; VDP auto-increment size (2)
     877/    1116 : 9001                		dc.w $9000|%00000001			; 64-cell H-scroll size
     878/    1118 : 9100                		dc.w $9100				; window horizontal position
     879/    111A : 9200                		dc.w $9200				; window vertical position
