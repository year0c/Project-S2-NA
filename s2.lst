     950/    126C :                     ; Subroutine to transfer a plane map to VRAM
     951/    126C :                     ; ---------------------------------------------------------------------------
     952/    126C :                     
     953/    126C :                     ; control register:
     954/    126C :                     ;    CD1 CD0 A13 A12 A11 A10 A09 A08     (D31-D24)
     955/    126C :                     ;    A07 A06 A05 A04 A03 A02 A01 A00     (D23-D16)
     956/    126C :                     ;     ?   ?   ?   ?   ?   ?   ?   ?      (D15-D8)
     957/    126C :                     ;    CD5 CD4 CD3 CD2  ?   ?  A15 A14     (D7-D0)
     958/    126C :                     ;
     959/    126C :                     ;	A00-A15 - address
     960/    126C :                     ;	CD0-CD3 - code
     961/    126C :                     ;	CD4 - 1 if VRAM copy DMA mode. 0 otherwise.
     962/    126C :                     ;	CD5 - DMA operation
     963/    126C :                     ;
     964/    126C :                     ;	Bits CD3-CD0:
     965/    126C :                     ;	0000 - VRAM read
     966/    126C :                     ;	0001 - VRAM write
     967/    126C :                     ;	0011 - CRAM write
     968/    126C :                     ;	0100 - VSRAM read
     969/    126C :                     ;	0101 - VSRAM write
     970/    126C :                     ;	1000 - CRAM read
     971/    126C :                     ;
     972/    126C :                     ; d0 = control register
     973/    126C :                     ; d1 = width
     974/    126C :                     ; d2 = heigth
     975/    126C :                     ; a1 = source address
     976/    126C :                     
     977/    126C :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
     978/    126C :                     
     979/    126C :                     ; ShowVDPGraphics: PlaneMapToVRAM:
     980/    126C :                     PlaneMapToVRAM_H40:
     981/    126C : 4DF9 00C0 0000      		lea	(vdp_data_port).l,a6
     982/    1272 : 283C 0080 0000      		move.l	#$800000,d4
     983/    1278 :                     
     984/    1278 :                     PlaneMapToVRAM_H40_LineLoop:
     985/    1278 : 2D40 0004           		move.l	d0,4(a6)
     986/    127C : 3601                		move.w	d1,d3
     987/    127E :                     
     988/    127E :                     PlaneMapToVRAM_H40_TileLoop:
     989/    127E : 3C99                		move.w	(a1)+,(a6)
     990/    1280 : 51CB FFFC           		dbf	d3,PlaneMapToVRAM_H40_TileLoop
     991/    1284 : D084                		add.l	d4,d0
     992/    1286 : 51CA FFF0           		dbf	d2,PlaneMapToVRAM_H40_LineLoop
     993/    128A : 4E75                		rts
