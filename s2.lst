(1)  215/    128C :                     		disableInts												; Mask off interrupts
(1)  216/    128C :                     	endif ; UseVIntSafeDMA==1
(1)  217/    128C :                     	movea.w	(VDP_Command_Buffer_Slot).w,a1
(1)  218/    128C :                     	cmpa.w	#VDP_Command_Buffer_Slot,a1
(1)  219/    128C :                     	beq.s	.done												; Return if there's no more room in the buffer
(1)  220/    128C :                     	move.b	#(dmaLength(length)>>8)&$FF,DMAEntry.SizeH(a1)		; Write top byte of size/2
(1)  221/    128C :                     	move.l	#((dmaLength(length)&$FF)<<24)|dmaSource(src),d0	; Set d0 to bottom byte of size/2 and the low 3 bytes of source/2
