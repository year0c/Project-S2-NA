    6810/    CBEE : 3028 0010           		move.w	obVelX(a0),d0			; load x speed
    6811/    CBF2 : 48C0                		ext.l	d0
    6812/    CBF4 : E180                		asl.l	#8,d0				; shift velocity to line up with the middle 16 bits of the 32-bit position
    6813/    CBF6 : D480                		add.l	d0,d2				; add x speed to x position
    6814/    CBF8 : 3028 0012           		move.w	obVelY(a0),d0			; load y speed
    6815/    CBFC : 48C0                		ext.l	d0
    6816/    CBFE : E180                		asl.l	#8,d0				; shift velocity to line up with the middle 16 bits of the 32-bit position
    6817/    CC00 : D680                		add.l	d0,d3				; add old y speed to y position
