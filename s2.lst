(1)  201/    1290 :                     			fatal "DMA queued from odd source $\{src}!"
(1)  202/    1290 :                     		endif
(1)  203/    1290 :                     		if ((length)&1)<>0
(1)  204/    1290 :                     			fatal "DMA an odd number of bytes $\{length}!"
(1)  205/    1290 :                     		endif
(1)  206/    1290 :                     		if (length)==0
(1)  207/    1290 :                     			fatal "DMA transferring 0 bytes (becomes a 128kB transfer). If you really mean it, pass 128kB instead."
(1)  208/    1290 :                     		endif
(1)  209/    1290 :                     		if (((src)+(length)-1)>>17)<>((src)>>17)
(1)  210/    1290 :                     			fatal "DMA crosses a 128kB boundary. You should either split the DMA manually or align the source adequately."
(1)  211/    1290 :                     		endif
(1)  212/    1290 :                     	endif
(1)  213/    1290 :                     	if UseVIntSafeDMA==1
(1)  214/    1290 :                     		move.w	sr,-(sp)										; Save current interrupt mask
(1)  215/    1290 :                     		disableInts												; Mask off interrupts
(1)  216/    1290 :                     	endif ; UseVIntSafeDMA==1
(1)  217/    1290 :                     	movea.w	(VDP_Command_Buffer_Slot).w,a1
(1)  218/    1290 :                     	cmpa.w	#VDP_Command_Buffer_Slot,a1
(1)  219/    1290 :                     	beq.s	.done												; Return if there's no more room in the buffer
(1)  220/    1290 :                     	move.b	#(dmaLength(length)>>8)&$FF,DMAEntry.SizeH(a1)		; Write top byte of size/2
(1)  221/    1290 :                     	move.l	#((dmaLength(length)&$FF)<<24)|dmaSource(src),d0	; Set d0 to bottom byte of size/2 and the low 3 bytes of source/2
(1)  222/    1290 :                     	movep.l	d0,DMAEntry.SizeL(a1)								; Write it all to the queue
(1)  223/    1290 :                     	lea	DMAEntry.Command(a1),a1									; Seek to correct RAM address to store VDP DMA command
