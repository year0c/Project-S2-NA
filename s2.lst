(1)  195/    1290 :                     ; Expects source address and DMA length in bytes. Also, expects source, size, and dest to be known
(1)  196/    1290 :                     ; at assembly time. Gives errors if DMA starts at an odd address, transfers
(1)  197/    1290 :                     ; crosses a 128kB boundary, or has size 0.
(1)  198/    1290 :                     QueueStaticDMA macro src,length,dest
(1)  199/    1290 :                     	if MOMPASS>1
