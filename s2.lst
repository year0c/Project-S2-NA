   15741/   19AE0 : 4A12                		tst.b	(a2)				; Is per-frame duration data present?
   15742/   19AE2 : 6A02                		bpl.s	.loc_1AB1A			; If not, keep the current size; it's correct
   15743/   19AE4 : D000                		add.b	d0,d0				; Double size to account for the additional frame duration data
   15744/   19AE6 :                     
