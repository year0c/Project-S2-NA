   12543/   1A608 :                     ; ZONE ANIMATION PROCEDURES AND SCRIPTS
   12544/   1A608 :                     ;
   12545/   1A608 :                     ; Each zone gets two entries in this jump table. The first entry points to the
   12546/   1A608 :                     ; zone's animation procedure (usually Dynamic_Null, AKA none). The second points
   12547/   1A608 :                     ; to the zone's animation script.
   12548/   1A608 :                     ;
   12549/   1A608 :                     ; Seems like stage IDs were already being shifted, since listings for $07-$0F
   12550/   1A608 :                     ; can be found, alongside HPZ's art listed from $08 (its ID in the final).
   12551/   1A608 :                     ; ---------------------------------------------------------------------------
   12552/   1A608 :                     DynArtCue_Index:
   12553/   1A608 : 0042                		dc.w Dynamic_NullGHZ-DynArtCue_Index	; GHZ
   12554/   1A60A : 00AC                		dc.w AnimCue_EHZ-DynArtCue_Index		; GHZ
   12555/   1A60C : 0040                		dc.w Dynamic_Null-DynArtCue_Index		; LZ
   12556/   1A60E : 0136                		dc.w AnimCue_CPZ_Boss-DynArtCue_Index	; LZ
   12557/   1A610 : 0040                		dc.w Dynamic_Null-DynArtCue_Index		; CPZ
   12558/   1A612 : 0136                		dc.w AnimCue_CPZ_Boss-DynArtCue_Index	; CPZ
   12559/   1A614 : 0044                		dc.w Dynamic_Normal-DynArtCue_Index		; EHZ
   12560/   1A616 : 00AC                		dc.w AnimCue_EHZ-DynArtCue_Index		; EHZ
   12561/   1A618 : 0044                		dc.w Dynamic_Normal-DynArtCue_Index		; HPZ
   12562/   1A61A : 010A                		dc.w AnimCue_HPZ-DynArtCue_Index		; HPZ
   12563/   1A61C : 0044                		dc.w Dynamic_Normal-DynArtCue_Index		; HTZ
   12564/   1A61E : 00AC                		dc.w AnimCue_EHZ-DynArtCue_Index		; HTZ
   12565/   1A620 : 0040                		dc.w Dynamic_Null-DynArtCue_Index		; 06
   12566/   1A622 : 0136                		dc.w AnimCue_CPZ_Boss-DynArtCue_Index	; 06
   12567/   1A624 : 0040                		dc.w Dynamic_Null-DynArtCue_Index		; 07
   12568/   1A626 : 0136                		dc.w AnimCue_CPZ_Boss-DynArtCue_Index	; 07
