   15917/   19BF0 : 6702                		beq.s	.loc_1AC28			; if yes, branch
   15918/   19BF2 :                     
   15919/   19BF2 :                     .locret_1AC26:
   15920/   19BF2 : 4E75                		rts
   15921/   19BF4 :                     ; ===========================================================================
   15922/   19BF4 :                     ; this shifts all blocks of the chunks $EA-$ED and $FA-$FD one block to the
   15923/   19BF4 :                     ; left and the last block in each row (chunk $ED/$FD) to the beginning
   15924/   19BF4 :                     ; i.e. rotates the blocks to the left by one
