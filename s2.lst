    6595/    C96E : 1010                		move.b	obID(a0),d0			; get the object's ID
    6596/    C970 : 670A                		beq.s	loc_CB74			; if it's obj00, skip it
    6597/    C972 : 4A28 0001           		tst.b	obRender(a0)		; should we render it?
    6598/    C976 : 6A04                		bpl.s	loc_CB74			; if not, skip it
    6599/    C978 : 6100 0292           		bsr.w	DisplaySprite
