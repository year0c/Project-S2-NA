     262/     2CA :                     Z80StartupCodeBegin:
     263/     2CA :                     	; Z80 instructions (not the sound driver; that gets loaded later)
     265/     2CA :                     	save
     266/     2CA :                     	CPU Z80 ; start assembling Z80 code
     267/       0 :                     	phase 0 ; pretend we're at address 0
     268/       0 : AF                  	xor	a	; clear a to 0
     269/       1 : 01 D9 1F            	ld	bc,((z80_ram_end-z80_ram)-zStartupCodeEndLoc)-1 ; prepare to loop this many times
     270/       4 : 11 27 00            	ld	de,zStartupCodeEndLoc+1	; initial destination address
     271/       7 : 21 26 00            	ld	hl,zStartupCodeEndLoc	; initial source address
     272/       A : F9                  	ld	sp,hl	; set the address the stack starts at
     273/       B : 77                  	ld	(hl),a	; set first byte of the stack to 0
     274/       C : ED B0               	ldir		; loop to fill the stack (entire remaining available Z80 RAM) with 0
     275/       E : DD E1               	pop	ix	; clear ix
     276/      10 : FD E1               	pop	iy	; clear iy
     277/      12 : ED 47               	ld	i,a	; clear i
     278/      14 : ED 4F               	ld	r,a	; clear r
     279/      16 : D1                  	pop	de	; clear de
     280/      17 : E1                  	pop	hl	; clear hl
     281/      18 : F1                  	pop	af	; clear af
     282/      19 : 08                  	ex	af,af'	; swap af with af'
     283/      1A : D9                  	exx		; swap bc/de/hl with their shadow registers too
     284/      1B : C1                  	pop	bc	; clear bc
     285/      1C : D1                  	pop	de	; clear de
     286/      1D : E1                  	pop	hl	; clear hl
     287/      1E : F1                  	pop	af	; clear af
     288/      1F : F9                  	ld	sp,hl	; clear sp
     289/      20 : F3                  	di		; clear iff1 (for interrupt handler)
     290/      21 : ED 56               	im	1	; interrupt handling mode = 1
     291/      23 : 36 E9               	ld	(hl),0E9h ; replace the first instruction with a jump to itself
     292/      25 : E9                  	jp	(hl)	  ; jump to the first instruction (to stay there forever)
     293/      26 :                     zStartupCodeEndLoc:
     294/     2F0 :                     	dephase ; stop pretending
     295/     2F0 : ALL                  	restore
     296/     2F0 :                     	padding off ; unfortunately our flags got reset so we have to set them again...
