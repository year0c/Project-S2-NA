(1)    1/   1BB74 :                     ; ---------------------------------------------------------------------------
(1)    2/   1BB74 :                     ; "MAIN LEVEL LOAD BLOCK" (after Nemesis)
(1)    3/   1BB74 :                     ;
(1)    4/   1BB74 :                     ; This struct array tells the engine where to find all the art associated with
(1)    5/   1BB74 :                     ; a particular zone. Each zone gets four longwords, in which it stores four
(1)    6/   1BB74 :                     ; pointers (in the lower 24 bits) and three jump table indeces (in the upper eight
(1)    7/   1BB74 :                     ; bits). The assembled data looks something like this:
(1)    8/   1BB74 :                     ;
(1)    9/   1BB74 :                     ; aaBBBBBB
(1)   10/   1BB74 :                     ; ccDDDDDD
(1)   11/   1BB74 :                     ; EEEEEE
(1)   12/   1BB74 :                     ; ffgghhii
(1)   13/   1BB74 :                     ;
(1)   14/   1BB74 :                     ; aa = index for primary pattern load request list
(1)   15/   1BB74 :                     ; BBBBBB = unused, pointer to level art
(1)   16/   1BB74 :                     ; cc = index for secondary pattern load request list
(1)   17/   1BB74 :                     ; DDDDDD = pointer to 16x16 block mappings
(1)   18/   1BB74 :                     ; EEEEEE = pointer to 128x128 block mappings
(1)   19/   1BB74 :                     ; ff = unused, always 0
(1)   20/   1BB74 :                     ; gg = unused, music track
(1)   21/   1BB74 :                     ; hh = unused, palette
(1)   22/   1BB74 :                     ; ii = palette
(1)   23/   1BB74 :                     ;
(1)   24/   1BB74 :                     ; Nemesis refers to this as the "main level load block". However, that name implies
(1)   25/   1BB74 :                     ; that this is code (obviously, it isn't), or at least that it points to the level's
(1)   26/   1BB74 :                     ; collision, object and ring placement arrays (it only points to palettes and 16x16
(1)   27/   1BB74 :                     ; mappings although the 128x128 mappings do affect the actual level layout and collision)
(1)   28/   1BB74 :                     ; ---------------------------------------------------------------------------
(1)   29/   1BB74 :                     
(1)   30/   1BB74 :                     ; macro for declaring a "main level load block" (MLLB)
(1)   31/   1BB74 :                     levartptrs macro plc1,plc2,art,map16x16,map128x128,music,palette
(1)   32/   1BB74 :                     	dc.l (plc1<<24)|art
(1)   33/   1BB74 :                     	dc.l (plc2<<24)|map16x16
(1)   34/   1BB74 :                     	dc.l map128x128
(1)   35/   1BB74 :                     	dc.b 0,music,palette,palette
(1)   36/   1BB74 :                     	endm
(1)   37/   1BB74 :                     
(1)   38/   1BB74 :                     ; MainLoadBlocks:
(1)   39/   1BB74 :                     LevelArtPointers:
(1)   40/   1BB74 : (MACRO)              		levartptrs plcid_GHZ, plcid_GHZ2, Nem_GHZ, Map16_GHZ, Map128_GHZ, bgm_GHZ, palid_GHZ ; GHZ  ; GREEN HILL ZONE
(1)   40/   1BB74 : 040D 8C34                   dc.l (plcid_GHZ<<24)|Nem_GHZ
(1)   40/   1BB78 : 050D 7E34                   dc.l (plcid_GHZ2<<24)|Map16_GHZ
(1)   40/   1BB7C : 000D D850                   dc.l Map128_GHZ
(1)   40/   1BB80 : 0081 0404                   dc.b 0,bgm_GHZ,palid_GHZ,palid_GHZ
(1)   41/   1BB84 : (MACRO)              		levartptrs plcid_LZ, plcid_LZ2, Nem_CPZ, Map16_CPZ, Map128_CPZ, bgm_LZ, palid_LZ ; LZ   ; LABYRINTH ZONE
(1)   41/   1BB84 : 060C C8F4                   dc.l (plcid_LZ<<24)|Nem_CPZ
(1)   41/   1BB88 : 070C B314                   dc.l (plcid_LZ2<<24)|Map16_CPZ
(1)   41/   1BB8C : 000C FE34                   dc.l Map128_CPZ
(1)   41/   1BB90 : 0082 0505                   dc.b 0,bgm_LZ,palid_LZ,palid_LZ
(1)   42/   1BB94 : (MACRO)              		levartptrs plcid_CPZ, plcid_CPZ2, Nem_CPZ, Map16_CPZ, Map128_CPZ, bgm_MZ, palid_CPZ ; CPZ  ; CHEMICAL PLANT ZONE
(1)   42/   1BB94 : 080C C8F4                   dc.l (plcid_CPZ<<24)|Nem_CPZ
(1)   42/   1BB98 : 090C B314                   dc.l (plcid_CPZ2<<24)|Map16_CPZ
(1)   42/   1BB9C : 000C FE34                   dc.l Map128_CPZ
(1)   42/   1BBA0 : 0083 0606                   dc.b 0,bgm_MZ,palid_CPZ,palid_CPZ
(1)   43/   1BBA4 : (MACRO)              		levartptrs plcid_EHZ, plcid_EHZ2, Nem_EHZ, Map16_EHZ, Map128_EHZ, bgm_SLZ, palid_EHZ ; EHZ  ; EMERALD HILL ZONE
(1)   43/   1BBA4 : 0A0B 2184                   dc.l (plcid_EHZ<<24)|Nem_EHZ
(1)   43/   1BBA8 : 0B0B 11E4                   dc.l (plcid_EHZ2<<24)|Map16_EHZ
(1)   43/   1BBAC : 000B 6EB2                   dc.l Map128_EHZ
(1)   43/   1BBB0 : 0084 0707                   dc.b 0,bgm_SLZ,palid_EHZ,palid_EHZ
(1)   44/   1BBB4 : (MACRO)              		levartptrs plcid_HPZ, plcid_HPZ2, Nem_HPZ, Map16_HPZ, Map128_HPZ, bgm_SYZ, palid_HPZ ; HPZ  ; HIDDEN PALACE ZONE
(1)   44/   1BBB4 : 0C0C 0492                   dc.l (plcid_HPZ<<24)|Nem_HPZ
(1)   44/   1BBB8 : 0D0B EEB2                   dc.l (plcid_HPZ2<<24)|Map16_HPZ
(1)   44/   1BBBC : 000C 3314                   dc.l Map128_HPZ
(1)   44/   1BBC0 : 0085 0808                   dc.b 0,bgm_SYZ,palid_HPZ,palid_HPZ
(1)   45/   1BBC4 : (MACRO)              		levartptrs plcid_HTZ, plcid_HTZ2, Nem_EHZ, Map16_EHZ, Map128_EHZ, bgm_SBZ, palid_HTZ1 ; HTZ  ; HILL TOP ZONE
(1)   45/   1BBC4 : 0E0B 2184                   dc.l (plcid_HTZ<<24)|Nem_EHZ
(1)   45/   1BBC8 : 0F0B 11E4                   dc.l (plcid_HTZ2<<24)|Map16_EHZ
(1)   45/   1BBCC : 000B 6EB2                   dc.l Map128_EHZ
(1)   45/   1BBD0 : 0086 0909                   dc.b 0,bgm_SBZ,palid_HTZ1,palid_HTZ1
(1)   46/   1BBD4 : (MACRO)              		levartptrs 0, 0, Nem_GHZ, Map16_GHZ, Map128_GHZ, bgm_SBZ, palid_Ending ; LEV6 ; LEVEL 6 (UNUSED, SONIC 1 ENDING)
(1)   46/   1BBD4 : 000D 8C34                   dc.l (0<<24)|Nem_GHZ
(1)   46/   1BBD8 : 000D 7E34                   dc.l (0<<24)|Map16_GHZ
(1)   46/   1BBDC : 000D D850                   dc.l Map128_GHZ
(1)   46/   1BBE0 : 0086 1313                   dc.b 0,bgm_SBZ,palid_Ending,palid_Ending
   13301/   1BBE4 :                     		include	"_inc/Pattern Load Cues.asm"
(1)    1/   1BBE4 :                     ; ---------------------------------------------------------------------------
(1)    2/   1BBE4 :                     ; PATTERN LOAD REQUEST LISTS
(1)    3/   1BBE4 :                     ;
(1)    4/   1BBE4 :                     ; Pattern load request lists are simple structures used to load
(1)    5/   1BBE4 :                     ; Nemesis-compressed art for sprites.
(1)    6/   1BBE4 :                     ;
(1)    7/   1BBE4 :                     ; The decompressor predictably moves down the list, so request 0 is processed first, etc.
(1)    8/   1BBE4 :                     ; This only matters if your addresses are bad and you overwrite art loaded in a previous request.
(1)    9/   1BBE4 :                     ;
(1)   10/   1BBE4 :                     
(1)   11/   1BBE4 :                     ; NOTICE: The load queue buffer can only hold $10 (16) load requests. None of the routines
(1)   12/   1BBE4 :                     ; that load PLRs into the queue do any bounds checking, so it's possible to create a buffer
(1)   13/   1BBE4 :                     ; overflow and completely screw up the variables stored directly after the queue buffer.
(1)   14/   1BBE4 :                     ; (in my experience this is a guaranteed crash or hang)
(1)   15/   1BBE4 :                     ;
(1)   16/   1BBE4 :                     ; Many levels queue more than 16 items overall, but they don't exceed the limit because
(1)   17/   1BBE4 :                     ; their PLRs are split into multiple parts (like PLC_GHZ and PLC_GHZ2) and they fully
(1)   18/   1BBE4 :                     ; process the first part before requesting the rest.
(1)   19/   1BBE4 :                     ; ---------------------------------------------------------------------------
(1)   20/   1BBE4 :                     
(1)   21/   1BBE4 :                     ;---------------------------------------------------------------------------------------
(1)   22/   1BBE4 :                     ; Table of pattern load request lists. Remember to use word-length data when adding lists
(1)   23/   1BBE4 :                     ; otherwise you'll break the array.
(1)   24/   1BBE4 :                     ;---------------------------------------------------------------------------------------
(1)   25/   1BBE4 :                     ArtLoadCues:
(1)   26/   1BBE4 :                     
