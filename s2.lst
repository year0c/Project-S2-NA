(1)  194/    14AC :                     is68kRegister function expr,symtype(expr)==8
(1)  195/    14AC :                     ; Expects source address and DMA length in bytes. Also, expects source, size, and dest to be known
(1)  196/    14AC :                     ; at assembly time. Gives errors if DMA starts at an odd address, transfers
(1)  197/    14AC :                     ; crosses a 128kB boundary, or has size 0.
(1)  198/    14AC :                     QueueStaticDMA macro src,length,dest
(1)  199/    14AC :                     	if MOMPASS>1
(1)  200/    14AC :                     		if ((src)&1)<>0
(1)  201/    14AC :                     			fatal "DMA queued from odd source $\{src}!"
(1)  202/    14AC :                     		endif
(1)  203/    14AC :                     		if ((length)&1)<>0
(1)  204/    14AC :                     			fatal "DMA an odd number of bytes $\{length}!"
(1)  205/    14AC :                     		endif
(1)  206/    14AC :                     		if (length)==0
(1)  207/    14AC :                     			fatal "DMA transferring 0 bytes (becomes a 128kB transfer). If you really mean it, pass 128kB instead."
(1)  208/    14AC :                     		endif
(1)  209/    14AC :                     		if (((src)+(length)-1)>>17)<>((src)>>17)
(1)  210/    14AC :                     			fatal "DMA crosses a 128kB boundary. You should either split the DMA manually or align the source adequately."
(1)  211/    14AC :                     		endif
(1)  212/    14AC :                     	endif
(1)  213/    14AC :                     	if UseVIntSafeDMA==1
(1)  214/    14AC :                     		move.w	sr,-(sp)										; Save current interrupt mask
(1)  215/    14AC :                     		disableInts												; Mask off interrupts
(1)  216/    14AC :                     	endif ; UseVIntSafeDMA==1
(1)  217/    14AC :                     	movea.w	(VDP_Command_Buffer_Slot).w,a1
(1)  218/    14AC :                     	cmpa.w	#VDP_Command_Buffer_Slot,a1
(1)  219/    14AC :                     	beq.s	.done												; Return if there's no more room in the buffer
(1)  220/    14AC :                     	move.b	#(dmaLength(length)>>8)&$FF,DMAEntry.SizeH(a1)		; Write top byte of size/2
(1)  221/    14AC :                     	move.l	#((dmaLength(length)&$FF)<<24)|dmaSource(src),d0	; Set d0 to bottom byte of size/2 and the low 3 bytes of source/2
(1)  222/    14AC :                     	movep.l	d0,DMAEntry.SizeL(a1)								; Write it all to the queue
(1)  223/    14AC :                     	lea	DMAEntry.Command(a1),a1									; Seek to correct RAM address to store VDP DMA command
(1)  224/    14AC :                     	if is68kRegister(dest)
(1)  225/    14AC :                     		move.l	dest,(a1)+
(1)  226/    14AC :                     	else
(1)  227/    14AC :                     		move.l	#vdpComm(dest,VRAM,DMA),(a1)+					; Write VDP DMA command for destination address
(1)  228/    14AC :                     	endif
(1)  229/    14AC :                     	move.w	a1,(VDP_Command_Buffer_Slot).w						; Write next queue slot
(1)  230/    14AC :                     .done:
(1)  231/    14AC :                     	if UseVIntSafeDMA==1
(1)  232/    14AC :                     		move.w	(sp)+,sr										; Restore interrupts to previous state
(1)  233/    14AC :                     	endif ;UseVIntSafeDMA==1
(1)  234/    14AC :                     	endm
