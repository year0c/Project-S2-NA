(2)   48/   74160 :                     ; SMPS2ASM uses nMaxPSG for songs from S1/S2 drivers.
(2)   49/   74160 :                     ; nMaxPSG1 and nMaxPSG2 are used only for songs from S3/S&K/S3D drivers.
(2)   50/   74160 :                     ; The use of psgdelta is intended to undo the effects of PSGPitchConvert
(2)   51/   74160 :                     ; and ensure that the ending note is indeed the maximum PSG frequency.
(2)   53/   74160 : =$C6                 nMaxPSG				EQU nA5
(2)   54/   74160 : =$D2                 nMaxPSG1			EQU nA5+psgdelta
(2)   55/   74160 : =$D2                 nMaxPSG2			EQU nA5+psgdelta
(2)   61/   74160 :                     ; ---------------------------------------------------------------------------
(2)   62/   74160 :                     ; PSG volume envelope equates
(2)   65/   74160 : =$1..$6              			enum		fTone_01=$01,fTone_02,fTone_03,fTone_04,fTone_05,fTone_06
(2)   66/   74160 : =$7..$9              			nextenum	fTone_07,fTone_08,fTone_09
(2)   86/   74160 :                     ; ---------------------------------------------------------------------------
(2)   87/   74160 :                     ; DAC Equates
(2)   90/   74160 : =$81..$83            			enum		dKick=$81,dSnare,dTimpani
(2)   91/   74160 : =$88..$8B            			enum		dHiTimpani=$88,dMidTimpani,dLowTimpani,dVLowTimpani
(2)  169/   74160 :                     ; ---------------------------------------------------------------------------
(2)  170/   74160 :                     ; Channel IDs for SFX
(2)  171/   74160 : =$80                 cPSG1				EQU $80
(2)  172/   74160 : =$A0                 cPSG2				EQU $A0
(2)  173/   74160 : =$C0                 cPSG3				EQU $C0
(2)  174/   74160 : =$E0                 cNoise				EQU $E0	; Not for use in S3/S&K/S3D
(2)  175/   74160 : =$2                  cFM3				EQU $02
(2)  176/   74160 : =$4                  cFM4				EQU $04
(2)  177/   74160 : =$5                  cFM5				EQU $05
(2)  178/   74160 : =$6                  cFM6				EQU $06	; Only in S3/S&K/S3D, overrides DAC
(2)  179/   74160 :                     ; ---------------------------------------------------------------------------
(2)  180/   74160 :                     ; Conversion macros and functions
(2)  181/   74160 :                     
(2)  182/   74160 :                     conv0To256  function n,((n==0)<<8)|n
(2)  183/   74160 :                     s2TempotoS1 function n,(((768-n)>>1)/(256-n))&$FF
(2)  184/   74160 :                     s2TempotoS3 function n,($100-((n==0)|n))&$FF
(2)  185/   74160 :                     s1TempotoS2 function n,((((conv0To256(n)-1)<<8)+(conv0To256(n)>>1))/conv0To256(n))&$FF
(2)  186/   74160 :                     s1TempotoS3 function n,s2TempotoS3(s1TempotoS2(n))
(2)  187/   74160 :                     s3TempotoS1 function n,s2TempotoS1(s2TempotoS3(n))
(2)  188/   74160 :                     s3TempotoS2 function n,s2TempotoS3(n)
(2)  189/   74160 :                     
(2)  190/   74160 :                     convertMainTempoMod macro mod
(2)  191/   74160 :                     	if ((SourceDriver>=3)&&(SonicDriverVer>=3))||(SonicDriverVer==SourceDriver)
(2)  192/   74160 :                     		dc.b	mod
(2)  193/   74160 :                     	elseif SourceDriver==1
(2)  194/   74160 :                     		if mod==1
(2)  195/   74160 :                     			fatal "Invalid main tempo of 1 in song from Sonic 1"
(2)  196/   74160 :                     		endif
(2)  197/   74160 :                     		if SonicDriverVer==2
(2)  198/   74160 :                     			dc.b	s1TempotoS2(mod)
(2)  199/   74160 :                     		else;if SonicDriverVer>=3
(2)  200/   74160 :                     			dc.b	s1TempotoS3(mod)
(2)  201/   74160 :                     		endif
(2)  202/   74160 :                     	elseif SourceDriver==2
(2)  203/   74160 :                     		if mod==0
(2)  204/   74160 :                     			fatal "Invalid main tempo of 0 in song from Sonic 2"
(2)  205/   74160 :                     		endif
(2)  206/   74160 :                     		if SonicDriverVer==1
(2)  207/   74160 :                     			dc.b	s2TempotoS1(mod)
(2)  208/   74160 :                     		else;if SonicDriverVer>=3
(2)  209/   74160 :                     			dc.b	s2TempotoS3(mod)
(2)  210/   74160 :                     		endif
(2)  211/   74160 :                     	else;if SourceDriver>=3
(2)  212/   74160 :                     		if mod==0
(2)  213/   74160 :                     			message "Performing approximate conversion of Sonic 3 main tempo modifier of 0"
(2)  214/   74160 :                     		endif
(2)  215/   74160 :                     		if SonicDriverVer==1
(2)  216/   74160 :                     			dc.b	s3TempotoS1(mod)
(2)  217/   74160 :                     		else;if SonicDriverVer==2
(2)  218/   74160 :                     			dc.b	s3TempotoS2(mod)
(2)  219/   74160 :                     		endif
(2)  220/   74160 :                     	endif
(2)  221/   74160 :                     	endm
(2)  222/   74160 :                     
(2)  223/   74160 :                     ; PSG conversion to S3/S&K/S3D drivers require a tone shift of 12 semi-tones.
(2)  224/   74160 :                     PSGPitchConvert macro pitch
(2)  225/   74160 :                     	if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  226/   74160 :                     		dc.b	(pitch+psgdelta)&$FF
(2)  227/   74160 :                     	elseif (SonicDriverVer<3)&&(SourceDriver>=3)
(2)  228/   74160 :                     		dc.b	(pitch-psgdelta)&$FF
(2)  229/   74160 :                     	else
(2)  230/   74160 :                     		dc.b	pitch
(2)  231/   74160 :                     	endif
(2)  232/   74160 :                     	endm
(2)  233/   74160 :                     
(2)  234/   74160 :                     CheckedChannelPointer macro loc
(2)  235/   74160 :                     	if SonicDriverVer<>1
(2)  236/   74160 :                     		dc.w	z80_ptr(loc)
(2)  237/   74160 :                     	else
(2)  238/   74160 :                     		if (MOMPASS=1)&&(DEFINED(loc))
(2)  239/   74160 :                     			fatal "Tracks for Sonic 1 songs must come after the start of the song"
(2)  240/   74160 :                     		endif
(2)  241/   74160 :                     		dc.w	loc-songStart
(2)  242/   74160 :                     	endif
(2)  243/   74160 :                     	endm
(2)  244/   74160 :                     ; ---------------------------------------------------------------------------
(2)  245/   74160 :                     ; Header Macros
(2)  246/   74160 :                     smpsHeaderStartSong macro ver, sourcesmps2asmver
(2)  247/   74160 :                     
(2)  248/   74160 :                     SourceDriver set ver
(2)  249/   74160 :                     
(2)  250/   74160 :                     	if ("sourcesmps2asmver"<>"")
(2)  251/   74160 :                     		set SourceSMPS2ASM,sourcesmps2asmver
(2)  252/   74160 :                     	else
(2)  253/   74160 :                     		set SourceSMPS2ASM,0
(2)  254/   74160 :                     	endif
(2)  255/   74160 :                     
(2)  256/   74160 :                     songStart set *
(2)  257/   74160 :                     
(2)  258/   74160 :                     	if MOMPASS=1
(2)  259/   74160 :                     		if SMPS2ASMVer < SourceSMPS2ASM
(2)  260/   74160 :                     			message "Song at 0x\{songStart} was made for a newer version of SMPS2ASM (this is version \{SMPS2ASMVer}, but song wants at least version \{SourceSMPS2ASM})."
(2)  261/   74160 :                     		endif
(2)  262/   74160 :                     	endif
(2)  263/   74160 :                     
(2)  264/   74160 :                     	endm
(2)  265/   74160 :                     
(2)  266/   74160 :                     smpsHeaderVoiceNull macro
(2)  267/   74160 :                     	if songStart<>*
(2)  268/   74160 :                     		fatal "Missing smpsHeaderStartSong"
(2)  269/   74160 :                     	endif
(2)  270/   74160 :                     	dc.w	$0000
(2)  271/   74160 :                     	endm
(2)  272/   74160 :                     
(2)  273/   74160 :                     ; Header - Set up Voice Location
(2)  274/   74160 :                     ; Common to music and SFX
(2)  275/   74160 :                     smpsHeaderVoice macro loc
(2)  276/   74160 :                     	if songStart<>*
(2)  277/   74160 :                     		fatal "Missing smpsHeaderStartSong"
(2)  278/   74160 :                     	endif
(2)  279/   74160 :                     	if SonicDriverVer<>1
(2)  280/   74160 :                     		dc.w	z80_ptr(loc)
(2)  281/   74160 :                     	else
(2)  282/   74160 :                     		if (MOMPASS=1)&&(DEFINED(loc))
(2)  283/   74160 :                     			fatal "Voice banks for Sonic 1 songs must come after the start of the song"
(2)  284/   74160 :                     		endif
(2)  285/   74160 :                     		dc.w	loc-songStart
(2)  286/   74160 :                     	endif
(2)  287/   74160 :                     	endm
(2)  288/   74160 :                     
(2)  289/   74160 :                     ; Header - Set up Voice Location as S3's Universal Voice Bank
(2)  290/   74160 :                     ; Common to music and SFX
(2)  291/   74160 :                     smpsHeaderVoiceUVB macro
(2)  292/   74160 :                     	if songStart<>*
(2)  293/   74160 :                     		fatal "Missing smpsHeaderStartSong"
(2)  294/   74160 :                     	endif
(2)  295/   74160 :                     	if SonicDriverVer>=5
(2)  296/   74160 :                     		dc.w	z80_ptr(z80_UniVoiceBank)
(2)  297/   74160 :                     	elseif SonicDriverVer>=3
(2)  298/   74160 :                     		dc.w	little_endian(z80_UniVoiceBank)
(2)  299/   74160 :                     	else
(2)  300/   74160 :                     		fatal "Universal Voice Bank does not exist in Sonic 1 or Sonic 2 drivers"
(2)  301/   74160 :                     	endif
(2)  302/   74160 :                     	endm
(2)  303/   74160 :                     
(2)  304/   74160 :                     ; Header macros for music (not for SFX)
(2)  305/   74160 :                     ; Header - Set up Channel Usage
(2)  306/   74160 :                     smpsHeaderChan macro fm,psg
(2)  307/   74160 :                     	dc.b	fm,psg
(2)  308/   74160 :                     	endm
(2)  309/   74160 :                     
(2)  310/   74160 :                     ; Header - Set up Tempo
(2)  311/   74160 :                     smpsHeaderTempo macro div,mod
(2)  312/   74160 :                     	dc.b	div
(2)  313/   74160 :                     	convertMainTempoMod mod
(2)  314/   74160 :                     	endm
(2)  315/   74160 :                     
(2)  316/   74160 :                     ; Header - Set up DAC Channel
(2)  317/   74160 :                     smpsHeaderDAC macro loc,pitch,vol
(2)  318/   74160 :                     	CheckedChannelPointer loc
(2)  319/   74160 :                     	if ("pitch"<>"")
(2)  320/   74160 :                     		dc.b	pitch
(2)  321/   74160 :                     		if ("vol"<>"")
(2)  322/   74160 :                     			dc.b	vol
(2)  323/   74160 :                     		else
(2)  324/   74160 :                     			dc.b	$00
(2)  325/   74160 :                     		endif
(2)  326/   74160 :                     	else
(2)  327/   74160 :                     		dc.w	$00
(2)  328/   74160 :                     	endif
(2)  329/   74160 :                     	endm
(2)  330/   74160 :                     
(2)  331/   74160 :                     ; Header - Set up FM Channel
(2)  332/   74160 :                     smpsHeaderFM macro loc,pitch,vol
(2)  333/   74160 :                     	CheckedChannelPointer loc
(2)  334/   74160 :                     	dc.b	pitch,vol
(2)  335/   74160 :                     	endm
(2)  336/   74160 :                     
(2)  337/   74160 :                     ; Header - Set up PSG Channel
(2)  338/   74160 :                     smpsHeaderPSG macro loc,pitch,vol,mod,voice
(2)  339/   74160 :                     	CheckedChannelPointer loc
(2)  340/   74160 :                     	PSGPitchConvert pitch
(2)  341/   74160 :                     	dc.b	vol
(2)  342/   74160 :                     	; Frequency envelope
(2)  343/   74160 :                     	if (SonicDriverVer>=3) && (SourceDriver<3)
(2)  344/   74160 :                     		; In SMPS 68k Type 1, this byte is skipped and can contain garbage.
(2)  345/   74160 :                     		; Sonic 2's Oil Ocean Zone and Ending themes set this byte to a non-zero value which
(2)  346/   74160 :                     		; other drivers may try to process as valid data, so manually force it to 0 here.
(2)  347/   74160 :                     		dc.b	0
(2)  348/   74160 :                     	else
(2)  349/   74160 :                     		if (MOMPASS==1) && (SonicDriverVer<3) && (SourceDriver>=3) && (mod<>0)
(2)  350/   74160 :                     			message "This track header specifies a frequency envelope, but this driver does not support them."
(2)  351/   74160 :                     		endif
(2)  352/   74160 :                     		dc.b	mod
(2)  353/   74160 :                     	endif
(2)  354/   74160 :                     	; Volume envelope
(2)  355/   74160 :                     	dc.b	voice
(2)  356/   74160 :                     	endm
(2)  357/   74160 :                     
(2)  358/   74160 :                     ; Header macros for SFX (not for music)
(2)  359/   74160 :                     ; Header - Set up Tempo
(2)  360/   74160 :                     smpsHeaderTempoSFX macro div
(2)  361/   74160 :                     	dc.b	div
(2)  362/   74160 :                     	endm
(2)  363/   74160 :                     
(2)  364/   74160 :                     ; Header - Set up Channel Usage
(2)  365/   74160 :                     smpsHeaderChanSFX macro chan
(2)  366/   74160 :                     	dc.b	chan
(2)  367/   74160 :                     	endm
(2)  368/   74160 :                     
(2)  369/   74160 :                     ; Header - Set up FM Channel
(2)  370/   74160 :                     smpsHeaderSFXChannel macro chanid,loc,pitch,vol
(2)  371/   74160 :                     	if (SonicDriverVer>=3)&&(chanid==cNoise)
(2)  372/   74160 :                     		fatal "Using channel ID of cNoise ($E0) in Sonic 3 driver is dangerous. Fix the song so that it turns into a noise channel instead."
(2)  373/   74160 :                     	elseif (SonicDriverVer<3)&&(chanid==cFM6)
(2)  374/   74160 :                     		fatal "Using channel ID of FM6 ($06) in Sonic 1 or Sonic 2 drivers is unsupported. Change it to another channel."
(2)  375/   74160 :                     	endif
(2)  376/   74160 :                     	dc.b	$80,chanid
(2)  377/   74160 :                     	CheckedChannelPointer loc
(2)  378/   74160 :                     	if (chanid&$80)<>0
(2)  379/   74160 :                     		PSGPitchConvert pitch
(2)  380/   74160 :                     	else
(2)  381/   74160 :                     		dc.b	pitch
(2)  382/   74160 :                     	endif
(2)  383/   74160 :                     	dc.b	vol
(2)  384/   74160 :                     	endm
(2)  385/   74160 :                     ; ---------------------------------------------------------------------------
(2)  386/   74160 :                     ; Co-ord Flag Macros and Equates
(2)  387/   74160 :                     ; E0xx - Panning, AMS, FMS
(2)  388/   74160 :                     smpsPan macro direction,amsfms
(2)  389/   74160 :                     panNone set $00
(2)  390/   74160 :                     panRight set $40
(2)  391/   74160 :                     panLeft set $80
(2)  392/   74160 :                     panCentre set $C0
(2)  393/   74160 :                     panCenter set $C0 ; silly Americans :U
(2)  394/   74160 :                     	dc.b $E0,direction+amsfms
(2)  395/   74160 :                     	endm
(2)  396/   74160 :                     
(2)  397/   74160 :                     ; E1xx - Set channel detune to val
(2)  398/   74160 :                     smpsDetune macro val
(2)  399/   74160 :                     	dc.b	$E1,val
(2)  400/   74160 :                     	endm
(2)  401/   74160 :                     
(2)  402/   74160 :                     ; E2xx - Used for setting a variable which can be read by the game, for synchonisation. Ristar does this.
(2)  403/   74160 :                     smpsNop macro val
(2)  404/   74160 :                     	if (SonicDriverVer>=3) && ((val==$FF) || (val==$29))
(2)  405/   74160 :                     		warning "Values $FF and $29 are reserved in S3K's driver; use a different value or remove this command."
(2)  406/   74160 :                     	endif
(2)  407/   74160 :                     	dc.b	$E2,val
(2)  408/   74160 :                     	endm
(2)  409/   74160 :                     
(2)  410/   74160 :                     ; Return (used after smpsCall)
(2)  411/   74160 :                     smpsReturn macro val
(2)  412/   74160 :                     	if SonicDriverVer>=3
(2)  413/   74160 :                     		dc.b	$F9
(2)  414/   74160 :                     	else
(2)  415/   74160 :                     		dc.b	$E3
(2)  416/   74160 :                     	endif
(2)  417/   74160 :                     	endm
(2)  418/   74160 :                     
(2)  419/   74160 :                     ; Fade in previous song (ie. 1-Up)
(2)  420/   74160 :                     smpsFade macro val
(2)  421/   74160 :                     	if SonicDriverVer>=3
(2)  422/   74160 :                     		dc.b	$E2
(2)  423/   74160 :                     		if ("val"<>"")
(2)  424/   74160 :                     			dc.b	val
(2)  425/   74160 :                     		else
(2)  426/   74160 :                     			dc.b	$FF
(2)  427/   74160 :                     		endif
(2)  428/   74160 :                     		if SourceDriver<3
(2)  429/   74160 :                     			smpsStop
(2)  430/   74160 :                     		endif
(2)  431/   74160 :                     	elseif (SourceDriver>=3) && ("val"<>"") && ("val"<>"$FF")
(2)  432/   74160 :                     		; This is actually a communication byte, not a fade.
(2)  433/   74160 :                     		smpsNop	val
(2)  434/   74160 :                     	else
(2)  435/   74160 :                     		dc.b	$E4
(2)  436/   74160 :                     	endif
(2)  437/   74160 :                     	endm
(2)  438/   74160 :                     
(2)  439/   74160 :                     ; E5xx - Set channel tempo divider to xx
(2)  440/   74160 :                     smpsChanTempoDiv macro val
(2)  441/   74160 :                     	if SonicDriverVer>=5
(2)  442/   74160 :                     		; New flag unique to Flamewing's modified S&K driver
(2)  443/   74160 :                     		dc.b	$FF,$08,val
(2)  444/   74160 :                     	elseif SonicDriverVer==3
(2)  445/   74160 :                     		fatal "Coord. Flag to set tempo divider of a single channel does not exist in S3 driver. Use Flamewing's modified S&K sound driver instead."
(2)  446/   74160 :                     	else
(2)  447/   74160 :                     		dc.b	$E5,val
(2)  448/   74160 :                     	endif
(2)  449/   74160 :                     	endm
(2)  450/   74160 :                     
(2)  451/   74160 :                     ; E6xx - Alter Volume by xx
(2)  452/   74160 :                     smpsAlterVol macro val
(2)  453/   74160 :                     	dc.b	$E6,val
(2)  454/   74160 :                     	endm
(2)  455/   74160 :                     
(2)  456/   74160 :                     ; E7 - Prevent attack of next note
(2)  457/   74160 : =$E7                 smpsNoAttack	EQU $E7
(2)  458/   74160 :                     
(2)  459/   74160 :                     ; E8xx - Set note fill to xx
(2)  460/   74160 :                     smpsNoteFill macro val
(2)  461/   74160 :                     	if (SonicDriverVer>=5)&&(SourceDriver<3)
(2)  462/   74160 :                     		; Unique to Flamewing's modified driver
(2)  463/   74160 :                     		dc.b	$FF,$0A,val
(2)  464/   74160 :                     	else
(2)  465/   74160 :                     		if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  466/   74160 :                     			message "Note fill will not work as intended unless you divide the fill value by the tempo divider or complain to Flamewing to add an appropriate coordination flag for it."
(2)  467/   74160 :                     		elseif (SonicDriverVer<3)&&(SourceDriver>=3)
(2)  468/   74160 :                     			message "Note fill will not work as intended unless you multiply the fill value by the tempo divider or complain to Flamewing to add an appropriate coordination flag for it."
(2)  469/   74160 :                     		endif
(2)  470/   74160 :                     		dc.b	$E8,val
(2)  471/   74160 :                     	endif
(2)  472/   74160 :                     	endm
(2)  473/   74160 :                     
(2)  474/   74160 :                     ; Add xx to channel pitch
(2)  475/   74160 :                     smpsChangeTransposition macro val
(2)  476/   74160 :                     	if SonicDriverVer>=3
(2)  477/   74160 :                     		dc.b	$FB,val
(2)  478/   74160 :                     	else
(2)  479/   74160 :                     		dc.b	$E9,val
(2)  480/   74160 :                     	endif
(2)  481/   74160 :                     	endm
(2)  482/   74160 :                     
(2)  483/   74160 :                     ; Set music tempo modifier to xx
(2)  484/   74160 :                     smpsSetTempoMod macro mod
(2)  485/   74160 :                     	if SonicDriverVer>=3
(2)  486/   74160 :                     		dc.b	$FF,$00
(2)  487/   74160 :                     	else
(2)  488/   74160 :                     		dc.b	$EA
(2)  489/   74160 :                     	endif
(2)  490/   74160 :                     	convertMainTempoMod mod
(2)  491/   74160 :                     	endm
(2)  492/   74160 :                     
(2)  493/   74160 :                     ; Set music tempo divider to xx
(2)  494/   74160 :                     smpsSetTempoDiv macro val
(2)  495/   74160 :                     	if SonicDriverVer>=3
(2)  496/   74160 :                     		dc.b	$FF,$04,val
(2)  497/   74160 :                     	else
(2)  498/   74160 :                     		dc.b	$EB,val
(2)  499/   74160 :                     	endif
(2)  500/   74160 :                     	endm
(2)  501/   74160 :                     
(2)  502/   74160 :                     ; ECxx - Set Volume to xx
(2)  503/   74160 :                     smpsSetVol macro val
(2)  504/   74160 :                     	if SonicDriverVer>=3
(2)  505/   74160 :                     		dc.b	$E4,val
(2)  506/   74160 :                     	else
(2)  507/   74160 :                     		fatal "Coord. Flag to set volume (instead of volume attenuation) does not exist in S1 or S2 drivers. Complain to Flamewing to add it."
(2)  508/   74160 :                     	endif
(2)  509/   74160 :                     	endm
(2)  510/   74160 :                     
