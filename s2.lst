(2)  518/   74164 :                     	if SonicDriverVer==2
(2)  519/   74164 :                     		smpsAlterVol vol
(2)  520/   74164 :                     	else
(2)  521/   74164 :                     		smpsPSGAlterVol vol
(2)  522/   74164 :                     	endif
(2)  523/   74164 :                     	endm
(2)  524/   74164 :                     
(2)  525/   74164 :                     ; Clears pushing sound flag in S1
(2)  526/   74164 :                     smpsClearPush macro
(2)  527/   74164 :                     	if SonicDriverVer==1
(2)  528/   74164 :                     		dc.b	$ED
(2)  529/   74164 :                     	else
(2)  530/   74164 :                     		fatal "Coord. Flag to clear S1 push block flag does not exist in S2 or S3 drivers. Complain to Flamewing to add it."
(2)  531/   74164 :                     	endif
(2)  532/   74164 :                     	endm
(2)  533/   74164 :                     
(2)  534/   74164 :                     ; Stops special SFX (S1 only) and restarts overridden music track
(2)  535/   74164 :                     smpsStopSpecial macro
