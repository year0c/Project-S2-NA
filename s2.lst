   12804/   1A7A8 : 6702                		beq.s	loc_1AC28			; if yes, branch
   12805/   1A7AA :                     
   12806/   1A7AA :                     locret_1AC26:
   12807/   1A7AA : 4E75                		rts
   12808/   1A7AC :                     ; ===========================================================================
   12809/   1A7AC :                     ; this shifts all blocks of the chunks $EA-$ED and $FA-$FD one block to the
   12810/   1A7AC :                     ; left and the last block in each row (chunk $ED/$FD) to the beginning
   12811/   1A7AC :                     ; i.e. rotates the blocks to the left by one
