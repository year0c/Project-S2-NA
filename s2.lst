    1958/    28B0 : 0640 0080           		addi.w	#$80,d0
    1959/    28B4 : 323B 000C           		move.w	Sine_Data(pc,d0.w),d1		; cos
    1960/    28B8 : 0440 0080           		subi.w	#$80,d0
    1961/    28BC : 303B 0004           		move.w	Sine_Data(pc,d0.w),d0		; sin
    1962/    28C0 : 4E75                		rts
