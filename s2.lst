    1902/    2880 :                     ; Subroutine to generate a pseudo-random number in d0
    1903/    2880 :                     ; d0 = (RNG & $FFFF0000) | ((RNG*41 & $FFFF) + ((RNG*41 & $FFFF0000) >> 16))
    1904/    2880 :                     ; RNG = ((RNG*41 + ((RNG*41 & $FFFF) << 16)) & $FFFF0000) | (RNG*41 & $FFFF)
    1905/    2880 :                     ; ---------------------------------------------------------------------------
    1906/    2880 :                     
    1907/    2880 :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
    1908/    2880 :                     
    1909/    2880 :                     ; PseudoRandomNumber:
    1910/    2880 :                     RandomNumber:
    1911/    2880 : 2238 F636           		move.l	(v_random).w,d1
    1912/    2884 : 6606                		bne.s	loc_2C9C
    1913/    2886 : 223C 2A6D 365A      		move.l	#$2A6D365A,d1
    1914/    288C :                     
    1915/    288C :                     loc_2C9C:
    1916/    288C :                     		; set the high word of d0 to be the high word of the RNG
    1917/    288C :                     		; and multiply the RNG by 41
    1918/    288C : 2001                		move.l	d1,d0
    1919/    288E : E581                		asl.l	#2,d1
    1920/    2890 : D280                		add.l	d0,d1
    1921/    2892 : E781                		asl.l	#3,d1
    1922/    2894 : D280                		add.l	d0,d1
    1923/    2896 :                     
    1924/    2896 :                     		; add the low word of the RNG to the high word of the RNG
    1925/    2896 :                     		; and set the low word of d0 to be the result
    1926/    2896 : 3001                		move.w	d1,d0
    1927/    2898 : 4841                		swap	d1
    1928/    289A : D041                		add.w	d1,d0
    1929/    289C : 3200                		move.w	d0,d1
    1930/    289E : 4841                		swap	d1
    1931/    28A0 :                     
    1932/    28A0 : 21C1 F636           		move.l	d1,(v_random).w
    1933/    28A4 : 4E75                		rts
    1934/    28A6 :                     ; End of function RandomNumber
