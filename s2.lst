   16104/   19BF2 :                     
   16105/   19BF2 :                     .locret_1AC26:
   16106/   19BF2 : 4E75                		rts
   16107/   19BF4 :                     ; ===========================================================================
   16108/   19BF4 :                     ; this shifts all blocks of the chunks $EA-$ED and $FA-$FD one block to the
   16109/   19BF4 :                     ; left and the last block in each row (chunk $ED/$FD) to the beginning
   16110/   19BF4 :                     ; i.e. rotates the blocks to the left by one
   16111/   19BF4 :                     
