(2)  506/   74164 :                     	else
(2)  507/   74164 :                     		fatal "Coord. Flag to set volume (instead of volume attenuation) does not exist in S1 or S2 drivers. Complain to Flamewing to add it."
(2)  508/   74164 :                     	endif
(2)  509/   74164 :                     	endm
(2)  510/   74164 :                     
