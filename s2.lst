(1)  228/    128C :                     	endif
(1)  229/    128C :                     	move.w	a1,(VDP_Command_Buffer_Slot).w						; Write next queue slot
(1)  230/    128C :                     .done:
(1)  231/    128C :                     	if UseVIntSafeDMA==1
(1)  232/    128C :                     		move.w	(sp)+,sr										; Restore interrupts to previous state
(1)  233/    128C :                     	endif ;UseVIntSafeDMA==1
(1)  234/    128C :                     	endm
