     273/     2C8 :                     
     274/     2C8 :                     Z80StartupCodeBegin:
     275/     2C8 :                     		; Z80 instructions (not the sound driver; that gets loaded later)
     276/     2C8 :                     		save
     277/     2C8 :                     		CPU Z80 ; start assembling Z80 code
     278/       0 :                     		phase 0 ; pretend we're at address 0
     279/       0 : AF                  		xor	a	; clear a to 0
     280/       1 : 01 D9 1F            		ld	bc,((z80_ram_end-z80_ram)-zStartupCodeEndLoc)-1 ; prepare to loop this many times
     281/       4 : 11 27 00            		ld	de,zStartupCodeEndLoc+1	; initial destination address
     282/       7 : 21 26 00            		ld	hl,zStartupCodeEndLoc	; initial source address
     283/       A : F9                  		ld	sp,hl	; set the address the stack starts at
     284/       B : 77                  		ld	(hl),a	; set first byte of the stack to 0
     285/       C : ED B0               		ldir		; loop to fill the stack (entire remaining available Z80 RAM) with 0
     286/       E : DD E1               		pop	ix	; clear ix
     287/      10 : FD E1               		pop	iy	; clear iy
     288/      12 : ED 47               		ld	i,a	; clear i
     289/      14 : ED 4F               		ld	r,a	; clear r
     290/      16 : D1                  		pop	de	; clear de
     291/      17 : E1                  		pop	hl	; clear hl
     292/      18 : F1                  		pop	af	; clear af
     293/      19 : 08                  		ex	af,af'	; swap af with af'
     294/      1A : D9                  		exx		; swap bc/de/hl with their shadow registers too
     295/      1B : C1                  		pop	bc	; clear bc
     296/      1C : D1                  		pop	de	; clear de
     297/      1D : E1                  		pop	hl	; clear hl
     298/      1E : F1                  		pop	af	; clear af
     299/      1F : F9                  		ld	sp,hl	; clear sp
     300/      20 : F3                  		di		; clear iff1 (for interrupt handler)
     301/      21 : ED 56               		im	1	; interrupt handling mode = 1
     302/      23 : 36 E9               		ld	(hl),0E9h ; replace the first instruction with a jump to itself
     303/      25 : E9                  		jp	(hl)	  ; jump to the first instruction (to stay there forever)
     304/      26 :                     zStartupCodeEndLoc:
     305/     2EE :                     		dephase ; stop pretending
     306/     2EE : ALL                  		restore
     307/     2EE :                     		padding off ; unfortunately our flags got reset so we have to set them again...
