   12736/   1A830 : 0044                		dc.w Dynamic_Normal-DynArtCue_Index		; EHZ
   12737/   1A832 : 00AC                		dc.w AnimCue_EHZ-DynArtCue_Index		; EHZ
   12738/   1A834 : 0044                		dc.w Dynamic_Normal-DynArtCue_Index		; HPZ
   12739/   1A836 : 010A                		dc.w AnimCue_HPZ-DynArtCue_Index		; HPZ
   12740/   1A838 : 0044                		dc.w Dynamic_Normal-DynArtCue_Index		; HTZ
   12741/   1A83A : 00AC                		dc.w AnimCue_EHZ-DynArtCue_Index		; HTZ
   12742/   1A83C : 0040                		dc.w Dynamic_Null-DynArtCue_Index		; 06
   12743/   1A83E : 0136                		dc.w AnimCue_CPZ_Boss-DynArtCue_Index	; 06
   12744/   1A840 : 0040                		dc.w Dynamic_Null-DynArtCue_Index		; 07
