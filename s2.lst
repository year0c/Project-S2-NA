(2)  512/   74160 :                     smpsPSGAlterVol macro vol
(2)  513/   74160 :                     	dc.b	$EC,vol
(2)  514/   74160 :                     	endm
(2)  515/   74160 :                     
(2)  516/   74160 :                     smpsPSGAlterVolS2 macro vol
(2)  517/   74160 :                     	; Sonic 2's driver allows the FM command to be used on PSG channels, but others do not.
(2)  518/   74160 :                     	if SonicDriverVer==2
(2)  519/   74160 :                     		smpsAlterVol vol
(2)  520/   74160 :                     	else
(2)  521/   74160 :                     		smpsPSGAlterVol vol
(2)  522/   74160 :                     	endif
(2)  523/   74160 :                     	endm
(2)  524/   74160 :                     
(2)  525/   74160 :                     ; Clears pushing sound flag in S1
(2)  526/   74160 :                     smpsClearPush macro
(2)  527/   74160 :                     	if SonicDriverVer==1
(2)  528/   74160 :                     		dc.b	$ED
(2)  529/   74160 :                     	else
(2)  530/   74160 :                     		fatal "Coord. Flag to clear S1 push block flag does not exist in S2 or S3 drivers. Complain to Flamewing to add it."
(2)  531/   74160 :                     	endif
(2)  532/   74160 :                     	endm
(2)  533/   74160 :                     
(2)  534/   74160 :                     ; Stops special SFX (S1 only) and restarts overridden music track
(2)  535/   74160 :                     smpsStopSpecial macro
(2)  536/   74160 :                     	if SonicDriverVer==1
(2)  537/   74160 :                     		dc.b	$EE
(2)  538/   74160 :                     	else
(2)  539/   74160 :                     		message "Coord. Flag to stop special SFX does not exist in S2 or S3 drivers. Complain to Flamewing to add it. With adequate caution, smpsStop can do this job."
(2)  540/   74160 :                     		smpsStop
(2)  541/   74160 :                     	endif
(2)  542/   74160 :                     	endm
(2)  543/   74160 :                     
(2)  544/   74160 :                     ; EFxx[yy] - Set Voice of FM channel to xx; xx < 0 means yy present
(2)  545/   74160 :                     smpsFMvoice macro voice,songID
(2)  546/   74160 :                     	if (SonicDriverVer>=3)&&("songID"<>"")
(2)  547/   74160 :                     		dc.b	$EF,voice|$80,songID+$81
(2)  548/   74160 :                     	else
(2)  549/   74160 :                     		dc.b	$EF,voice
(2)  550/   74160 :                     	endif
(2)  551/   74160 :                     	endm
(2)  552/   74160 :                     
(2)  553/   74160 :                     ; F0wwxxyyzz - Modulation - ww: wait time - xx: modulation speed - yy: change per step - zz: number of steps
(2)  554/   74160 :                     smpsModSet macro wait,speed,change,step
(2)  555/   74160 :                     	dc.b	$F0
(2)  556/   74160 :                     	if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  557/   74160 :                     		dc.b	wait+1,speed,change,((step+1) * speed) & $FF
(2)  558/   74160 :                     	elseif (SonicDriverVer<3)&&(SourceDriver>=3)
(2)  559/   74160 :                     		dc.b	wait-1,speed,change,conv0To256(step)/conv0To256(speed)-1
(2)  560/   74160 :                     	else
(2)  561/   74160 :                     		dc.b	wait,speed,change,step
(2)  562/   74160 :                     	endif
(2)  563/   74160 :                     	;dc.b	speed,change,step
(2)  564/   74160 :                     	endm
(2)  565/   74160 :                     
(2)  566/   74160 :                     ; Turn on Modulation
(2)  567/   74160 :                     smpsModOn macro type
(2)  568/   74160 :                     	if SonicDriverVer>=3
(2)  569/   74160 :                     		if "type"<>""
(2)  570/   74160 :                     			dc.b	$F4,type
(2)  571/   74160 :                     		else
(2)  572/   74160 :                     			dc.b	$F4,$80
(2)  573/   74160 :                     		endif
(2)  574/   74160 :                     	else
(2)  575/   74160 :                     		dc.b	$F1
(2)  576/   74160 :                     	endif
(2)  577/   74160 :                     	endm
(2)  578/   74160 :                     
(2)  579/   74160 :                     ; F2 - End of channel
(2)  580/   74160 :                     smpsStop macro
(2)  581/   74160 :                     	dc.b	$F2
(2)  582/   74160 :                     	endm
(2)  583/   74160 :                     
(2)  584/   74160 :                     ; F3xx - PSG waveform to xx
(2)  585/   74160 :                     smpsPSGform macro form
(2)  586/   74160 :                     	dc.b	$F3,form
(2)  587/   74160 :                     	endm
(2)  588/   74160 :                     
(2)  589/   74160 :                     ; Turn off Modulation
(2)  590/   74160 :                     smpsModOff macro
(2)  591/   74160 :                     	if SonicDriverVer>=3
(2)  592/   74160 :                     		dc.b	$FA
(2)  593/   74160 :                     	else
(2)  594/   74160 :                     		dc.b	$F4
(2)  595/   74160 :                     	endif
(2)  596/   74160 :                     	endm
(2)  597/   74160 :                     
(2)  598/   74160 :                     ; F5xx - PSG voice to xx
(2)  599/   74160 :                     smpsPSGvoice macro voice
(2)  600/   74160 :                     	dc.b	$F5,voice
(2)  601/   74160 :                     	endm
(2)  602/   74160 :                     
(2)  603/   74160 :                     ; F6xxxx - Jump to xxxx
(2)  604/   74160 :                     smpsJump macro loc
(2)  605/   74160 :                     	dc.b	$F6
(2)  606/   74160 :                     	if SonicDriverVer<>1
(2)  607/   74160 :                     		dc.w	z80_ptr(loc)
(2)  608/   74160 :                     	else
(2)  609/   74160 :                     		dc.w	loc-*-1
(2)  610/   74160 :                     	endif
(2)  611/   74160 :                     	endm
(2)  612/   74160 :                     
(2)  613/   74160 :                     ; F7xxyyzzzz - Loop back to zzzz yy times, xx being the loop index for loop recursion fixing
(2)  614/   74160 :                     smpsLoop macro index,loops,loc
(2)  615/   74160 :                     	dc.b	$F7
(2)  616/   74160 :                     	dc.b	index,loops
(2)  617/   74160 :                     	if SonicDriverVer<>1
(2)  618/   74160 :                     		dc.w	z80_ptr(loc)
(2)  619/   74160 :                     	else
(2)  620/   74160 :                     		dc.w	loc-*-1
(2)  621/   74160 :                     	endif
(2)  622/   74160 :                     	endm
(2)  623/   74160 :                     
(2)  624/   74160 :                     ; F8xxxx - Call pattern at xxxx, saving return point
(2)  625/   74160 :                     smpsCall macro loc
(2)  626/   74160 :                     	dc.b	$F8
(2)  627/   74160 :                     	if SonicDriverVer<>1
(2)  628/   74160 :                     		dc.w	z80_ptr(loc)
(2)  629/   74160 :                     	else
(2)  630/   74160 :                     		dc.w	loc-*-1
(2)  631/   74160 :                     	endif
(2)  632/   74160 :                     	endm
(2)  633/   74160 :                     ; ---------------------------------------------------------------------------
(2)  634/   74160 :                     ; Alter Volume
(2)  635/   74160 :                     smpsFMAlterVol macro val1,val2
(2)  636/   74160 :                     	if ("val2"<>"")
(2)  637/   74160 :                     		; S3K's nerfed 'PSG & FM volume' command with broken PSG support.
(2)  638/   74160 :                     		; The first value is completely unused, while the second is for FM tracks.
(2)  639/   74160 :                     		if (SonicDriverVer>=3)
(2)  640/   74160 :                     			dc.b	$E5,val1,val2
(2)  641/   74160 :                     		else
(2)  642/   74160 :                     			dc.b	$E6,val2
(2)  643/   74160 :                     		endif
(2)  644/   74160 :                     	else
(2)  645/   74160 :                     		; Normal, sane command.
(2)  646/   74160 :                     		dc.b	$E6,val1
(2)  647/   74160 :                     	endif
(2)  648/   74160 :                     	endm
(2)  649/   74160 :                     
(2)  650/   74160 :                     ; S3/S&K/S3D-only coordination flags
(2)  755/   74160 :                     ; ---------------------------------------------------------------------------
(2)  756/   74160 :                     ; S1/S2 only coordination flag
(2)  757/   74160 :                     ; Sets D1L to maximum volume (minimum attenuation) and RR to maximum for operators 3 and 4 of FM1
(2)  758/   74160 :                     smpsMaxRelRate macro
(2)  759/   74160 :                     	if SonicDriverVer>=3
(2)  760/   74160 :                     		; Emulate it in S3/S&K/S3D driver
(2)  761/   74160 :                     		smpsFMICommand $88,$0F
(2)  762/   74160 :                     		smpsFMICommand $8C,$0F
(2)  763/   74160 :                     	else
(2)  764/   74160 :                     		dc.b	$F9
(2)  765/   74160 :                     	endif
(2)  766/   74160 :                     	endm
(2)  767/   74160 :                     ; ---------------------------------------------------------------------------
(2)  768/   74160 :                     ; Backwards compatibility
(2)  769/   74160 :                     smpsAlterNote macro
