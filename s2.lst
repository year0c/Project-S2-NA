     259/     2C4 :                     
     260/     2C4 :                     Z80StartupCodeBegin:
     261/     2C4 :                     	; Z80 instructions (not the sound driver; that gets loaded later)
     263/     2C4 :                     	save
     264/     2C4 :                     	CPU Z80 ; start assembling Z80 code
     265/       0 :                     	phase 0 ; pretend we're at address 0
     266/       0 : AF                  	xor	a	; clear a to 0
     267/       1 : 01 D9 1F            	ld	bc,((z80_ram_end-z80_ram)-zStartupCodeEndLoc)-1 ; prepare to loop this many times
     268/       4 : 11 27 00            	ld	de,zStartupCodeEndLoc+1	; initial destination address
     269/       7 : 21 26 00            	ld	hl,zStartupCodeEndLoc	; initial source address
     270/       A : F9                  	ld	sp,hl	; set the address the stack starts at
     271/       B : 77                  	ld	(hl),a	; set first byte of the stack to 0
     272/       C : ED B0               	ldir		; loop to fill the stack (entire remaining available Z80 RAM) with 0
     273/       E : DD E1               	pop	ix	; clear ix
     274/      10 : FD E1               	pop	iy	; clear iy
     275/      12 : ED 47               	ld	i,a	; clear i
     276/      14 : ED 4F               	ld	r,a	; clear r
     277/      16 : D1                  	pop	de	; clear de
     278/      17 : E1                  	pop	hl	; clear hl
     279/      18 : F1                  	pop	af	; clear af
     280/      19 : 08                  	ex	af,af'	; swap af with af'
     281/      1A : D9                  	exx		; swap bc/de/hl with their shadow registers too
     282/      1B : C1                  	pop	bc	; clear bc
     283/      1C : D1                  	pop	de	; clear de
     284/      1D : E1                  	pop	hl	; clear hl
     285/      1E : F1                  	pop	af	; clear af
     286/      1F : F9                  	ld	sp,hl	; clear sp
     287/      20 : F3                  	di		; clear iff1 (for interrupt handler)
     288/      21 : ED 56               	im	1	; interrupt handling mode = 1
     289/      23 : 36 E9               	ld	(hl),0E9h ; replace the first instruction with a jump to itself
     290/      25 : E9                  	jp	(hl)	  ; jump to the first instruction (to stay there forever)
     291/      26 :                     zStartupCodeEndLoc:
     292/     2EA :                     	dephase ; stop pretending
     293/     2EA : ALL                  	restore
     294/     2EA :                     	padding off ; unfortunately our flags got reset so we have to set them again...
