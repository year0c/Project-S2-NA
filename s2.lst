   15850/   19A5C : 0044                		dc.w Dynamic_Normal_PB-DynArtCue_Index_PB		; HPZ
   15851/   19A5E : 010A                		dc.w AnimCue_HPZ_PB-DynArtCue_Index_PB		; HPZ
