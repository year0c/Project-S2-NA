    6597/    C99E : 2628 000C           		move.l	obY(a0),d3			; load y position
    6598/    C9A2 : 3028 0010           		move.w	obVelX(a0),d0			; load x speed
    6599/    C9A6 : 48C0                		ext.l	d0
    6600/    C9A8 : E180                		asl.l	#8,d0				; shift velocity to line up with the middle 16 bits of the 32-bit position
    6601/    C9AA : D480                		add.l	d0,d2				; add x speed to x position
    6602/    C9AC : 3028 0012           		move.w	obVelY(a0),d0			; load y speed
    6603/    C9B0 : 0668 0038 0012      		addi.w	#$38,obVelY(a0)			; increase vertical speed (apply gravity)
    6604/    C9B6 : 48C0                		ext.l	d0
    6605/    C9B8 : E180                		asl.l	#8,d0				; shift velocity to line up with the middle 16 bits of the 32-bit position
    6606/    C9BA : D680                		add.l	d0,d3				; add old y speed to y position
    6607/    C9BC : 2142 0008           		move.l	d2,obX(a0)			; store new x position
    6608/    C9C0 : 2143 000C           		move.l	d3,obY(a0)			; store new y position
    6609/    C9C4 : 4E75                		rts
    6610/    C9C6 :                     ; End of function ObjectMoveAndFall
