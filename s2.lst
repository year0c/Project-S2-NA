   13475/   1BD90 :                     ; ===========================================================================
   13476/   1BD90 :                     
   13477/   1BD90 :                     		include	"_inc/LevelHeaders.asm"
(1)    1/   1BD90 :                     ; ---------------------------------------------------------------------------
(1)    2/   1BD90 :                     ; "MAIN LEVEL LOAD BLOCK" (after Nemesis)
(1)    3/   1BD90 :                     ;
(1)    4/   1BD90 :                     ; This struct array tells the engine where to find all the art associated with
(1)    5/   1BD90 :                     ; a particular zone. Each zone gets four longwords, in which it stores four
(1)    6/   1BD90 :                     ; pointers (in the lower 24 bits) and three jump table indeces (in the upper eight
(1)    7/   1BD90 :                     ; bits). The assembled data looks something like this:
(1)    8/   1BD90 :                     ;
(1)    9/   1BD90 :                     ; aaBBBBBB
(1)   10/   1BD90 :                     ; ccDDDDDD
(1)   11/   1BD90 :                     ; EEEEEE
(1)   12/   1BD90 :                     ; ffgghhii
(1)   13/   1BD90 :                     ;
(1)   14/   1BD90 :                     ; aa = index for primary pattern load request list
(1)   15/   1BD90 :                     ; BBBBBB = unused, pointer to level art
(1)   16/   1BD90 :                     ; cc = index for secondary pattern load request list
(1)   17/   1BD90 :                     ; DDDDDD = pointer to 16x16 block mappings
(1)   18/   1BD90 :                     ; EEEEEE = pointer to 128x128 block mappings
(1)   19/   1BD90 :                     ; ff = unused, always 0
(1)   20/   1BD90 :                     ; gg = unused, music track
(1)   21/   1BD90 :                     ; hh = unused, palette
(1)   22/   1BD90 :                     ; ii = palette
(1)   23/   1BD90 :                     ;
(1)   24/   1BD90 :                     ; Nemesis refers to this as the "main level load block". However, that name implies
(1)   25/   1BD90 :                     ; that this is code (obviously, it isn't), or at least that it points to the level's
(1)   26/   1BD90 :                     ; collision, object and ring placement arrays (it only points to palettes and 16x16
(1)   27/   1BD90 :                     ; mappings although the 128x128 mappings do affect the actual level layout and collision)
(1)   28/   1BD90 :                     ; ---------------------------------------------------------------------------
(1)   29/   1BD90 :                     
(1)   30/   1BD90 :                     ; macro for declaring a "main level load block" (MLLB)
(1)   31/   1BD90 :                     levartptrs macro plc1,plc2,art,map16x16,map128x128,music,palette
(1)   32/   1BD90 :                     	dc.l (plc1<<24)|art
(1)   33/   1BD90 :                     	dc.l (plc2<<24)|map16x16
(1)   34/   1BD90 :                     	dc.l map128x128
(1)   35/   1BD90 :                     	dc.b 0,music,palette,palette
(1)   36/   1BD90 :                     	endm
(1)   37/   1BD90 :                     
(1)   38/   1BD90 :                     ; MainLoadBlocks:
(1)   39/   1BD90 :                     LevelArtPointers:
(1)   40/   1BD90 : (MACRO)              		levartptrs plcid_GHZ, plcid_GHZ2, Nem_GHZ, Map16_GHZ, Map128_GHZ, bgm_GHZ, palid_GHZ ; GHZ  ; GREEN HILL ZONE
(1)   40/   1BD90 : 040D 8C34                   dc.l (plcid_GHZ<<24)|Nem_GHZ
(1)   40/   1BD94 : 050D 7E34                   dc.l (plcid_GHZ2<<24)|Map16_GHZ
(1)   40/   1BD98 : 000D D850                   dc.l Map128_GHZ
(1)   40/   1BD9C : 0081 0404                   dc.b 0,bgm_GHZ,palid_GHZ,palid_GHZ
(1)   41/   1BDA0 : (MACRO)              		levartptrs plcid_LZ, plcid_LZ2, Nem_CPZ, Map16_CPZ, Map128_CPZ, bgm_LZ, palid_LZ ; LZ   ; LABYRINTH ZONE
(1)   41/   1BDA0 : 060C C8F4                   dc.l (plcid_LZ<<24)|Nem_CPZ
(1)   41/   1BDA4 : 070C B314                   dc.l (plcid_LZ2<<24)|Map16_CPZ
(1)   41/   1BDA8 : 000C FE34                   dc.l Map128_CPZ
(1)   41/   1BDAC : 0082 0505                   dc.b 0,bgm_LZ,palid_LZ,palid_LZ
(1)   42/   1BDB0 : (MACRO)              		levartptrs plcid_CPZ, plcid_CPZ2, Nem_CPZ, Map16_CPZ, Map128_CPZ, bgm_MZ, palid_CPZ ; CPZ  ; CHEMICAL PLANT ZONE
(1)   42/   1BDB0 : 080C C8F4                   dc.l (plcid_CPZ<<24)|Nem_CPZ
(1)   42/   1BDB4 : 090C B314                   dc.l (plcid_CPZ2<<24)|Map16_CPZ
(1)   42/   1BDB8 : 000C FE34                   dc.l Map128_CPZ
(1)   42/   1BDBC : 0083 0606                   dc.b 0,bgm_MZ,palid_CPZ,palid_CPZ
(1)   43/   1BDC0 : (MACRO)              		levartptrs plcid_EHZ, plcid_EHZ2, Nem_EHZ, Map16_EHZ, Map128_EHZ, bgm_SLZ, palid_EHZ ; EHZ  ; EMERALD HILL ZONE
(1)   43/   1BDC0 : 0A0B 2184                   dc.l (plcid_EHZ<<24)|Nem_EHZ
(1)   43/   1BDC4 : 0B0B 11E4                   dc.l (plcid_EHZ2<<24)|Map16_EHZ
(1)   43/   1BDC8 : 000B 6EB2                   dc.l Map128_EHZ
(1)   43/   1BDCC : 0084 0707                   dc.b 0,bgm_SLZ,palid_EHZ,palid_EHZ
(1)   44/   1BDD0 : (MACRO)              		levartptrs plcid_HPZ, plcid_HPZ2, Nem_HPZ, Map16_HPZ, Map128_HPZ, bgm_SYZ, palid_HPZ ; HPZ  ; HIDDEN PALACE ZONE
(1)   44/   1BDD0 : 0C0C 0492                   dc.l (plcid_HPZ<<24)|Nem_HPZ
(1)   44/   1BDD4 : 0D0B EEB2                   dc.l (plcid_HPZ2<<24)|Map16_HPZ
(1)   44/   1BDD8 : 000C 3314                   dc.l Map128_HPZ
(1)   44/   1BDDC : 0085 0808                   dc.b 0,bgm_SYZ,palid_HPZ,palid_HPZ
(1)   45/   1BDE0 : (MACRO)              		levartptrs plcid_HTZ, plcid_HTZ2, Nem_EHZ, Map16_EHZ, Map128_EHZ, bgm_SBZ, palid_HTZ1 ; HTZ  ; HILL TOP ZONE
(1)   45/   1BDE0 : 0E0B 2184                   dc.l (plcid_HTZ<<24)|Nem_EHZ
(1)   45/   1BDE4 : 0F0B 11E4                   dc.l (plcid_HTZ2<<24)|Map16_EHZ
(1)   45/   1BDE8 : 000B 6EB2                   dc.l Map128_EHZ
(1)   45/   1BDEC : 0086 0909                   dc.b 0,bgm_SBZ,palid_HTZ1,palid_HTZ1
(1)   46/   1BDF0 : (MACRO)              		levartptrs 0, 0, Nem_GHZ, Map16_GHZ, Map128_GHZ, bgm_SBZ, palid_Ending ; LEV6 ; LEVEL 6 (UNUSED, SONIC 1 ENDING)
(1)   46/   1BDF0 : 000D 8C34                   dc.l (0<<24)|Nem_GHZ
(1)   46/   1BDF4 : 000D 7E34                   dc.l (0<<24)|Map16_GHZ
(1)   46/   1BDF8 : 000D D850                   dc.l Map128_GHZ
(1)   46/   1BDFC : 0086 1313                   dc.b 0,bgm_SBZ,palid_Ending,palid_Ending
   13478/   1BE00 :                     		include	"_inc/Pattern Load Cues.asm"
(1)    1/   1BE00 :                     ; ---------------------------------------------------------------------------
(1)    2/   1BE00 :                     ; PATTERN LOAD REQUEST LISTS
(1)    3/   1BE00 :                     ;
(1)    4/   1BE00 :                     ; Pattern load request lists are simple structures used to load
(1)    5/   1BE00 :                     ; Nemesis-compressed art for sprites.
(1)    6/   1BE00 :                     ;
(1)    7/   1BE00 :                     ; The decompressor predictably moves down the list, so request 0 is processed first, etc.
(1)    8/   1BE00 :                     ; This only matters if your addresses are bad and you overwrite art loaded in a previous request.
(1)    9/   1BE00 :                     ;
(1)   10/   1BE00 :                     
(1)   11/   1BE00 :                     ; NOTICE: The load queue buffer can only hold $10 (16) load requests. None of the routines
(1)   12/   1BE00 :                     ; that load PLRs into the queue do any bounds checking, so it's possible to create a buffer
(1)   13/   1BE00 :                     ; overflow and completely screw up the variables stored directly after the queue buffer.
(1)   14/   1BE00 :                     ; (in my experience this is a guaranteed crash or hang)
(1)   15/   1BE00 :                     ;
(1)   16/   1BE00 :                     ; Many levels queue more than 16 items overall, but they don't exceed the limit because
(1)   17/   1BE00 :                     ; their PLRs are split into multiple parts (like PLC_GHZ and PLC_GHZ2) and they fully
(1)   18/   1BE00 :                     ; process the first part before requesting the rest.
(1)   19/   1BE00 :                     ; ---------------------------------------------------------------------------
(1)   20/   1BE00 :                     
(1)   21/   1BE00 :                     ;---------------------------------------------------------------------------------------
(1)   22/   1BE00 :                     ; Table of pattern load request lists. Remember to use word-length data when adding lists
(1)   23/   1BE00 :                     ; otherwise you'll break the array.
(1)   24/   1BE00 :                     ;---------------------------------------------------------------------------------------
(1)   25/   1BE00 :                     ArtLoadCues:
(1)   26/   1BE00 :                     
