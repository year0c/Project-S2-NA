   13651/   41430 :                     ; ---------------------------------------------------------------------------
   13652/   41430 :                     ; Leftover symbol tables due to compiler weirdness; these are formatted
   13653/   41430 :                     ; with a Unix ($0A) line break instead of a DOS ($0D0A) line break and it's
   13654/   41430 :                     ; also using big-endian integers, which suggest Sonic 2 wasn't developed in
   13655/   41430 :                     ; DOS (or at least a little-endian environment.)
   13656/   41430 :                     ; in addition, the locations that can be extracted don't even match up with
   13657/   41430 :                     ; the prototype.
   13658/   41430 :                     ;
   13659/   41430 :                     ; Read more about it here:
   13660/   41430 :                     ; https://clownacy.wordpress.com/2022/03/30/everything-that-i-know-about-sonic-the-hedgehogs-source-code/
   13661/   41430 :                     ; https://tcrf.net/Proto:Sonic_the_Hedgehog_2_(Genesis)/Nick_Arcade_Prototype/Symbol_Tables
   13662/   41430 :                     ; ---------------------------------------------------------------------------
   13663/   41430 :                     		binclude	"leftovers/symbols/symbol1.bin"
