   15725/   19ABE : EB48                		lsl.w	#5,d0				; Turn it into an offset
   15726/   19AC0 :                     		; Get VRAM destination address
   15727/   19AC0 : 342A 0004           		move.w	4(a2),d2
   15728/   19AC4 :                     		; Get ROM source address
   15729/   19AC4 : 2212                		move.l	(a2),d1				; Get start address of animated tile art
   15730/   19AC6 : 0281 00FF FFFF      		andi.l	#$FFFFFF,d1
   15731/   19ACC : D280                		add.l	d0,d1				; Offset into art, to get the address of new frame
   15732/   19ACE :                     		; Get size of art to be transferred
   15733/   19ACE : 7600                		moveq	#0,d3
   15734/   19AD0 : 162A 0007           		move.b	7(a2),d3
   15735/   19AD4 : E94B                		lsl.w	#4,d3				; Turn it into actual size (in words)
