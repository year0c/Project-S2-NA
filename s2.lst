     842/    10F2 :                     ; ---------------------------------------------------------------------------
     843/    10F2 :                     ; VDP register settings to use for the game. Do note that a handful of these
     844/    10F2 :                     ; are getting rewritten for every game mode change, though the majority
     845/    10F2 :                     ; will stay at their initial settings defined in this array.
     846/    10F2 :                     ; ---------------------------------------------------------------------------
     847/    10F2 :                     ; See here for details on VDP registers:
     848/    10F2 :                     ; https://segaretro.org/Sega_Mega_Drive/VDP_registers
     849/    10F2 :                     ; ---------------------------------------------------------------------------
     850/    10F2 :                     
     851/    10F2 :                     VDPSetupArray:
     852/    10F2 : 8004                		dc.w $8000|%00000100			; 8-color mode
     853/    10F4 : 8134                		dc.w $8100|%00110100			; vertical interrupts, DMA, Mega Drive display
     854/    10F6 : 8230                		dc.w $8200|(vram_fg>>10)		; foreground nametable address
     855/    10F8 : 8328                		dc.w $8300|($A000>>10)			; window nametable address
     856/    10FA : 8407                		dc.w $8400|(vram_bg>>13)		; background nametable address
     857/    10FC : 857C                		dc.w $8500|(vram_sprites>>9)		; sprite table address
     858/    10FE : 8600                		dc.w $8600				; (unused, only relevant for 128KB VRAM mode)
     859/    1100 : 8700                		dc.w $8700|$00				; background colour (palette line 0, entry 0)
     860/    1102 : 8800                		dc.w $8800				; (unused, only relevant for Master System)
     861/    1104 : 8900                		dc.w $8900				; (unused, only relevant for Master System)
     862/    1106 : 8A00                		dc.w $8A00|$00				; horizontal interrupt register
     863/    1108 : 8B00                		dc.w $8B00|%00000000			; full-screen vertical scrolling
     864/    110A : 8C81                		dc.w $8C00|%10000001			; 40-cell display mode
     865/    110C : 8D3F                		dc.w $8D00|(vram_hscroll>>10)		; background H-scroll address
     866/    110E : 8E00                		dc.w $8E00				; (unused, only relevant for 128KB VRAM mode)
     867/    1110 : 8F02                		dc.w $8F00|$02				; VDP auto-increment size (2)
     868/    1112 : 9001                		dc.w $9000|%00000001			; 64-cell H-scroll size
     869/    1114 : 9100                		dc.w $9100				; window horizontal position
     870/    1116 : 9200                		dc.w $9200				; window vertical position
     871/    1118 :                     VDPSetupArray_End:
