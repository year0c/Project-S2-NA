    1946/    28AA :                     ; Subroutine to calculate sine and cosine of an angle
    1947/    28AA :                     ; d0 = input byte = angle (360 degrees == 256)
    1948/    28AA :                     ; d0 = output word = 255 * sine(angle)
    1949/    28AA :                     ; d1 = output word = 255 * cosine(angle)
    1950/    28AA :                     ; ---------------------------------------------------------------------------
    1951/    28AA :                     
    1952/    28AA :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
