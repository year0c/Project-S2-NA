(2)  788/   74160 :                     ; ---------------------------------------------------------------------------
(2)  789/   74160 :                     ; Macros for FM instruments
(2)  790/   74160 :                     ; Voices - Feedback
(2)  791/   74160 :                     smpsVcFeedback macro val
(2)  792/   74160 :                     vcFeedback eval val
(2)  793/   74160 :                     	endm
(2)  794/   74160 :                     
(2)  795/   74160 :                     ; Voices - Algorithm
(2)  796/   74160 :                     smpsVcAlgorithm macro val
(2)  797/   74160 :                     vcAlgorithm eval val
(2)  798/   74160 :                     	endm
(2)  799/   74160 :                     
(2)  800/   74160 :                     smpsVcUnusedBits macro val,d1r1,d1r2,d1r3,d1r4
(2)  801/   74160 :                     vcUnusedBits eval val
(2)  802/   74160 :                     	if ("d1r1"<>"")&&("d1r2"<>"")&&("d1r3"<>"")&&("d1r4"<>"")
(2)  803/   74160 :                     		eval vcD1R1Unk,d1r1<<5
(2)  804/   74160 :                     		eval vcD1R2Unk,d1r2<<5
(2)  805/   74160 :                     		eval vcD1R3Unk,d1r3<<5
(2)  806/   74160 :                     		eval vcD1R4Unk,d1r4<<5
(2)  807/   74160 :                     	else
(2)  808/   74160 :                     		eval vcD1R1Unk,0
(2)  809/   74160 :                     		eval vcD1R2Unk,0
(2)  810/   74160 :                     		eval vcD1R3Unk,0
(2)  811/   74160 :                     		eval vcD1R4Unk,0
(2)  812/   74160 :                     	endif
(2)  813/   74160 :                     	endm
(2)  814/   74160 :                     
(2)  815/   74160 :                     ; Voices - Detune
(2)  816/   74160 :                     smpsVcDetune macro op1,op2,op3,op4
(2)  817/   74160 :                     	eval vcDT1,op1
(2)  818/   74160 :                     	eval vcDT2,op2
(2)  819/   74160 :                     	eval vcDT3,op3
(2)  820/   74160 :                     	eval vcDT4,op4
(2)  821/   74160 :                     	endm
(2)  822/   74160 :                     
(2)  823/   74160 :                     ; Voices - Coarse-Frequency
(2)  824/   74160 :                     smpsVcCoarseFreq macro op1,op2,op3,op4
(2)  825/   74160 :                     	eval vcCF1,op1
(2)  826/   74160 :                     	eval vcCF2,op2
(2)  827/   74160 :                     	eval vcCF3,op3
(2)  828/   74160 :                     	eval vcCF4,op4
(2)  829/   74160 :                     	endm
(2)  830/   74160 :                     
(2)  831/   74160 :                     ; Voices - Rate Scale
(2)  832/   74160 :                     smpsVcRateScale macro op1,op2,op3,op4
(2)  833/   74160 :                     	eval vcRS1,op1
(2)  834/   74160 :                     	eval vcRS2,op2
(2)  835/   74160 :                     	eval vcRS3,op3
(2)  836/   74160 :                     	eval vcRS4,op4
(2)  837/   74160 :                     	endm
(2)  838/   74160 :                     
(2)  839/   74160 :                     ; Voices - Attack Rate
(2)  840/   74160 :                     smpsVcAttackRate macro op1,op2,op3,op4
(2)  841/   74160 :                     	eval vcAR1,op1
(2)  842/   74160 :                     	eval vcAR2,op2
(2)  843/   74160 :                     	eval vcAR3,op3
(2)  844/   74160 :                     	eval vcAR4,op4
(2)  845/   74160 :                     	endm
(2)  846/   74160 :                     
(2)  847/   74160 :                     ; Voices - Amplitude Modulation
(2)  848/   74160 :                     ; The original SMPS2ASM erroneously assumed the 6th and 7th bits
(2)  849/   74160 :                     ; were the Amplitude Modulation.
(2)  850/   74160 :                     ; According to several docs, however, it's actually the high bit.
(2)  851/   74160 :                     smpsVcAmpMod macro op1,op2,op3,op4
(2)  852/   74160 :                     	if SourceSMPS2ASM==0
(2)  853/   74160 :                     		eval vcAM1,op1<<5
(2)  854/   74160 :                     		eval vcAM2,op2<<5
(2)  855/   74160 :                     		eval vcAM3,op3<<5
(2)  856/   74160 :                     		eval vcAM4,op4<<5
(2)  857/   74160 :                     	else
(2)  858/   74160 :                     		eval vcAM1,op1<<7
(2)  859/   74160 :                     		eval vcAM2,op2<<7
(2)  860/   74160 :                     		eval vcAM3,op3<<7
(2)  861/   74160 :                     		eval vcAM4,op4<<7
(2)  862/   74160 :                     	endif
(2)  863/   74160 :                     	endm
(2)  864/   74160 :                     
(2)  865/   74160 :                     ; Voices - First Decay Rate
(2)  866/   74160 :                     smpsVcDecayRate1 macro op1,op2,op3,op4
(2)  867/   74160 :                     	eval vcD1R1,op1
(2)  868/   74160 :                     	eval vcD1R2,op2
(2)  869/   74160 :                     	eval vcD1R3,op3
(2)  870/   74160 :                     	eval vcD1R4,op4
(2)  871/   74160 :                     	endm
(2)  872/   74160 :                     
(2)  873/   74160 :                     ; Voices - Second Decay Rate
(2)  874/   74160 :                     smpsVcDecayRate2 macro op1,op2,op3,op4
(2)  875/   74160 :                     	eval vcD2R1,op1
(2)  876/   74160 :                     	eval vcD2R2,op2
(2)  877/   74160 :                     	eval vcD2R3,op3
(2)  878/   74160 :                     	eval vcD2R4,op4
(2)  879/   74160 :                     	endm
(2)  880/   74160 :                     
(2)  881/   74160 :                     ; Voices - Decay Level
(2)  882/   74160 :                     smpsVcDecayLevel macro op1,op2,op3,op4
(2)  883/   74160 :                     	eval vcDL1,op1
(2)  884/   74160 :                     	eval vcDL2,op2
(2)  885/   74160 :                     	eval vcDL3,op3
(2)  886/   74160 :                     	eval vcDL4,op4
(2)  887/   74160 :                     	endm
(2)  888/   74160 :                     
(2)  889/   74160 :                     ; Voices - Release Rate
(2)  890/   74160 :                     smpsVcReleaseRate macro op1,op2,op3,op4
(2)  891/   74160 :                     	eval vcRR1,op1
(2)  892/   74160 :                     	eval vcRR2,op2
(2)  893/   74160 :                     	eval vcRR3,op3
(2)  894/   74160 :                     	eval vcRR4,op4
(2)  895/   74160 :                     	endm
(2)  896/   74160 :                     
(2)  897/   74160 :                     smpsNotZ80 function cpu,(cpu<>128)&&(cpu<>32988)
(2)  898/   74160 :                     
(2)  899/   74160 :                     smpsDcb macro
(2)  900/   74160 :                     		if smpsNotZ80(MOMCPU)
(2)  901/   74160 :                     			dc.b ALLARGS
(2)  902/   74160 :                     		else
(2)  903/   74160 :                     			db ALLARGS
(2)  904/   74160 :                     		endif
(2)  905/   74160 :                     	endm
(2)  906/   74160 :                     
(2)  907/   74160 :                     ; Voices - Total Level
(2)  908/   74160 :                     ; The original SMPS2ASM decides TL high bits automatically,
(2)  909/   74160 :                     ; but later versions leave it up to the user.
(2)  910/   74160 :                     ; Alternatively, if we're converting an SMPS 68k song to SMPS Z80,
(2)  911/   74160 :                     ; then we *want* the TL bits to match the algorithm, because SMPS 68k
(2)  912/   74160 :                     ; prefers the algorithm over the TL bits, ignoring the latter, while
(2)  913/   74160 :                     ; SMPS Z80 does the opposite.
(2)  914/   74160 :                     ; Unfortunately, there's nothing we can do if we're trying to convert
(2)  915/   74160 :                     ; an SMPS Z80 song to SMPS 68k. It will ignore the bits no matter
(2)  916/   74160 :                     ; what we do, so we just print a warning.
(2)  917/   74160 :                     smpsVcTotalLevel macro op1,op2,op3,op4
(2)  918/   74160 :                     	eval vcTL1,op1
(2)  919/   74160 :                     	eval vcTL2,op2
(2)  920/   74160 :                     	eval vcTL3,op3
(2)  921/   74160 :                     	eval vcTL4,op4
(2)  922/   74160 :                     	smpsDcb	(vcUnusedBits<<6)+(vcFeedback<<3)+vcAlgorithm
(2)  923/   74160 :                     ;   0     1     2     3     4     5     6     7
(2)  924/   74160 :                     ;%1000,%1000,%1000,%1000,%1010,%1110,%1110,%1111
(2)  925/   74160 :                     	if SourceSMPS2ASM==0
(2)  926/   74160 :                     		eval vcTLMask4,((vcAlgorithm==7)<<7)
(2)  927/   74160 :                     		eval vcTLMask3,((vcAlgorithm>=4)<<7)
(2)  928/   74160 :                     		eval vcTLMask2,((vcAlgorithm>=5)<<7)
(2)  929/   74160 :                     		eval vcTLMask1,128
(2)  930/   74160 :                     	else
(2)  931/   74160 :                     		eval vcTLMask4,0
(2)  932/   74160 :                     		eval vcTLMask3,0
(2)  933/   74160 :                     		eval vcTLMask2,0
(2)  934/   74160 :                     		eval vcTLMask1,0
(2)  935/   74160 :                     	endif
(2)  936/   74160 :                     
(2)  937/   74160 :                     	if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  938/   74160 :                     		eval vcTLMask4,((vcAlgorithm==7)<<7)
(2)  939/   74160 :                     		eval vcTLMask3,((vcAlgorithm>=4)<<7)
(2)  940/   74160 :                     		eval vcTLMask2,((vcAlgorithm>=5)<<7)
(2)  941/   74160 :                     		eval vcTLMask1,128
(2)  942/   74160 :                     		eval vcTL1,vcTL1&127
(2)  943/   74160 :                     		eval vcTL2,vcTL2&127
(2)  944/   74160 :                     		eval vcTL3,vcTL3&127
(2)  945/   74160 :                     		eval vcTL4,vcTL4&127
(2)  946/   74160 :                     	elseif (SonicDriverVer<3)&&(SourceDriver>=3)&&((((vcTL1|vcTLMask1)&128)<>128)||(((vcTL2|vcTLMask2)&128)<>((vcAlgorithm>=5)<<7))||(((vcTL3|vcTLMask3)&128)<>((vcAlgorithm>=4)<<7))||(((vcTL4|vcTLMask4)&128)<>((vcAlgorithm==7)<<7)))
(2)  947/   74160 :                     		if MOMPASS=1
(2)  948/   74160 :                     			message "Voice at 0x\{*} has TL bits that do not match its algorithm setting. This voice will not work in S1/S2 drivers."
(2)  949/   74160 :                     		endif
(2)  950/   74160 :                     	endif
(2)  951/   74160 :                     
(2)  952/   74160 :                     	if SonicDriverVer==2
(2)  953/   74160 :                     		smpsDcb	(vcDT4<<4)+vcCF4       ,(vcDT2<<4)+vcCF2       ,(vcDT3<<4)+vcCF3       ,(vcDT1<<4)+vcCF1
(2)  954/   74160 :                     		smpsDcb	(vcRS4<<6)+vcAR4       ,(vcRS2<<6)+vcAR2       ,(vcRS3<<6)+vcAR3       ,(vcRS1<<6)+vcAR1
(2)  955/   74160 :                     		smpsDcb	vcAM4|vcD1R4|vcD1R4Unk ,vcAM2|vcD1R2|vcD1R2Unk ,vcAM3|vcD1R3|vcD1R3Unk ,vcAM1|vcD1R1|vcD1R1Unk
(2)  956/   74160 :                     		smpsDcb	vcD2R4                 ,vcD2R2                 ,vcD2R3                 ,vcD2R1
(2)  957/   74160 :                     		smpsDcb	(vcDL4<<4)+vcRR4       ,(vcDL2<<4)+vcRR2       ,(vcDL3<<4)+vcRR3       ,(vcDL1<<4)+vcRR1
(2)  958/   74160 :                     		smpsDcb	vcTL4|vcTLMask4        ,vcTL2|vcTLMask2        ,vcTL3|vcTLMask3        ,vcTL1|vcTLMask1
(2)  959/   74160 :                     	else
(2)  960/   74160 :                     		smpsDcb	(vcDT4<<4)+vcCF4       ,(vcDT3<<4)+vcCF3       ,(vcDT2<<4)+vcCF2       ,(vcDT1<<4)+vcCF1
(2)  961/   74160 :                     		smpsDcb	(vcRS4<<6)+vcAR4       ,(vcRS3<<6)+vcAR3       ,(vcRS2<<6)+vcAR2       ,(vcRS1<<6)+vcAR1
(2)  962/   74160 :                     		smpsDcb	vcAM4|vcD1R4|vcD1R4Unk ,vcAM3|vcD1R3|vcD1R3Unk ,vcAM2|vcD1R2|vcD1R2Unk ,vcAM1|vcD1R1|vcD1R1Unk
(2)  963/   74160 :                     		smpsDcb	vcD2R4                 ,vcD2R3                 ,vcD2R2                 ,vcD2R1
(2)  964/   74160 :                     		smpsDcb	(vcDL4<<4)+vcRR4       ,(vcDL3<<4)+vcRR3       ,(vcDL2<<4)+vcRR2       ,(vcDL1<<4)+vcRR1
(2)  965/   74160 :                     		smpsDcb	vcTL4|vcTLMask4        ,vcTL3|vcTLMask3        ,vcTL2|vcTLMask2        ,vcTL1|vcTLMask1
(2)  966/   74160 :                     	endif
(2)  967/   74160 :                     	endm
(2)  968/   74160 :                     
(2)  969/   74160 :                     
(1) 2635/   74160 :                     
(1) 2636/   74160 :                     ; ---------------------------------------------------------------------------
(1) 2637/   74160 :                     ; Music data
(1) 2638/   74160 :                     ; ---------------------------------------------------------------------------
(1) 2639/   74160 :                     Music81:	include "sound/music/Mus81 - GHZ.asm"
(2)    1/   74160 :                     Mus81_GHZ_Header:
(2)    2/   74160 : (MACRO)              	smpsHeaderStartSong 1
