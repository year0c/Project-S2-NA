   15646/   19A4C :                     ; ZONE ANIMATION PROCEDURES AND SCRIPTS
   15647/   19A4C :                     ;
   15648/   19A4C :                     ; Each zone gets two entries in this jump table. The first entry points to the
   15649/   19A4C :                     ; zone's animation procedure (usually Dynamic_Null, AKA none). The second points
   15650/   19A4C :                     ; to the zone's animation script.
   15651/   19A4C :                     ;
   15652/   19A4C :                     ; Seems like stage IDs were already being shifted, since listings for $07-$0F
   15653/   19A4C :                     ; can be found, alongside HPZ's art listed from $08 (its ID in the final).
   15654/   19A4C :                     ; ---------------------------------------------------------------------------
   15655/   19A4C :                     DynArtCue_Index_PB:
   15656/   19A4C : 0042                		dc.w Dynamic_NullGHZ_PB-DynArtCue_Index_PB	; GHZ
   15657/   19A4E : 00AC                		dc.w AnimCue_EHZ_PB-DynArtCue_Index_PB		; GHZ
   15658/   19A50 : 0040                		dc.w Dynamic_Null_PB-DynArtCue_Index_PB		; LZ
   15659/   19A52 : 0136                		dc.w AnimCue_CPZ_Boss_PB-DynArtCue_Index_PB	; LZ
   15660/   19A54 : 0044                		dc.w Dynamic_Normal_PB-DynArtCue_Index_PB		; CPZ
   15661/   19A56 : 0136                		dc.w AnimCue_CPZ_Boss_PB-DynArtCue_Index_PB	; CPZ
   15662/   19A58 : 0044                		dc.w Dynamic_Normal_PB-DynArtCue_Index_PB		; EHZ
