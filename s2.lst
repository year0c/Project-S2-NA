   12779/   1A872 :                     
   12780/   1A872 : 7000                		moveq	#0,d0
   12781/   1A874 : 102B 0001           		move.b	1(a3),d0			; Get current frame
   12782/   1A878 : B02A 0006           		cmp.b	6(a2),d0			; Have we processed the last frame in the script?
   12783/   1A87C : 6506                		blo.s	loc_1AAE0
   12784/   1A87E : 7000                		moveq	#0,d0				; If so, reset to first frame
   12785/   1A880 : 1740 0001           		move.b	d0,1(a3)
   12786/   1A884 :                     
   12787/   1A884 :                     loc_1AAE0:
   12788/   1A884 : 522B 0001           		addq.b	#1,1(a3)			; Consider this frame processed; set counter to next frame
   12789/   1A888 : 1692                		move.b	(a2),(a3)			; Set frame duration to global duration value
   12790/   1A88A : 6A06                		bpl.s	loc_1AAEE
   12791/   1A88C :                     		; If script uses per-frame durations, use those instead
   12792/   1A88C : D040                		add.w	d0,d0
   12793/   1A88E : 16B2 0009           		move.b	9(a2,d0.w),(a3)			; Set frame duration to current frame's duration value
   12794/   1A892 :                     
   12795/   1A892 :                     loc_1AAEE:
   12796/   1A892 :                     		; Prepare for DMA transfer
   12797/   1A892 :                     		; Get relative address of frame's art
   12798/   1A892 : 1032 0008           		move.b	8(a2,d0.w),d0			; Get tile ID
   12799/   1A896 : EB48                		lsl.w	#5,d0				; Turn it into an offset
   12800/   1A898 :                     		; Get VRAM destination address
   12801/   1A898 : 342A 0004           		move.w	4(a2),d2
   12802/   1A89C :                     		; Get ROM source address
   12803/   1A89C : 2212                		move.l	(a2),d1				; Get start address of animated tile art
   12804/   1A89E : 0281 00FF FFFF      		andi.l	#$FFFFFF,d1
   12805/   1A8A4 : D280                		add.l	d0,d1				; Offset into art, to get the address of new frame
   12806/   1A8A6 :                     		; Get size of art to be transferred
   12807/   1A8A6 : 7600                		moveq	#0,d3
   12808/   1A8A8 : 162A 0007           		move.b	7(a2),d3
   12809/   1A8AC : E94B                		lsl.w	#4,d3				; Turn it into actual size (in words)
   12810/   1A8AE :                     		; Use d1, d2 and d3 to queue art for transfer
   12811/   1A8AE : 4EB9 0000 14AC      		jsr	(QueueDMATransfer).l
   12812/   1A8B4 :                     
   12813/   1A8B4 :                     loc_1AB10:
   12814/   1A8B4 : 102A 0006           		move.b	6(a2),d0			; Get total size of frame data
   12815/   1A8B8 : 4A12                		tst.b	(a2)				; Is per-frame duration data present?
   12816/   1A8BA : 6A02                		bpl.s	loc_1AB1A			; If not, keep the current size; it's correct
   12817/   1A8BC : D000                		add.b	d0,d0				; Double size to account for the additional frame duration data
   12818/   1A8BE :                     
   12819/   1A8BE :                     loc_1AB1A:
   12820/   1A8BE : 5200                		addq.b	#1,d0
   12821/   1A8C0 : 0240 00FE           		andi.w	#$FE,d0				; Round to next even address, if it isn't already
   12822/   1A8C4 : 45F2 0008           		lea	8(a2,d0.w),a2			; Advance to next script in list
   12823/   1A8C8 : 544B                		addq.w	#2,a3				; Advance to next script's slot in a3 (usually Anim_Counters)
   12824/   1A8CA : 51CE FFA2           		dbf	d6,loc_1AACA
