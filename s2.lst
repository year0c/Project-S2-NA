    6423/    C766 :                     ; OBJECT POINTER ARRAY ; object pointers ; sprite pointers ; object list ; sprite list
    6424/    C766 :                     ;
    6425/    C766 :                     ; This array contains the pointers to all the objects used in the game.
    6426/    C766 :                     ; ---------------------------------------------------------------------------
    6427/    C766 :                     Obj_Index:
    6428/    C766 :                     
    6429/    C766 :                     objptr:	macro objectpointer,{INTLABEL},{GLOBALSYMBOLS}
    6430/    C766 :                     __LABEL__: = ((*-Obj_Index)/4)+1
    6431/    C766 :                     	dc.l	objectpointer
    6432/    C766 :                     	endm
    6433/    C766 :                     
    6434/    C766 :                     ; ---------------------------------------------------------------------------
    6435/    C766 :                     ; ID label:	non-zero index byte (see ID value)
    6436/    C766 :                     ; Object label:	main label to the actual object source
    6437/    C766 :                     
    6438/    C766 :                     ; ID label			Object label		  ID value
    6439/    C766 : (MACRO)              id_Obj01:	objptr	Obj01				; Sonic
