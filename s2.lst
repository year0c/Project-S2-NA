    6596/    C99E :                     ; Subroutine to make an object move and fall downward increasingly fast
    6597/    C99E :                     ; This moves the object horizontally and vertically
    6598/    C99E :                     ; and also applies gravity to its speed
    6599/    C99E :                     ; ---------------------------------------------------------------------------
    6600/    C99E :                     
    6601/    C99E :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
