    9598/    F180 :                     		; We now perform the x portion of a bounding box check.  To do this, we assume a
    9599/    F180 :                     		; coordinate system where the x origin is at the object's left edge.
    9600/    F180 : 3029 0008           		move.w	obX(a1),d0			; load Sonic's x position...
    9601/    F184 : 9068 0008           		sub.w	obX(a0),d0			; ... and calculate his x position relative to the object
    9602/    F188 : D041                		add.w	d1,d0				; assume object's left edge is at (0,0).  This is also Sonic's distance to the object's left edge.
    9603/    F18A : 6B00 00C4           		bmi.w	SolidObject_TestClearPush	; branch, if Sonic is outside the object's left edge
    9604/    F18E : 3601                		move.w	d1,d3
    9605/    F190 : D643                		add.w	d3,d3				; calculate object's width
    9606/    F192 : B043                		cmp.w	d3,d0
