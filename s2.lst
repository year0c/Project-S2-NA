    1911/    2884 :                     ; Subroutine to generate a pseudo-random number in d0
    1912/    2884 :                     ; d0 = (RNG & $FFFF0000) | ((RNG*41 & $FFFF) + ((RNG*41 & $FFFF0000) >> 16))
    1913/    2884 :                     ; RNG = ((RNG*41 + ((RNG*41 & $FFFF) << 16)) & $FFFF0000) | (RNG*41 & $FFFF)
    1914/    2884 :                     ; ---------------------------------------------------------------------------
    1915/    2884 :                     
    1916/    2884 :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
    1917/    2884 :                     
    1918/    2884 :                     ; PseudoRandomNumber:
    1919/    2884 :                     RandomNumber:
    1920/    2884 : 2238 F636           		move.l	(v_random).w,d1
    1921/    2888 : 6606                		bne.s	loc_2C9C
    1922/    288A : 223C 2A6D 365A      		move.l	#$2A6D365A,d1
    1923/    2890 :                     
    1924/    2890 :                     loc_2C9C:
    1925/    2890 :                     		; set the high word of d0 to be the high word of the RNG
    1926/    2890 :                     		; and multiply the RNG by 41
    1927/    2890 : 2001                		move.l	d1,d0
    1928/    2892 : E581                		asl.l	#2,d1
    1929/    2894 : D280                		add.l	d0,d1
    1930/    2896 : E781                		asl.l	#3,d1
    1931/    2898 : D280                		add.l	d0,d1
    1932/    289A :                     
    1933/    289A :                     		; add the low word of the RNG to the high word of the RNG
    1934/    289A :                     		; and set the low word of d0 to be the result
    1935/    289A : 3001                		move.w	d1,d0
    1936/    289C : 4841                		swap	d1
    1937/    289E : D041                		add.w	d1,d0
    1938/    28A0 : 3200                		move.w	d0,d1
    1939/    28A2 : 4841                		swap	d1
    1940/    28A4 :                     
    1941/    28A4 : 21C1 F636           		move.l	d1,(v_random).w
    1942/    28A8 : 4E75                		rts
    1943/    28AA :                     ; End of function RandomNumber
