(2)  568/   74164 :                     	if SonicDriverVer>=3
(2)  569/   74164 :                     		if "type"<>""
(2)  570/   74164 :                     			dc.b	$F4,type
(2)  571/   74164 :                     		else
(2)  572/   74164 :                     			dc.b	$F4,$80
(2)  573/   74164 :                     		endif
(2)  574/   74164 :                     	else
(2)  575/   74164 :                     		dc.b	$F1
(2)  576/   74164 :                     	endif
(2)  577/   74164 :                     	endm
(2)  578/   74164 :                     
(2)  579/   74164 :                     ; F2 - End of channel
(2)  580/   74164 :                     smpsStop macro
(2)  581/   74164 :                     	dc.b	$F2
