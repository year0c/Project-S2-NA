    1136/    148C :                     ; Subroutine to transfer a plane map to VRAM
    1137/    148C :                     ; ---------------------------------------------------------------------------
    1138/    148C :                     
    1139/    148C :                     ; control register:
    1140/    148C :                     ;    CD1 CD0 A13 A12 A11 A10 A09 A08     (D31-D24)
    1141/    148C :                     ;    A07 A06 A05 A04 A03 A02 A01 A00     (D23-D16)
    1142/    148C :                     ;     ?   ?   ?   ?   ?   ?   ?   ?      (D15-D8)
    1143/    148C :                     ;    CD5 CD4 CD3 CD2  ?   ?  A15 A14     (D7-D0)
    1144/    148C :                     ;
    1145/    148C :                     ;	A00-A15 - address
    1146/    148C :                     ;	CD0-CD3 - code
    1147/    148C :                     ;	CD4 - 1 if VRAM copy DMA mode. 0 otherwise.
    1148/    148C :                     ;	CD5 - DMA operation
    1149/    148C :                     ;
    1150/    148C :                     ;	Bits CD3-CD0:
    1151/    148C :                     ;	0000 - VRAM read
    1152/    148C :                     ;	0001 - VRAM write
    1153/    148C :                     ;	0011 - CRAM write
    1154/    148C :                     ;	0100 - VSRAM read
    1155/    148C :                     ;	0101 - VSRAM write
    1156/    148C :                     ;	1000 - CRAM read
    1157/    148C :                     ;
    1158/    148C :                     ; d0 = control register
    1159/    148C :                     ; d1 = width
    1160/    148C :                     ; d2 = heigth
    1161/    148C :                     ; a1 = source address
    1162/    148C :                     
    1163/    148C :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
