   15713/   19AAC :                     .loc_1AAE0:
   15714/   19AAC : 522B 0001           		addq.b	#1,1(a3)			; Consider this frame processed; set counter to next frame
   15715/   19AB0 : 1692                		move.b	(a2),(a3)			; Set frame duration to global duration value
   15716/   19AB2 : 6A06                		bpl.s	.loc_1AAEE
   15717/   19AB4 :                     		; If script uses per-frame durations, use those instead
   15718/   19AB4 : D040                		add.w	d0,d0
   15719/   19AB6 : 16B2 0009           		move.b	9(a2,d0.w),(a3)			; Set frame duration to current frame's duration value
   15720/   19ABA :                     
