(2)  537/   74164 :                     		dc.b	$EE
(2)  538/   74164 :                     	else
(2)  539/   74164 :                     		message "Coord. Flag to stop special SFX does not exist in S2 or S3 drivers. Complain to Flamewing to add it. With adequate caution, smpsStop can do this job."
(2)  540/   74164 :                     		smpsStop
(2)  541/   74164 :                     	endif
