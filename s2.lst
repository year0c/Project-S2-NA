(2)   16/   74380 : =$1                  SMPS2ASMVer	= 1
(2)   17/   74380 :                     
(2)   18/   74380 :                     ; PSG conversion to S3/S&K/S3D drivers require a tone shift of 12 semi-tones.
(2)   19/   74380 : =$C                  psgdelta	EQU 12
(2)   20/   74380 :                     ; ---------------------------------------------------------------------------
(2)   21/   74380 :                     ; Standard Octave Pitch Equates
(2)   22/   74380 :                     	enumconf	$C
(2)   23/   74380 : =$88..$B8            	enum		smpsPitch10lo=$88,smpsPitch09lo,smpsPitch08lo,smpsPitch07lo,smpsPitch06lo
(2)   24/   74380 : =$C4..$F4            	nextenum	smpsPitch05lo,smpsPitch04lo,smpsPitch03lo,smpsPitch02lo,smpsPitch01lo
(2)   25/   74380 : =$0..$30             	enum		smpsPitch00=$00,smpsPitch01hi,smpsPitch02hi,smpsPitch03hi,smpsPitch04hi
(2)   26/   74380 : =$3C..$6C            	nextenum	smpsPitch05hi,smpsPitch06hi,smpsPitch07hi,smpsPitch08hi,smpsPitch09hi
(2)   27/   74380 : =$78                 	nextenum	smpsPitch10hi
(2)   28/   74380 :                     	enumconf	1
