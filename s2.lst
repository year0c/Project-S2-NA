    9617/    F1A0 : 3629 000C           		move.w	obY(a1),d3			; load Sonic's y position
    9618/    F1A4 : 9668 000C           		sub.w	obY(a0),d3			; ... and calculate his y position relative to the object
    9619/    F1A8 : 5843                		addq.w	#4,d3				; assume a slightly lower position for Sonic
    9620/    F1AA : D642                		add.w	d2,d3				; assume the highest position where Sonic would still be colliding with the object to be (0,0)
    9621/    F1AC : 6B00 00A2           		bmi.w	SolidObject_TestClearPush	; branch, if Sonic is above this point
    9622/    F1B0 : 3802                		move.w	d2,d4
    9623/    F1B2 : D844                		add.w	d4,d4				; calculate minimum distance for a bottom collision
    9624/    F1B4 : B644                		cmp.w	d4,d3
    9625/    F1B6 : 6400 0098           		bhs.w	SolidObject_TestClearPush	; branch, if Sonic is below this point
