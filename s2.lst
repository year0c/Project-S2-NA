   16684/   7FDA4 :                     ; ---------------------------------------------------------------------------
   16685/   7FDA4 :                     ; Uncompressed graphics - Sonic and Tails
   16686/   7FDA4 :                     ; ---------------------------------------------------------------------------
   16687/   7FDA4 :                     ; This must be aligned to a bank in order to avoid issues with the DMA.
   16688/   7FDA4 :                     ; But because all of the art is placed after the sound driver which already aligns with the bank,
   16689/   7FDA4 :                     ; this fixes itself.
   16690/   7FDA4 :                     ; The exact location in ROM that this is located at is 0x80000.
   16692/   7FDA4 :                     	; Ensure properly art alignment, unnessesary if the DMA bug fix is enabled for 128kb boundaries.
   16693/   7FDA4 : (MACRO)              	align $8000
   16693/   7FDA4 :  (MACRO-2)                   cnop 0,$8000
   16693/   7FDA4 :   (MACRO-3)                          org (*-1+($8000)-((*-1+(-(0)))#($8000)))
   16693/   80000 :                                             !org (*-1+($8000)-((*-1+(-(0)))#($8000)))
   16695/   80000 :                     Art_Sonic:	binclude	"art/uncompressed/Sonic's art.bin"
