(1)  900/    6178 :                     		; Rather than scroll each individual line of the background, this
(1)  901/    6178 :                     		; zone scrolls entire blocks of lines (16 lines) at once. The scroll
(1)  902/    6178 :                     		; value of each row is written to 'TempArray_LayerDef', before it is
(1)  903/    6178 :                     		; applied to 'Horiz_Scroll_Buf' in 'Deform_HPZ_Continued'. This is
(1)  904/    6178 :                     		; vaguely similar to how Chemical Plant Zone scrolls its background,
(1)  905/    6178 :                     		; even overflowing 'Horiz_Scroll_Buf' in the same way.
(1)  906/    6178 : 43F8 9C00           		lea	(v_bgscroll_buffer).w,a1
