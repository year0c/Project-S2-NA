    6772/    CBBA :                     ; ---------------------------------------------------------------------------
    6773/    CBBA :                     ; Subroutine to make an object move and fall downward increasingly fast
    6774/    CBBA :                     ; This moves the object horizontally and vertically
    6775/    CBBA :                     ; and also applies gravity to its speed
    6776/    CBBA :                     ; ---------------------------------------------------------------------------
    6777/    CBBA :                     
    6778/    CBBA :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
    6779/    CBBA :                     
    6780/    CBBA :                     ObjectMoveAndFall:
    6781/    CBBA :                     ObjectFall:
    6782/    CBBA : 2428 0008           		move.l	obX(a0),d2			; load x position
    6783/    CBBE : 2628 000C           		move.l	obY(a0),d3			; load y position
    6784/    CBC2 : 3028 0010           		move.w	obVelX(a0),d0			; load x speed
    6785/    CBC6 : 48C0                		ext.l	d0
    6786/    CBC8 : E180                		asl.l	#8,d0				; shift velocity to line up with the middle 16 bits of the 32-bit position
    6787/    CBCA : D480                		add.l	d0,d2				; add x speed to x position
    6788/    CBCC : 3028 0012           		move.w	obVelY(a0),d0			; load y speed
    6789/    CBD0 : 0668 0038 0012      		addi.w	#$38,obVelY(a0)			; increase vertical speed (apply gravity)
    6790/    CBD6 : 48C0                		ext.l	d0
    6791/    CBD8 : E180                		asl.l	#8,d0				; shift velocity to line up with the middle 16 bits of the 32-bit position
    6792/    CBDA : D680                		add.l	d0,d3				; add old y speed to y position
    6793/    CBDC : 2142 0008           		move.l	d2,obX(a0)			; store new x position
    6794/    CBE0 : 2143 000C           		move.l	d3,obY(a0)			; store new y position
    6795/    CBE4 : 4E75                		rts
    6796/    CBE6 :                     ; End of function ObjectMoveAndFall
    6797/    CBE6 :                     
    6798/    CBE6 :                     ; ---------------------------------------------------------------------------
    6799/    CBE6 :                     ; Subroutine translating object speed to update object position
    6800/    CBE6 :                     ; This moves the object horizontally and vertically
    6801/    CBE6 :                     ; but does not apply gravity to it
    6802/    CBE6 :                     ; ---------------------------------------------------------------------------
    6803/    CBE6 :                     
