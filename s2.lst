   15706/   19A9A : 7000                		moveq	#0,d0
   15707/   19A9C : 102B 0001           		move.b	1(a3),d0			; Get current frame
   15708/   19AA0 : B02A 0006           		cmp.b	6(a2),d0			; Have we processed the last frame in the script?
   15709/   19AA4 : 6506                		blo.s	.loc_1AAE0
   15710/   19AA6 : 7000                		moveq	#0,d0				; If so, reset to first frame
