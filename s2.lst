(2)    1/   72A00 :                     ;  DZ80 V3.4.1 Z80 Disassembly of z80nodata.bin
(2)    2/   72A00 :                     ;  2007/09/18 15:48
(2)    3/   72A00 :                     ;  Sonic 1 Z80 Driver disassembly by Puto.
(2)    4/   72A00 :                     ;  Disassembly fixed, improved and integrated into SVN by Flamewing.
(2)    5/   72A00 :                     ;  Should be assembled with AS (though it should be easily portable to other assemblers if necessary).
(2)    6/   72A00 :                     ;
(2)    7/   72A00 :                     
(2)    8/   72A00 :                     	save
(2)    9/       0 :                     	!org	0		; z80 Align, handled by the build process
(2)   10/       0 :                     	CPU Z80
(2)   11/       0 :                     	listing purecode
(2)   12/       0 :                     
(2)   13/       0 : =1FFCH               z80_stack:	equ 1FFCh
(2)   14/       0 : =1FFDH               zDAC_Status:	equ 1FFDh	; Bit 7 set if the driver is not accepting new samples, it is clear otherwise
(2)   15/       0 : =1FFFH               zDAC_Sample:	equ 1FFFh	; Sample to play, the 68k will move into this locatiton whatever sample that's supposed to be played.
(2)   16/       0 :                     
(2)   17/       0 : =4000H               zYM2612_A0:	equ 4000h
(2)   18/       0 : =6000H               zBankRegister:	equ 6000h
(2)   19/       0 : =8000H               zROMWindow:	equ 8000h
(2)   20/       0 :                     
