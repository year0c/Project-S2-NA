(2)   40/   74164 : =$B1..$B6            	nextenum	nC4=nBs3,nCs4,nDb4=nCs4,nD4,nDs4,nEb4=nDs4,nE4,nFb4=nE4,nEs4,nF4=nEs4
(2)   41/   74164 : =$B7..$BD            	nextenum	nFs4,nGb4=nFs4,nG4,nGs4,nAb4=nGs4,nA4,nAs4,nBb4=nAs4,nB4,nCb5=nB4,nBs4
(2)   42/   74164 : =$BD..$C2            	nextenum	nC5=nBs4,nCs5,nDb5=nCs5,nD5,nDs5,nEb5=nDs5,nE5,nFb5=nE5,nEs5,nF5=nEs5
(2)   43/   74164 : =$C3..$C9            	nextenum	nFs5,nGb5=nFs5,nG5,nGs5,nAb5=nGs5,nA5,nAs5,nBb5=nAs5,nB5,nCb6=nB5,nBs5
(2)   44/   74164 : =$C9..$CE            	nextenum	nC6=nBs5,nCs6,nDb6=nCs6,nD6,nDs6,nEb6=nDs6,nE6,nFb6=nE6,nEs6,nF6=nEs6
(2)   45/   74164 : =$CF..$D5            	nextenum	nFs6,nGb6=nFs6,nG6,nGs6,nAb6=nGs6,nA6,nAs6,nBb6=nAs6,nB6,nCb7=nB6,nBs6
(2)   46/   74164 : =$D5..$DA            	nextenum	nC7=nBs6,nCs7,nDb7=nCs7,nD7,nDs7,nEb7=nDs7,nE7,nFb7=nE7,nEs7,nF7=nEs7
(2)   47/   74164 : =$DB..$DF            	nextenum	nFs7,nGb7=nFs7,nG7,nGs7,nAb7=nGs7,nA7,nAs7,nBb7=nAs7
(2)   48/   74164 :                     ; SMPS2ASM uses nMaxPSG for songs from S1/S2 drivers.
(2)   49/   74164 :                     ; nMaxPSG1 and nMaxPSG2 are used only for songs from S3/S&K/S3D drivers.
(2)   50/   74164 :                     ; The use of psgdelta is intended to undo the effects of PSGPitchConvert
(2)   51/   74164 :                     ; and ensure that the ending note is indeed the maximum PSG frequency.
(2)   53/   74164 : =$C6                 nMaxPSG				EQU nA5
(2)   54/   74164 : =$D2                 nMaxPSG1			EQU nA5+psgdelta
(2)   55/   74164 : =$D2                 nMaxPSG2			EQU nA5+psgdelta
(2)   61/   74164 :                     ; ---------------------------------------------------------------------------
(2)   62/   74164 :                     ; PSG volume envelope equates
(2)   65/   74164 : =$1..$6              			enum		fTone_01=$01,fTone_02,fTone_03,fTone_04,fTone_05,fTone_06
(2)   66/   74164 : =$7..$9              			nextenum	fTone_07,fTone_08,fTone_09
(2)   86/   74164 :                     ; ---------------------------------------------------------------------------
(2)   87/   74164 :                     ; DAC Equates
(2)   90/   74164 : =$81..$83            			enum		dKick=$81,dSnare,dTimpani
(2)   91/   74164 : =$88..$8B            			enum		dHiTimpani=$88,dMidTimpani,dLowTimpani,dVLowTimpani
(2)  169/   74164 :                     ; ---------------------------------------------------------------------------
(2)  170/   74164 :                     ; Channel IDs for SFX
(2)  171/   74164 : =$80                 cPSG1				EQU $80
(2)  172/   74164 : =$A0                 cPSG2				EQU $A0
(2)  173/   74164 : =$C0                 cPSG3				EQU $C0
(2)  174/   74164 : =$E0                 cNoise				EQU $E0	; Not for use in S3/S&K/S3D
(2)  175/   74164 : =$2                  cFM3				EQU $02
(2)  176/   74164 : =$4                  cFM4				EQU $04
(2)  177/   74164 : =$5                  cFM5				EQU $05
(2)  178/   74164 : =$6                  cFM6				EQU $06	; Only in S3/S&K/S3D, overrides DAC
(2)  179/   74164 :                     ; ---------------------------------------------------------------------------
(2)  180/   74164 :                     ; Conversion macros and functions
(2)  181/   74164 :                     
(2)  182/   74164 :                     conv0To256  function n,((n==0)<<8)|n
(2)  183/   74164 :                     s2TempotoS1 function n,(((768-n)>>1)/(256-n))&$FF
(2)  184/   74164 :                     s2TempotoS3 function n,($100-((n==0)|n))&$FF
(2)  185/   74164 :                     s1TempotoS2 function n,((((conv0To256(n)-1)<<8)+(conv0To256(n)>>1))/conv0To256(n))&$FF
(2)  186/   74164 :                     s1TempotoS3 function n,s2TempotoS3(s1TempotoS2(n))
(2)  187/   74164 :                     s3TempotoS1 function n,s2TempotoS1(s2TempotoS3(n))
(2)  188/   74164 :                     s3TempotoS2 function n,s2TempotoS3(n)
(2)  189/   74164 :                     
(2)  190/   74164 :                     convertMainTempoMod macro mod
(2)  191/   74164 :                     	if ((SourceDriver>=3)&&(SonicDriverVer>=3))||(SonicDriverVer==SourceDriver)
(2)  192/   74164 :                     		dc.b	mod
(2)  193/   74164 :                     	elseif SourceDriver==1
(2)  194/   74164 :                     		if mod==1
(2)  195/   74164 :                     			fatal "Invalid main tempo of 1 in song from Sonic 1"
(2)  196/   74164 :                     		endif
(2)  197/   74164 :                     		if SonicDriverVer==2
(2)  198/   74164 :                     			dc.b	s1TempotoS2(mod)
(2)  199/   74164 :                     		else;if SonicDriverVer>=3
(2)  200/   74164 :                     			dc.b	s1TempotoS3(mod)
(2)  201/   74164 :                     		endif
(2)  202/   74164 :                     	elseif SourceDriver==2
(2)  203/   74164 :                     		if mod==0
(2)  204/   74164 :                     			fatal "Invalid main tempo of 0 in song from Sonic 2"
(2)  205/   74164 :                     		endif
(2)  206/   74164 :                     		if SonicDriverVer==1
(2)  207/   74164 :                     			dc.b	s2TempotoS1(mod)
(2)  208/   74164 :                     		else;if SonicDriverVer>=3
(2)  209/   74164 :                     			dc.b	s2TempotoS3(mod)
(2)  210/   74164 :                     		endif
(2)  211/   74164 :                     	else;if SourceDriver>=3
(2)  212/   74164 :                     		if mod==0
(2)  213/   74164 :                     			message "Performing approximate conversion of Sonic 3 main tempo modifier of 0"
(2)  214/   74164 :                     		endif
(2)  215/   74164 :                     		if SonicDriverVer==1
(2)  216/   74164 :                     			dc.b	s3TempotoS1(mod)
(2)  217/   74164 :                     		else;if SonicDriverVer==2
(2)  218/   74164 :                     			dc.b	s3TempotoS2(mod)
(2)  219/   74164 :                     		endif
(2)  220/   74164 :                     	endif
(2)  221/   74164 :                     	endm
(2)  222/   74164 :                     
(2)  223/   74164 :                     ; PSG conversion to S3/S&K/S3D drivers require a tone shift of 12 semi-tones.
(2)  224/   74164 :                     PSGPitchConvert macro pitch
(2)  225/   74164 :                     	if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  226/   74164 :                     		dc.b	(pitch+psgdelta)&$FF
(2)  227/   74164 :                     	elseif (SonicDriverVer<3)&&(SourceDriver>=3)
(2)  228/   74164 :                     		dc.b	(pitch-psgdelta)&$FF
(2)  229/   74164 :                     	else
(2)  230/   74164 :                     		dc.b	pitch
(2)  231/   74164 :                     	endif
(2)  232/   74164 :                     	endm
(2)  233/   74164 :                     
(2)  234/   74164 :                     CheckedChannelPointer macro loc
(2)  235/   74164 :                     	if SonicDriverVer<>1
(2)  236/   74164 :                     		dc.w	z80_ptr(loc)
(2)  237/   74164 :                     	else
(2)  238/   74164 :                     		if (MOMPASS=1)&&(DEFINED(loc))
(2)  239/   74164 :                     			fatal "Tracks for Sonic 1 songs must come after the start of the song"
(2)  240/   74164 :                     		endif
(2)  241/   74164 :                     		dc.w	loc-songStart
(2)  242/   74164 :                     	endif
(2)  243/   74164 :                     	endm
(2)  244/   74164 :                     ; ---------------------------------------------------------------------------
(2)  245/   74164 :                     ; Header Macros
(2)  246/   74164 :                     smpsHeaderStartSong macro ver, sourcesmps2asmver
(2)  247/   74164 :                     
(2)  248/   74164 :                     SourceDriver set ver
(2)  249/   74164 :                     
(2)  250/   74164 :                     	if ("sourcesmps2asmver"<>"")
(2)  251/   74164 :                     		set SourceSMPS2ASM,sourcesmps2asmver
(2)  252/   74164 :                     	else
(2)  253/   74164 :                     		set SourceSMPS2ASM,0
(2)  254/   74164 :                     	endif
(2)  255/   74164 :                     
(2)  256/   74164 :                     songStart set *
(2)  257/   74164 :                     
(2)  258/   74164 :                     	if MOMPASS=1
(2)  259/   74164 :                     		if SMPS2ASMVer < SourceSMPS2ASM
(2)  260/   74164 :                     			message "Song at 0x\{songStart} was made for a newer version of SMPS2ASM (this is version \{SMPS2ASMVer}, but song wants at least version \{SourceSMPS2ASM})."
(2)  261/   74164 :                     		endif
(2)  262/   74164 :                     	endif
(2)  263/   74164 :                     
(2)  264/   74164 :                     	endm
(2)  265/   74164 :                     
(2)  266/   74164 :                     smpsHeaderVoiceNull macro
(2)  267/   74164 :                     	if songStart<>*
(2)  268/   74164 :                     		fatal "Missing smpsHeaderStartSong"
(2)  269/   74164 :                     	endif
(2)  270/   74164 :                     	dc.w	$0000
(2)  271/   74164 :                     	endm
(2)  272/   74164 :                     
(2)  273/   74164 :                     ; Header - Set up Voice Location
(2)  274/   74164 :                     ; Common to music and SFX
(2)  275/   74164 :                     smpsHeaderVoice macro loc
(2)  276/   74164 :                     	if songStart<>*
(2)  277/   74164 :                     		fatal "Missing smpsHeaderStartSong"
(2)  278/   74164 :                     	endif
(2)  279/   74164 :                     	if SonicDriverVer<>1
(2)  280/   74164 :                     		dc.w	z80_ptr(loc)
(2)  281/   74164 :                     	else
(2)  282/   74164 :                     		if (MOMPASS=1)&&(DEFINED(loc))
(2)  283/   74164 :                     			fatal "Voice banks for Sonic 1 songs must come after the start of the song"
(2)  284/   74164 :                     		endif
(2)  285/   74164 :                     		dc.w	loc-songStart
(2)  286/   74164 :                     	endif
(2)  287/   74164 :                     	endm
(2)  288/   74164 :                     
(2)  289/   74164 :                     ; Header - Set up Voice Location as S3's Universal Voice Bank
(2)  290/   74164 :                     ; Common to music and SFX
(2)  291/   74164 :                     smpsHeaderVoiceUVB macro
(2)  292/   74164 :                     	if songStart<>*
(2)  293/   74164 :                     		fatal "Missing smpsHeaderStartSong"
(2)  294/   74164 :                     	endif
(2)  295/   74164 :                     	if SonicDriverVer>=5
(2)  296/   74164 :                     		dc.w	z80_ptr(z80_UniVoiceBank)
(2)  297/   74164 :                     	elseif SonicDriverVer>=3
(2)  298/   74164 :                     		dc.w	little_endian(z80_UniVoiceBank)
(2)  299/   74164 :                     	else
(2)  300/   74164 :                     		fatal "Universal Voice Bank does not exist in Sonic 1 or Sonic 2 drivers"
(2)  301/   74164 :                     	endif
(2)  302/   74164 :                     	endm
(2)  303/   74164 :                     
(2)  304/   74164 :                     ; Header macros for music (not for SFX)
(2)  305/   74164 :                     ; Header - Set up Channel Usage
(2)  306/   74164 :                     smpsHeaderChan macro fm,psg
(2)  307/   74164 :                     	dc.b	fm,psg
(2)  308/   74164 :                     	endm
(2)  309/   74164 :                     
(2)  310/   74164 :                     ; Header - Set up Tempo
(2)  311/   74164 :                     smpsHeaderTempo macro div,mod
(2)  312/   74164 :                     	dc.b	div
(2)  313/   74164 :                     	convertMainTempoMod mod
(2)  314/   74164 :                     	endm
(2)  315/   74164 :                     
(2)  316/   74164 :                     ; Header - Set up DAC Channel
(2)  317/   74164 :                     smpsHeaderDAC macro loc,pitch,vol
(2)  318/   74164 :                     	CheckedChannelPointer loc
(2)  319/   74164 :                     	if ("pitch"<>"")
(2)  320/   74164 :                     		dc.b	pitch
(2)  321/   74164 :                     		if ("vol"<>"")
(2)  322/   74164 :                     			dc.b	vol
(2)  323/   74164 :                     		else
(2)  324/   74164 :                     			dc.b	$00
(2)  325/   74164 :                     		endif
(2)  326/   74164 :                     	else
(2)  327/   74164 :                     		dc.w	$00
(2)  328/   74164 :                     	endif
(2)  329/   74164 :                     	endm
(2)  330/   74164 :                     
(2)  331/   74164 :                     ; Header - Set up FM Channel
(2)  332/   74164 :                     smpsHeaderFM macro loc,pitch,vol
(2)  333/   74164 :                     	CheckedChannelPointer loc
(2)  334/   74164 :                     	dc.b	pitch,vol
(2)  335/   74164 :                     	endm
(2)  336/   74164 :                     
(2)  337/   74164 :                     ; Header - Set up PSG Channel
(2)  338/   74164 :                     smpsHeaderPSG macro loc,pitch,vol,mod,voice
(2)  339/   74164 :                     	CheckedChannelPointer loc
(2)  340/   74164 :                     	PSGPitchConvert pitch
(2)  341/   74164 :                     	dc.b	vol
(2)  342/   74164 :                     	; Frequency envelope
(2)  343/   74164 :                     	if (SonicDriverVer>=3) && (SourceDriver<3)
(2)  344/   74164 :                     		; In SMPS 68k Type 1, this byte is skipped and can contain garbage.
(2)  345/   74164 :                     		; Sonic 2's Oil Ocean Zone and Ending themes set this byte to a non-zero value which
(2)  346/   74164 :                     		; other drivers may try to process as valid data, so manually force it to 0 here.
(2)  347/   74164 :                     		dc.b	0
(2)  348/   74164 :                     	else
(2)  349/   74164 :                     		if (MOMPASS==1) && (SonicDriverVer<3) && (SourceDriver>=3) && (mod<>0)
(2)  350/   74164 :                     			message "This track header specifies a frequency envelope, but this driver does not support them."
(2)  351/   74164 :                     		endif
(2)  352/   74164 :                     		dc.b	mod
(2)  353/   74164 :                     	endif
(2)  354/   74164 :                     	; Volume envelope
(2)  355/   74164 :                     	dc.b	voice
(2)  356/   74164 :                     	endm
(2)  357/   74164 :                     
(2)  358/   74164 :                     ; Header macros for SFX (not for music)
(2)  359/   74164 :                     ; Header - Set up Tempo
(2)  360/   74164 :                     smpsHeaderTempoSFX macro div
(2)  361/   74164 :                     	dc.b	div
(2)  362/   74164 :                     	endm
(2)  363/   74164 :                     
(2)  364/   74164 :                     ; Header - Set up Channel Usage
(2)  365/   74164 :                     smpsHeaderChanSFX macro chan
(2)  366/   74164 :                     	dc.b	chan
(2)  367/   74164 :                     	endm
(2)  368/   74164 :                     
(2)  369/   74164 :                     ; Header - Set up FM Channel
(2)  370/   74164 :                     smpsHeaderSFXChannel macro chanid,loc,pitch,vol
(2)  371/   74164 :                     	if (SonicDriverVer>=3)&&(chanid==cNoise)
(2)  372/   74164 :                     		fatal "Using channel ID of cNoise ($E0) in Sonic 3 driver is dangerous. Fix the song so that it turns into a noise channel instead."
(2)  373/   74164 :                     	elseif (SonicDriverVer<3)&&(chanid==cFM6)
(2)  374/   74164 :                     		fatal "Using channel ID of FM6 ($06) in Sonic 1 or Sonic 2 drivers is unsupported. Change it to another channel."
(2)  375/   74164 :                     	endif
(2)  376/   74164 :                     	dc.b	$80,chanid
(2)  377/   74164 :                     	CheckedChannelPointer loc
(2)  378/   74164 :                     	if (chanid&$80)<>0
(2)  379/   74164 :                     		PSGPitchConvert pitch
(2)  380/   74164 :                     	else
(2)  381/   74164 :                     		dc.b	pitch
(2)  382/   74164 :                     	endif
(2)  383/   74164 :                     	dc.b	vol
(2)  384/   74164 :                     	endm
(2)  385/   74164 :                     ; ---------------------------------------------------------------------------
(2)  386/   74164 :                     ; Co-ord Flag Macros and Equates
(2)  387/   74164 :                     ; E0xx - Panning, AMS, FMS
(2)  388/   74164 :                     smpsPan macro direction,amsfms
(2)  389/   74164 :                     panNone set $00
(2)  390/   74164 :                     panRight set $40
(2)  391/   74164 :                     panLeft set $80
(2)  392/   74164 :                     panCentre set $C0
(2)  393/   74164 :                     panCenter set $C0 ; silly Americans :U
(2)  394/   74164 :                     	dc.b $E0,direction+amsfms
(2)  395/   74164 :                     	endm
(2)  396/   74164 :                     
(2)  397/   74164 :                     ; E1xx - Set channel detune to val
(2)  398/   74164 :                     smpsDetune macro val
(2)  399/   74164 :                     	dc.b	$E1,val
(2)  400/   74164 :                     	endm
(2)  401/   74164 :                     
(2)  402/   74164 :                     ; E2xx - Used for setting a variable which can be read by the game, for synchonisation. Ristar does this.
(2)  403/   74164 :                     smpsNop macro val
(2)  404/   74164 :                     	if (SonicDriverVer>=3) && ((val==$FF) || (val==$29))
(2)  405/   74164 :                     		warning "Values $FF and $29 are reserved in S3K's driver; use a different value or remove this command."
(2)  406/   74164 :                     	endif
(2)  407/   74164 :                     	dc.b	$E2,val
(2)  408/   74164 :                     	endm
(2)  409/   74164 :                     
(2)  410/   74164 :                     ; Return (used after smpsCall)
(2)  411/   74164 :                     smpsReturn macro val
(2)  412/   74164 :                     	if SonicDriverVer>=3
(2)  413/   74164 :                     		dc.b	$F9
(2)  414/   74164 :                     	else
(2)  415/   74164 :                     		dc.b	$E3
(2)  416/   74164 :                     	endif
(2)  417/   74164 :                     	endm
(2)  418/   74164 :                     
(2)  419/   74164 :                     ; Fade in previous song (ie. 1-Up)
(2)  420/   74164 :                     smpsFade macro val
(2)  421/   74164 :                     	if SonicDriverVer>=3
(2)  422/   74164 :                     		dc.b	$E2
(2)  423/   74164 :                     		if ("val"<>"")
(2)  424/   74164 :                     			dc.b	val
(2)  425/   74164 :                     		else
(2)  426/   74164 :                     			dc.b	$FF
(2)  427/   74164 :                     		endif
(2)  428/   74164 :                     		if SourceDriver<3
(2)  429/   74164 :                     			smpsStop
(2)  430/   74164 :                     		endif
(2)  431/   74164 :                     	elseif (SourceDriver>=3) && ("val"<>"") && ("val"<>"$FF")
(2)  432/   74164 :                     		; This is actually a communication byte, not a fade.
(2)  433/   74164 :                     		smpsNop	val
(2)  434/   74164 :                     	else
(2)  435/   74164 :                     		dc.b	$E4
(2)  436/   74164 :                     	endif
(2)  437/   74164 :                     	endm
(2)  438/   74164 :                     
(2)  439/   74164 :                     ; E5xx - Set channel tempo divider to xx
(2)  440/   74164 :                     smpsChanTempoDiv macro val
(2)  441/   74164 :                     	if SonicDriverVer>=5
(2)  442/   74164 :                     		; New flag unique to Flamewing's modified S&K driver
(2)  443/   74164 :                     		dc.b	$FF,$08,val
(2)  444/   74164 :                     	elseif SonicDriverVer==3
(2)  445/   74164 :                     		fatal "Coord. Flag to set tempo divider of a single channel does not exist in S3 driver. Use Flamewing's modified S&K sound driver instead."
(2)  446/   74164 :                     	else
(2)  447/   74164 :                     		dc.b	$E5,val
(2)  448/   74164 :                     	endif
(2)  449/   74164 :                     	endm
(2)  450/   74164 :                     
(2)  451/   74164 :                     ; E6xx - Alter Volume by xx
(2)  452/   74164 :                     smpsAlterVol macro val
(2)  453/   74164 :                     	dc.b	$E6,val
(2)  454/   74164 :                     	endm
(2)  455/   74164 :                     
(2)  456/   74164 :                     ; E7 - Prevent attack of next note
(2)  457/   74164 : =$E7                 smpsNoAttack	EQU $E7
(2)  458/   74164 :                     
(2)  459/   74164 :                     ; E8xx - Set note fill to xx
(2)  460/   74164 :                     smpsNoteFill macro val
(2)  461/   74164 :                     	if (SonicDriverVer>=5)&&(SourceDriver<3)
(2)  462/   74164 :                     		; Unique to Flamewing's modified driver
(2)  463/   74164 :                     		dc.b	$FF,$0A,val
(2)  464/   74164 :                     	else
(2)  465/   74164 :                     		if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  466/   74164 :                     			message "Note fill will not work as intended unless you divide the fill value by the tempo divider or complain to Flamewing to add an appropriate coordination flag for it."
(2)  467/   74164 :                     		elseif (SonicDriverVer<3)&&(SourceDriver>=3)
(2)  468/   74164 :                     			message "Note fill will not work as intended unless you multiply the fill value by the tempo divider or complain to Flamewing to add an appropriate coordination flag for it."
(2)  469/   74164 :                     		endif
(2)  470/   74164 :                     		dc.b	$E8,val
(2)  471/   74164 :                     	endif
(2)  472/   74164 :                     	endm
(2)  473/   74164 :                     
