    3673/    506A :                     SSBGData:	macro time,anim,vram,index,flag1,flag2
    3674/    506A :                     		dc.b	(time), (anim), ((vram)*tile_size)>>13
    3675/    506A :                     	if flag1
    3676/    506A :                     		dc.b	(index)|$80|(flag2)
    3677/    506A :                     	else
    3678/    506A :                     		dc.b	(index)*12
    3679/    506A :                     	endif
    3680/    506A :                     		endm
