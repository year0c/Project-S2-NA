   13642/   4142C :                     ; ---------------------------------------------------------------------------
   13643/   4142C :                     ; Leftover symbol tables due to compiler weirdness; these are formatted
   13644/   4142C :                     ; with a Unix ($0A) line break instead of a DOS ($0D0A) line break and it's
   13645/   4142C :                     ; also using big-endian integers, which suggest Sonic 2 wasn't developed in
   13646/   4142C :                     ; DOS (or at least a little-endian environment.)
   13647/   4142C :                     ; in addition, the locations that can be extracted don't even match up with
   13648/   4142C :                     ; the prototype.
   13649/   4142C :                     ;
   13650/   4142C :                     ; Read more about it here:
   13651/   4142C :                     ; https://clownacy.wordpress.com/2022/03/30/everything-that-i-know-about-sonic-the-hedgehogs-source-code/
   13652/   4142C :                     ; https://tcrf.net/Proto:Sonic_the_Hedgehog_2_(Genesis)/Nick_Arcade_Prototype/Symbol_Tables
   13653/   4142C :                     ; ---------------------------------------------------------------------------
   13654/   4142C :                     		binclude	"leftovers/symbols/symbol1.bin"
