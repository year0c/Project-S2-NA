   12572/   1A62E : 0136                		dc.w AnimCue_CPZ_Boss-DynArtCue_Index	; 09
   12573/   1A630 : 0040                		dc.w Dynamic_Null-DynArtCue_Index		; 0A
   12574/   1A632 : 0136                		dc.w AnimCue_CPZ_Boss-DynArtCue_Index	; 0A
   12575/   1A634 : 0040                		dc.w Dynamic_Null-DynArtCue_Index		; 0B
   12576/   1A636 : 0136                		dc.w AnimCue_CPZ_Boss-DynArtCue_Index	; 0B
   12577/   1A638 : 0040                		dc.w Dynamic_Null-DynArtCue_Index		; 0C
   12578/   1A63A : 0136                		dc.w AnimCue_CPZ_Boss-DynArtCue_Index	; 0C
