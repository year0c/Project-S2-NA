   12813/   1A7AC : 6702                		beq.s	loc_1AC28			; if yes, branch
   12814/   1A7AE :                     
   12815/   1A7AE :                     locret_1AC26:
   12816/   1A7AE : 4E75                		rts
   12817/   1A7B0 :                     ; ===========================================================================
   12818/   1A7B0 :                     ; this shifts all blocks of the chunks $EA-$ED and $FA-$FD one block to the
   12819/   1A7B0 :                     ; left and the last block in each row (chunk $ED/$FD) to the beginning
   12820/   1A7B0 :                     ; i.e. rotates the blocks to the left by one
