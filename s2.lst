    6606/    C9A2 : 2628 000C           		move.l	obY(a0),d3			; load y position
    6607/    C9A6 : 3028 0010           		move.w	obVelX(a0),d0			; load x speed
    6608/    C9AA : 48C0                		ext.l	d0
    6609/    C9AC : E180                		asl.l	#8,d0				; shift velocity to line up with the middle 16 bits of the 32-bit position
    6610/    C9AE : D480                		add.l	d0,d2				; add x speed to x position
    6611/    C9B0 : 3028 0012           		move.w	obVelY(a0),d0			; load y speed
    6612/    C9B4 : 0668 0038 0012      		addi.w	#$38,obVelY(a0)			; increase vertical speed (apply gravity)
    6613/    C9BA : 48C0                		ext.l	d0
    6614/    C9BC : E180                		asl.l	#8,d0				; shift velocity to line up with the middle 16 bits of the 32-bit position
    6615/    C9BE : D680                		add.l	d0,d3				; add old y speed to y position
    6616/    C9C0 : 2142 0008           		move.l	d2,obX(a0)			; store new x position
    6617/    C9C4 : 2143 000C           		move.l	d3,obY(a0)			; store new y position
    6618/    C9C8 : 4E75                		rts
    6619/    C9CA :                     ; End of function ObjectMoveAndFall
