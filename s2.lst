(1)  228/    1290 :                     	endif
(1)  229/    1290 :                     	move.w	a1,(VDP_Command_Buffer_Slot).w						; Write next queue slot
(1)  230/    1290 :                     .done:
(1)  231/    1290 :                     	if UseVIntSafeDMA==1
(1)  232/    1290 :                     		move.w	(sp)+,sr										; Restore interrupts to previous state
(1)  233/    1290 :                     	endif ;UseVIntSafeDMA==1
(1)  234/    1290 :                     	endm
