   16509/   7FB88 :                     ; ---------------------------------------------------------------------------
   16510/   7FB88 :                     ; This must be aligned to a bank in order to avoid issues with the DMA.
   16511/   7FB88 :                     ; But because all of the art is placed after the sound driver which already aligns with the bank,
   16512/   7FB88 :                     ; this fixes itself.
   16513/   7FB88 :                     ; The exact location in ROM that this is located at is 0x80000.
   16515/   7FB88 :                     	; Ensure properly art alignment, unnessesary if the DMA bug fix is enabled for 128kb boundaries.
   16516/   7FB88 : (MACRO)              	align $8000
   16516/   7FB88 :  (MACRO-2)                   cnop 0,$8000
   16516/   7FB88 :   (MACRO-3)                          org (*-1+($8000)-((*-1+(-(0)))#($8000)))
   16516/   80000 :                                             !org (*-1+($8000)-((*-1+(-(0)))#($8000)))
   16518/   80000 :                     Art_Sonic:	binclude	"art/uncompressed/Sonic's art.bin"
   16519/   914C0 : (MACRO)              		even
