(1) 2848/   7920C :                     		; Don't let Sega sample cross $8000-byte boundary
(1) 2849/   7920C :                     		; (DAC driver doesn't switch banks automatically)
(1) 2853/   7920C :                     SegaPCM:	include "sound/dac/pcm/generated/sega.inc"
(2)    1/   7920C : =$4074               .sample_rate = 16500
