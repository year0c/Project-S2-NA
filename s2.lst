(2)  814/   74380 :                     
(2)  815/   74380 :                     ; Voices - Detune
(2)  816/   74380 :                     smpsVcDetune macro op1,op2,op3,op4
(2)  817/   74380 :                     	eval vcDT1,op1
(2)  818/   74380 :                     	eval vcDT2,op2
(2)  819/   74380 :                     	eval vcDT3,op3
(2)  820/   74380 :                     	eval vcDT4,op4
(2)  821/   74380 :                     	endm
(2)  822/   74380 :                     
(2)  823/   74380 :                     ; Voices - Coarse-Frequency
(2)  824/   74380 :                     smpsVcCoarseFreq macro op1,op2,op3,op4
(2)  825/   74380 :                     	eval vcCF1,op1
(2)  826/   74380 :                     	eval vcCF2,op2
(2)  827/   74380 :                     	eval vcCF3,op3
(2)  828/   74380 :                     	eval vcCF4,op4
(2)  829/   74380 :                     	endm
(2)  830/   74380 :                     
(2)  831/   74380 :                     ; Voices - Rate Scale
(2)  832/   74380 :                     smpsVcRateScale macro op1,op2,op3,op4
(2)  833/   74380 :                     	eval vcRS1,op1
(2)  834/   74380 :                     	eval vcRS2,op2
(2)  835/   74380 :                     	eval vcRS3,op3
(2)  836/   74380 :                     	eval vcRS4,op4
(2)  837/   74380 :                     	endm
(2)  838/   74380 :                     
(2)  839/   74380 :                     ; Voices - Attack Rate
(2)  840/   74380 :                     smpsVcAttackRate macro op1,op2,op3,op4
(2)  841/   74380 :                     	eval vcAR1,op1
(2)  842/   74380 :                     	eval vcAR2,op2
(2)  843/   74380 :                     	eval vcAR3,op3
(2)  844/   74380 :                     	eval vcAR4,op4
(2)  845/   74380 :                     	endm
(2)  846/   74380 :                     
(2)  847/   74380 :                     ; Voices - Amplitude Modulation
(2)  848/   74380 :                     ; The original SMPS2ASM erroneously assumed the 6th and 7th bits
(2)  849/   74380 :                     ; were the Amplitude Modulation.
(2)  850/   74380 :                     ; According to several docs, however, it's actually the high bit.
(2)  851/   74380 :                     smpsVcAmpMod macro op1,op2,op3,op4
(2)  852/   74380 :                     	if SourceSMPS2ASM==0
(2)  853/   74380 :                     		eval vcAM1,op1<<5
(2)  854/   74380 :                     		eval vcAM2,op2<<5
(2)  855/   74380 :                     		eval vcAM3,op3<<5
(2)  856/   74380 :                     		eval vcAM4,op4<<5
(2)  857/   74380 :                     	else
(2)  858/   74380 :                     		eval vcAM1,op1<<7
(2)  859/   74380 :                     		eval vcAM2,op2<<7
(2)  860/   74380 :                     		eval vcAM3,op3<<7
(2)  861/   74380 :                     		eval vcAM4,op4<<7
(2)  862/   74380 :                     	endif
(2)  863/   74380 :                     	endm
(2)  864/   74380 :                     
(2)  865/   74380 :                     ; Voices - First Decay Rate
(2)  866/   74380 :                     smpsVcDecayRate1 macro op1,op2,op3,op4
(2)  867/   74380 :                     	eval vcD1R1,op1
(2)  868/   74380 :                     	eval vcD1R2,op2
(2)  869/   74380 :                     	eval vcD1R3,op3
(2)  870/   74380 :                     	eval vcD1R4,op4
(2)  871/   74380 :                     	endm
(2)  872/   74380 :                     
(2)  873/   74380 :                     ; Voices - Second Decay Rate
(2)  874/   74380 :                     smpsVcDecayRate2 macro op1,op2,op3,op4
(2)  875/   74380 :                     	eval vcD2R1,op1
(2)  876/   74380 :                     	eval vcD2R2,op2
(2)  877/   74380 :                     	eval vcD2R3,op3
(2)  878/   74380 :                     	eval vcD2R4,op4
(2)  879/   74380 :                     	endm
(2)  880/   74380 :                     
(2)  881/   74380 :                     ; Voices - Decay Level
(2)  882/   74380 :                     smpsVcDecayLevel macro op1,op2,op3,op4
(2)  883/   74380 :                     	eval vcDL1,op1
(2)  884/   74380 :                     	eval vcDL2,op2
(2)  885/   74380 :                     	eval vcDL3,op3
(2)  886/   74380 :                     	eval vcDL4,op4
(2)  887/   74380 :                     	endm
(2)  888/   74380 :                     
(2)  889/   74380 :                     ; Voices - Release Rate
(2)  890/   74380 :                     smpsVcReleaseRate macro op1,op2,op3,op4
(2)  891/   74380 :                     	eval vcRR1,op1
(2)  892/   74380 :                     	eval vcRR2,op2
(2)  893/   74380 :                     	eval vcRR3,op3
(2)  894/   74380 :                     	eval vcRR4,op4
(2)  895/   74380 :                     	endm
(2)  896/   74380 :                     
(2)  897/   74380 :                     smpsNotZ80 function cpu,(cpu<>128)&&(cpu<>32988)
(2)  898/   74380 :                     
(2)  899/   74380 :                     smpsDcb macro
(2)  900/   74380 :                     		if smpsNotZ80(MOMCPU)
(2)  901/   74380 :                     			dc.b ALLARGS
(2)  902/   74380 :                     		else
(2)  903/   74380 :                     			db ALLARGS
(2)  904/   74380 :                     		endif
(2)  905/   74380 :                     	endm
(2)  906/   74380 :                     
(2)  907/   74380 :                     ; Voices - Total Level
(2)  908/   74380 :                     ; The original SMPS2ASM decides TL high bits automatically,
(2)  909/   74380 :                     ; but later versions leave it up to the user.
(2)  910/   74380 :                     ; Alternatively, if we're converting an SMPS 68k song to SMPS Z80,
(2)  911/   74380 :                     ; then we *want* the TL bits to match the algorithm, because SMPS 68k
(2)  912/   74380 :                     ; prefers the algorithm over the TL bits, ignoring the latter, while
(2)  913/   74380 :                     ; SMPS Z80 does the opposite.
(2)  914/   74380 :                     ; Unfortunately, there's nothing we can do if we're trying to convert
(2)  915/   74380 :                     ; an SMPS Z80 song to SMPS 68k. It will ignore the bits no matter
(2)  916/   74380 :                     ; what we do, so we just print a warning.
(2)  917/   74380 :                     smpsVcTotalLevel macro op1,op2,op3,op4
(2)  918/   74380 :                     	eval vcTL1,op1
(2)  919/   74380 :                     	eval vcTL2,op2
(2)  920/   74380 :                     	eval vcTL3,op3
(2)  921/   74380 :                     	eval vcTL4,op4
(2)  922/   74380 :                     	smpsDcb	(vcUnusedBits<<6)+(vcFeedback<<3)+vcAlgorithm
(2)  923/   74380 :                     ;   0     1     2     3     4     5     6     7
(2)  924/   74380 :                     ;%1000,%1000,%1000,%1000,%1010,%1110,%1110,%1111
(2)  925/   74380 :                     	if SourceSMPS2ASM==0
(2)  926/   74380 :                     		eval vcTLMask4,((vcAlgorithm==7)<<7)
(2)  927/   74380 :                     		eval vcTLMask3,((vcAlgorithm>=4)<<7)
(2)  928/   74380 :                     		eval vcTLMask2,((vcAlgorithm>=5)<<7)
(2)  929/   74380 :                     		eval vcTLMask1,128
(2)  930/   74380 :                     	else
(2)  931/   74380 :                     		eval vcTLMask4,0
(2)  932/   74380 :                     		eval vcTLMask3,0
(2)  933/   74380 :                     		eval vcTLMask2,0
(2)  934/   74380 :                     		eval vcTLMask1,0
(2)  935/   74380 :                     	endif
(2)  936/   74380 :                     
(2)  937/   74380 :                     	if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  938/   74380 :                     		eval vcTLMask4,((vcAlgorithm==7)<<7)
(2)  939/   74380 :                     		eval vcTLMask3,((vcAlgorithm>=4)<<7)
(2)  940/   74380 :                     		eval vcTLMask2,((vcAlgorithm>=5)<<7)
(2)  941/   74380 :                     		eval vcTLMask1,128
(2)  942/   74380 :                     		eval vcTL1,vcTL1&127
(2)  943/   74380 :                     		eval vcTL2,vcTL2&127
(2)  944/   74380 :                     		eval vcTL3,vcTL3&127
(2)  945/   74380 :                     		eval vcTL4,vcTL4&127
(2)  946/   74380 :                     	elseif (SonicDriverVer<3)&&(SourceDriver>=3)&&((((vcTL1|vcTLMask1)&128)<>128)||(((vcTL2|vcTLMask2)&128)<>((vcAlgorithm>=5)<<7))||(((vcTL3|vcTLMask3)&128)<>((vcAlgorithm>=4)<<7))||(((vcTL4|vcTLMask4)&128)<>((vcAlgorithm==7)<<7)))
(2)  947/   74380 :                     		if MOMPASS=1
(2)  948/   74380 :                     			message "Voice at 0x\{*} has TL bits that do not match its algorithm setting. This voice will not work in S1/S2 drivers."
(2)  949/   74380 :                     		endif
(2)  950/   74380 :                     	endif
(2)  951/   74380 :                     
(2)  952/   74380 :                     	if SonicDriverVer==2
(2)  953/   74380 :                     		smpsDcb	(vcDT4<<4)+vcCF4       ,(vcDT2<<4)+vcCF2       ,(vcDT3<<4)+vcCF3       ,(vcDT1<<4)+vcCF1
(2)  954/   74380 :                     		smpsDcb	(vcRS4<<6)+vcAR4       ,(vcRS2<<6)+vcAR2       ,(vcRS3<<6)+vcAR3       ,(vcRS1<<6)+vcAR1
(2)  955/   74380 :                     		smpsDcb	vcAM4|vcD1R4|vcD1R4Unk ,vcAM2|vcD1R2|vcD1R2Unk ,vcAM3|vcD1R3|vcD1R3Unk ,vcAM1|vcD1R1|vcD1R1Unk
(2)  956/   74380 :                     		smpsDcb	vcD2R4                 ,vcD2R2                 ,vcD2R3                 ,vcD2R1
(2)  957/   74380 :                     		smpsDcb	(vcDL4<<4)+vcRR4       ,(vcDL2<<4)+vcRR2       ,(vcDL3<<4)+vcRR3       ,(vcDL1<<4)+vcRR1
(2)  958/   74380 :                     		smpsDcb	vcTL4|vcTLMask4        ,vcTL2|vcTLMask2        ,vcTL3|vcTLMask3        ,vcTL1|vcTLMask1
(2)  959/   74380 :                     	else
(2)  960/   74380 :                     		smpsDcb	(vcDT4<<4)+vcCF4       ,(vcDT3<<4)+vcCF3       ,(vcDT2<<4)+vcCF2       ,(vcDT1<<4)+vcCF1
(2)  961/   74380 :                     		smpsDcb	(vcRS4<<6)+vcAR4       ,(vcRS3<<6)+vcAR3       ,(vcRS2<<6)+vcAR2       ,(vcRS1<<6)+vcAR1
(2)  962/   74380 :                     		smpsDcb	vcAM4|vcD1R4|vcD1R4Unk ,vcAM3|vcD1R3|vcD1R3Unk ,vcAM2|vcD1R2|vcD1R2Unk ,vcAM1|vcD1R1|vcD1R1Unk
(2)  963/   74380 :                     		smpsDcb	vcD2R4                 ,vcD2R3                 ,vcD2R2                 ,vcD2R1
(2)  964/   74380 :                     		smpsDcb	(vcDL4<<4)+vcRR4       ,(vcDL3<<4)+vcRR3       ,(vcDL2<<4)+vcRR2       ,(vcDL1<<4)+vcRR1
(2)  965/   74380 :                     		smpsDcb	vcTL4|vcTLMask4        ,vcTL3|vcTLMask3        ,vcTL2|vcTLMask2        ,vcTL1|vcTLMask1
(2)  966/   74380 :                     	endif
(2)  967/   74380 :                     	endm
