(1)  195/    128C :                     ; Expects source address and DMA length in bytes. Also, expects source, size, and dest to be known
(1)  196/    128C :                     ; at assembly time. Gives errors if DMA starts at an odd address, transfers
(1)  197/    128C :                     ; crosses a 128kB boundary, or has size 0.
(1)  198/    128C :                     QueueStaticDMA macro src,length,dest
(1)  199/    128C :                     	if MOMPASS>1
(1)  200/    128C :                     		if ((src)&1)<>0
(1)  201/    128C :                     			fatal "DMA queued from odd source $\{src}!"
(1)  202/    128C :                     		endif
(1)  203/    128C :                     		if ((length)&1)<>0
(1)  204/    128C :                     			fatal "DMA an odd number of bytes $\{length}!"
(1)  205/    128C :                     		endif
(1)  206/    128C :                     		if (length)==0
(1)  207/    128C :                     			fatal "DMA transferring 0 bytes (becomes a 128kB transfer). If you really mean it, pass 128kB instead."
(1)  208/    128C :                     		endif
(1)  209/    128C :                     		if (((src)+(length)-1)>>17)<>((src)>>17)
(1)  210/    128C :                     			fatal "DMA crosses a 128kB boundary. You should either split the DMA manually or align the source adequately."
(1)  211/    128C :                     		endif
(1)  212/    128C :                     	endif
