   16496/   7FB84 : (MACRO)              		even
   16497/   7FB84 :                     
   16498/   7FB84 :                     ; ---------------------------------------------------------------------------
   16499/   7FB84 :                     ; Uncompressed graphics - Sonic and Tails
   16500/   7FB84 :                     ; ---------------------------------------------------------------------------
   16501/   7FB84 :                     ; This must be aligned to a bank in order to avoid issues with the DMA.
   16502/   7FB84 :                     ; But because all of the art is placed after the sound driver which already aligns with the bank,
   16503/   7FB84 :                     ; this fixes itself.
   16504/   7FB84 :                     ; The exact location in ROM that this is located at is 0x80000.
   16506/   7FB84 :                     	; Ensure properly art alignment, unnessesary if the DMA bug fix is enabled for 128kb boundaries.
   16507/   7FB84 : (MACRO)              	align $8000
   16507/   7FB84 :  (MACRO-2)                   cnop 0,$8000
   16507/   7FB84 :   (MACRO-3)                          org (*-1+($8000)-((*-1+(-(0)))#($8000)))
   16507/   80000 :                                             !org (*-1+($8000)-((*-1+(-(0)))#($8000)))
   16509/   80000 :                     Art_Sonic:	binclude	"art/uncompressed/Sonic's art.bin"
   16510/   914C0 : (MACRO)              		even
