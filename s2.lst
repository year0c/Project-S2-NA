(1)    1/   1C056 :                     ; ---------------------------------------------------------------------------
(1)    2/   1C056 :                     ; "MAIN LEVEL LOAD BLOCK" (after Nemesis)
(1)    3/   1C056 :                     ;
(1)    4/   1C056 :                     ; This struct array tells the engine where to find all the art associated with
(1)    5/   1C056 :                     ; a particular zone. Each zone gets four longwords, in which it stores four
(1)    6/   1C056 :                     ; pointers (in the lower 24 bits) and three jump table indeces (in the upper eight
(1)    7/   1C056 :                     ; bits). The assembled data looks something like this:
(1)    8/   1C056 :                     ;
(1)    9/   1C056 :                     ; aaBBBBBB
(1)   10/   1C056 :                     ; ccDDDDDD
(1)   11/   1C056 :                     ; EEEEEE
(1)   12/   1C056 :                     ; ffgghhii
(1)   13/   1C056 :                     ;
(1)   14/   1C056 :                     ; aa = index for primary pattern load request list
(1)   15/   1C056 :                     ; BBBBBB = unused, pointer to level art
(1)   16/   1C056 :                     ; cc = index for secondary pattern load request list
(1)   17/   1C056 :                     ; DDDDDD = pointer to 16x16 block mappings
(1)   18/   1C056 :                     ; EEEEEE = pointer to 128x128 block mappings
(1)   19/   1C056 :                     ; ff = unused, always 0
(1)   20/   1C056 :                     ; gg = unused, music track
(1)   21/   1C056 :                     ; hh = unused, palette
(1)   22/   1C056 :                     ; ii = palette
(1)   23/   1C056 :                     ;
(1)   24/   1C056 :                     ; Nemesis refers to this as the "main level load block". However, that name implies
(1)   25/   1C056 :                     ; that this is code (obviously, it isn't), or at least that it points to the level's
(1)   26/   1C056 :                     ; collision, object and ring placement arrays (it only points to palettes and 16x16
(1)   27/   1C056 :                     ; mappings although the 128x128 mappings do affect the actual level layout and collision)
(1)   28/   1C056 :                     ; ---------------------------------------------------------------------------
(1)   29/   1C056 :                     
(1)   30/   1C056 :                     ; MainLoadBlocks:
(1)   31/   1C056 :                     LevelArtPointers_PB:
(1)   32/   1C056 :                     		;	Nem_GHZ,Map16_GHZ,Map128_GHZ
