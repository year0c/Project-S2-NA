    6568/    C94C :                     ; sub_CB44:
    6569/    C94C :                     RunObject:
    6570/    C94C : 1010                		move.b	obID(a0),d0			; get the object's ID
    6571/    C94E : 670C                		beq.s	loc_CB54			; if it's obj00, skip it
    6572/    C950 : D040                		add.w	d0,d0
    6573/    C952 : D040                		add.w	d0,d0				; d0 = object ID * 4
    6574/    C954 : 227B 002C           		movea.l	Obj_Index-4(pc,d0.w),a1		; load the address of the object's code
    6575/    C958 : 4E91                		jsr	(a1)				; dynamic call! to one of the the entries in Obj_Index
    6576/    C95A : 7000                		moveq	#0,d0
    6577/    C95C :                     
    6578/    C95C :                     loc_CB54:
    6579/    C95C : 41E8 0040           		lea	object_size(a0),a0		; load obj address
    6580/    C960 : 51CF FFEA           		dbf	d7,RunObject
    6581/    C964 : 4E75                		rts
    6582/    C966 :                     ; ---------------------------------------------------------------------------
    6583/    C966 :                     ; this skips certain objects to make enemies and things pause when Sonic dies
