(2)   33/   74380 : =$87..$8D            	nextenum	nFs0,nGb0=nFs0,nG0,nGs0,nAb0=nGs0,nA0,nAs0,nBb0=nAs0,nB0,nCb1=nB0,nBs0
(2)   34/   74380 : =$8D..$92            	nextenum	nC1=nBs0,nCs1,nDb1=nCs1,nD1,nDs1,nEb1=nDs1,nE1,nFb1=nE1,nEs1,nF1=nEs1
(2)   35/   74380 : =$93..$99            	nextenum	nFs1,nGb1=nFs1,nG1,nGs1,nAb1=nGs1,nA1,nAs1,nBb1=nAs1,nB1,nCb2=nB1,nBs1
(2)   36/   74380 : =$99..$9E            	nextenum	nC2=nBs1,nCs2,nDb2=nCs2,nD2,nDs2,nEb2=nDs2,nE2,nFb2=nE2,nEs2,nF2=nEs2
(2)   37/   74380 : =$9F..$A5            	nextenum	nFs2,nGb2=nFs2,nG2,nGs2,nAb2=nGs2,nA2,nAs2,nBb2=nAs2,nB2,nCb3=nB2,nBs2
(2)   38/   74380 : =$A5..$AA            	nextenum	nC3=nBs2,nCs3,nDb3=nCs3,nD3,nDs3,nEb3=nDs3,nE3,nFb3=nE3,nEs3,nF3=nEs3
(2)   39/   74380 : =$AB..$B1            	nextenum	nFs3,nGb3=nFs3,nG3,nGs3,nAb3=nGs3,nA3,nAs3,nBb3=nAs3,nB3,nCb4=nB3,nBs3
(2)   40/   74380 : =$B1..$B6            	nextenum	nC4=nBs3,nCs4,nDb4=nCs4,nD4,nDs4,nEb4=nDs4,nE4,nFb4=nE4,nEs4,nF4=nEs4
(2)   41/   74380 : =$B7..$BD            	nextenum	nFs4,nGb4=nFs4,nG4,nGs4,nAb4=nGs4,nA4,nAs4,nBb4=nAs4,nB4,nCb5=nB4,nBs4
(2)   42/   74380 : =$BD..$C2            	nextenum	nC5=nBs4,nCs5,nDb5=nCs5,nD5,nDs5,nEb5=nDs5,nE5,nFb5=nE5,nEs5,nF5=nEs5
(2)   43/   74380 : =$C3..$C9            	nextenum	nFs5,nGb5=nFs5,nG5,nGs5,nAb5=nGs5,nA5,nAs5,nBb5=nAs5,nB5,nCb6=nB5,nBs5
(2)   44/   74380 : =$C9..$CE            	nextenum	nC6=nBs5,nCs6,nDb6=nCs6,nD6,nDs6,nEb6=nDs6,nE6,nFb6=nE6,nEs6,nF6=nEs6
(2)   45/   74380 : =$CF..$D5            	nextenum	nFs6,nGb6=nFs6,nG6,nGs6,nAb6=nGs6,nA6,nAs6,nBb6=nAs6,nB6,nCb7=nB6,nBs6
(2)   46/   74380 : =$D5..$DA            	nextenum	nC7=nBs6,nCs7,nDb7=nCs7,nD7,nDs7,nEb7=nDs7,nE7,nFb7=nE7,nEs7,nF7=nEs7
(2)   47/   74380 : =$DB..$DF            	nextenum	nFs7,nGb7=nFs7,nG7,nGs7,nAb7=nGs7,nA7,nAs7,nBb7=nAs7
(2)   48/   74380 :                     ; SMPS2ASM uses nMaxPSG for songs from S1/S2 drivers.
(2)   49/   74380 :                     ; nMaxPSG1 and nMaxPSG2 are used only for songs from S3/S&K/S3D drivers.
(2)   50/   74380 :                     ; The use of psgdelta is intended to undo the effects of PSGPitchConvert
(2)   51/   74380 :                     ; and ensure that the ending note is indeed the maximum PSG frequency.
(2)   53/   74380 : =$C6                 nMaxPSG				EQU nA5
(2)   54/   74380 : =$D2                 nMaxPSG1			EQU nA5+psgdelta
(2)   55/   74380 : =$D2                 nMaxPSG2			EQU nA5+psgdelta
(2)   61/   74380 :                     ; ---------------------------------------------------------------------------
(2)   62/   74380 :                     ; PSG volume envelope equates
(2)   65/   74380 : =$1..$6              			enum		fTone_01=$01,fTone_02,fTone_03,fTone_04,fTone_05,fTone_06
(2)   66/   74380 : =$7..$9              			nextenum	fTone_07,fTone_08,fTone_09
(2)   86/   74380 :                     ; ---------------------------------------------------------------------------
(2)   87/   74380 :                     ; DAC Equates
(2)   90/   74380 : =$81..$83            			enum		dKick=$81,dSnare,dTimpani
(2)   91/   74380 : =$88..$8B            			enum		dHiTimpani=$88,dMidTimpani,dLowTimpani,dVLowTimpani
(2)  169/   74380 :                     ; ---------------------------------------------------------------------------
(2)  170/   74380 :                     ; Channel IDs for SFX
(2)  171/   74380 : =$80                 cPSG1				EQU $80
(2)  172/   74380 : =$A0                 cPSG2				EQU $A0
(2)  173/   74380 : =$C0                 cPSG3				EQU $C0
(2)  174/   74380 : =$E0                 cNoise				EQU $E0	; Not for use in S3/S&K/S3D
(2)  175/   74380 : =$2                  cFM3				EQU $02
(2)  176/   74380 : =$4                  cFM4				EQU $04
(2)  177/   74380 : =$5                  cFM5				EQU $05
(2)  178/   74380 : =$6                  cFM6				EQU $06	; Only in S3/S&K/S3D, overrides DAC
(2)  179/   74380 :                     ; ---------------------------------------------------------------------------
(2)  180/   74380 :                     ; Conversion macros and functions
(2)  181/   74380 :                     
(2)  182/   74380 :                     conv0To256  function n,((n==0)<<8)|n
(2)  183/   74380 :                     s2TempotoS1 function n,(((768-n)>>1)/(256-n))&$FF
(2)  184/   74380 :                     s2TempotoS3 function n,($100-((n==0)|n))&$FF
(2)  185/   74380 :                     s1TempotoS2 function n,((((conv0To256(n)-1)<<8)+(conv0To256(n)>>1))/conv0To256(n))&$FF
(2)  186/   74380 :                     s1TempotoS3 function n,s2TempotoS3(s1TempotoS2(n))
(2)  187/   74380 :                     s3TempotoS1 function n,s2TempotoS1(s2TempotoS3(n))
(2)  188/   74380 :                     s3TempotoS2 function n,s2TempotoS3(n)
(2)  189/   74380 :                     
(2)  190/   74380 :                     convertMainTempoMod macro mod
(2)  191/   74380 :                     	if ((SourceDriver>=3)&&(SonicDriverVer>=3))||(SonicDriverVer==SourceDriver)
(2)  192/   74380 :                     		dc.b	mod
(2)  193/   74380 :                     	elseif SourceDriver==1
(2)  194/   74380 :                     		if mod==1
(2)  195/   74380 :                     			fatal "Invalid main tempo of 1 in song from Sonic 1"
(2)  196/   74380 :                     		endif
(2)  197/   74380 :                     		if SonicDriverVer==2
(2)  198/   74380 :                     			dc.b	s1TempotoS2(mod)
(2)  199/   74380 :                     		else;if SonicDriverVer>=3
(2)  200/   74380 :                     			dc.b	s1TempotoS3(mod)
(2)  201/   74380 :                     		endif
(2)  202/   74380 :                     	elseif SourceDriver==2
(2)  203/   74380 :                     		if mod==0
(2)  204/   74380 :                     			fatal "Invalid main tempo of 0 in song from Sonic 2"
(2)  205/   74380 :                     		endif
(2)  206/   74380 :                     		if SonicDriverVer==1
(2)  207/   74380 :                     			dc.b	s2TempotoS1(mod)
(2)  208/   74380 :                     		else;if SonicDriverVer>=3
(2)  209/   74380 :                     			dc.b	s2TempotoS3(mod)
(2)  210/   74380 :                     		endif
(2)  211/   74380 :                     	else;if SourceDriver>=3
(2)  212/   74380 :                     		if mod==0
(2)  213/   74380 :                     			message "Performing approximate conversion of Sonic 3 main tempo modifier of 0"
(2)  214/   74380 :                     		endif
(2)  215/   74380 :                     		if SonicDriverVer==1
(2)  216/   74380 :                     			dc.b	s3TempotoS1(mod)
(2)  217/   74380 :                     		else;if SonicDriverVer==2
(2)  218/   74380 :                     			dc.b	s3TempotoS2(mod)
(2)  219/   74380 :                     		endif
(2)  220/   74380 :                     	endif
(2)  221/   74380 :                     	endm
(2)  222/   74380 :                     
(2)  223/   74380 :                     ; PSG conversion to S3/S&K/S3D drivers require a tone shift of 12 semi-tones.
(2)  224/   74380 :                     PSGPitchConvert macro pitch
(2)  225/   74380 :                     	if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  226/   74380 :                     		dc.b	(pitch+psgdelta)&$FF
(2)  227/   74380 :                     	elseif (SonicDriverVer<3)&&(SourceDriver>=3)
(2)  228/   74380 :                     		dc.b	(pitch-psgdelta)&$FF
(2)  229/   74380 :                     	else
(2)  230/   74380 :                     		dc.b	pitch
(2)  231/   74380 :                     	endif
(2)  232/   74380 :                     	endm
(2)  233/   74380 :                     
(2)  234/   74380 :                     CheckedChannelPointer macro loc
(2)  235/   74380 :                     	if SonicDriverVer<>1
(2)  236/   74380 :                     		dc.w	z80_ptr(loc)
(2)  237/   74380 :                     	else
(2)  238/   74380 :                     		if (MOMPASS=1)&&(DEFINED(loc))
(2)  239/   74380 :                     			fatal "Tracks for Sonic 1 songs must come after the start of the song"
(2)  240/   74380 :                     		endif
(2)  241/   74380 :                     		dc.w	loc-songStart
(2)  242/   74380 :                     	endif
(2)  243/   74380 :                     	endm
(2)  244/   74380 :                     ; ---------------------------------------------------------------------------
(2)  245/   74380 :                     ; Header Macros
(2)  246/   74380 :                     smpsHeaderStartSong macro ver, sourcesmps2asmver
(2)  247/   74380 :                     
(2)  248/   74380 :                     SourceDriver set ver
(2)  249/   74380 :                     
(2)  250/   74380 :                     	if ("sourcesmps2asmver"<>"")
(2)  251/   74380 :                     		set SourceSMPS2ASM,sourcesmps2asmver
(2)  252/   74380 :                     	else
(2)  253/   74380 :                     		set SourceSMPS2ASM,0
(2)  254/   74380 :                     	endif
(2)  255/   74380 :                     
(2)  256/   74380 :                     songStart set *
(2)  257/   74380 :                     
(2)  258/   74380 :                     	if MOMPASS=1
(2)  259/   74380 :                     		if SMPS2ASMVer < SourceSMPS2ASM
(2)  260/   74380 :                     			message "Song at 0x\{songStart} was made for a newer version of SMPS2ASM (this is version \{SMPS2ASMVer}, but song wants at least version \{SourceSMPS2ASM})."
(2)  261/   74380 :                     		endif
(2)  262/   74380 :                     	endif
(2)  263/   74380 :                     
(2)  264/   74380 :                     	endm
(2)  265/   74380 :                     
(2)  266/   74380 :                     smpsHeaderVoiceNull macro
(2)  267/   74380 :                     	if songStart<>*
(2)  268/   74380 :                     		fatal "Missing smpsHeaderStartSong"
(2)  269/   74380 :                     	endif
(2)  270/   74380 :                     	dc.w	$0000
(2)  271/   74380 :                     	endm
(2)  272/   74380 :                     
(2)  273/   74380 :                     ; Header - Set up Voice Location
(2)  274/   74380 :                     ; Common to music and SFX
(2)  275/   74380 :                     smpsHeaderVoice macro loc
(2)  276/   74380 :                     	if songStart<>*
(2)  277/   74380 :                     		fatal "Missing smpsHeaderStartSong"
(2)  278/   74380 :                     	endif
(2)  279/   74380 :                     	if SonicDriverVer<>1
(2)  280/   74380 :                     		dc.w	z80_ptr(loc)
(2)  281/   74380 :                     	else
(2)  282/   74380 :                     		if (MOMPASS=1)&&(DEFINED(loc))
(2)  283/   74380 :                     			fatal "Voice banks for Sonic 1 songs must come after the start of the song"
(2)  284/   74380 :                     		endif
(2)  285/   74380 :                     		dc.w	loc-songStart
(2)  286/   74380 :                     	endif
(2)  287/   74380 :                     	endm
(2)  288/   74380 :                     
(2)  289/   74380 :                     ; Header - Set up Voice Location as S3's Universal Voice Bank
(2)  290/   74380 :                     ; Common to music and SFX
(2)  291/   74380 :                     smpsHeaderVoiceUVB macro
(2)  292/   74380 :                     	if songStart<>*
(2)  293/   74380 :                     		fatal "Missing smpsHeaderStartSong"
(2)  294/   74380 :                     	endif
(2)  295/   74380 :                     	if SonicDriverVer>=5
(2)  296/   74380 :                     		dc.w	z80_ptr(z80_UniVoiceBank)
(2)  297/   74380 :                     	elseif SonicDriverVer>=3
(2)  298/   74380 :                     		dc.w	little_endian(z80_UniVoiceBank)
(2)  299/   74380 :                     	else
(2)  300/   74380 :                     		fatal "Universal Voice Bank does not exist in Sonic 1 or Sonic 2 drivers"
(2)  301/   74380 :                     	endif
(2)  302/   74380 :                     	endm
(2)  303/   74380 :                     
(2)  304/   74380 :                     ; Header macros for music (not for SFX)
(2)  305/   74380 :                     ; Header - Set up Channel Usage
(2)  306/   74380 :                     smpsHeaderChan macro fm,psg
(2)  307/   74380 :                     	dc.b	fm,psg
(2)  308/   74380 :                     	endm
(2)  309/   74380 :                     
(2)  310/   74380 :                     ; Header - Set up Tempo
(2)  311/   74380 :                     smpsHeaderTempo macro div,mod
(2)  312/   74380 :                     	dc.b	div
(2)  313/   74380 :                     	convertMainTempoMod mod
(2)  314/   74380 :                     	endm
(2)  315/   74380 :                     
(2)  316/   74380 :                     ; Header - Set up DAC Channel
(2)  317/   74380 :                     smpsHeaderDAC macro loc,pitch,vol
(2)  318/   74380 :                     	CheckedChannelPointer loc
(2)  319/   74380 :                     	if ("pitch"<>"")
(2)  320/   74380 :                     		dc.b	pitch
(2)  321/   74380 :                     		if ("vol"<>"")
(2)  322/   74380 :                     			dc.b	vol
(2)  323/   74380 :                     		else
(2)  324/   74380 :                     			dc.b	$00
(2)  325/   74380 :                     		endif
(2)  326/   74380 :                     	else
(2)  327/   74380 :                     		dc.w	$00
(2)  328/   74380 :                     	endif
(2)  329/   74380 :                     	endm
(2)  330/   74380 :                     
(2)  331/   74380 :                     ; Header - Set up FM Channel
(2)  332/   74380 :                     smpsHeaderFM macro loc,pitch,vol
(2)  333/   74380 :                     	CheckedChannelPointer loc
(2)  334/   74380 :                     	dc.b	pitch,vol
(2)  335/   74380 :                     	endm
(2)  336/   74380 :                     
(2)  337/   74380 :                     ; Header - Set up PSG Channel
(2)  338/   74380 :                     smpsHeaderPSG macro loc,pitch,vol,mod,voice
