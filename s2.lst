    6442/    C772 : 0001 5058                   dc.l    Obj04
    6443/    C776 : (MACRO)              id_Obj05:	objptr	Obj05				; Tails' tails
    6443/    C776 : =$5                  id_Obj05: = ((*-Obj_Index)/4)+1
    6443/    C776 : 0001 1904                   dc.l    Obj05
    6444/    C77A : (MACRO)              id_Obj06:	objptr	Obj06				; Twisting spiral pathway in EHZ
