    1937/    28A6 :                     ; Subroutine to calculate sine and cosine of an angle
    1938/    28A6 :                     ; d0 = input byte = angle (360 degrees == 256)
    1939/    28A6 :                     ; d0 = output word = 255 * sine(angle)
    1940/    28A6 :                     ; d1 = output word = 255 * cosine(angle)
    1941/    28A6 :                     ; ---------------------------------------------------------------------------
    1942/    28A6 :                     
    1943/    28A6 :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
