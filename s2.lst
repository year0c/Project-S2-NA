(2)  795/   74380 :                     ; Voices - Algorithm
(2)  796/   74380 :                     smpsVcAlgorithm macro val
(2)  797/   74380 :                     vcAlgorithm eval val
(2)  798/   74380 :                     	endm
(2)  799/   74380 :                     
(2)  800/   74380 :                     smpsVcUnusedBits macro val,d1r1,d1r2,d1r3,d1r4
(2)  801/   74380 :                     vcUnusedBits eval val
(2)  802/   74380 :                     	if ("d1r1"<>"")&&("d1r2"<>"")&&("d1r3"<>"")&&("d1r4"<>"")
(2)  803/   74380 :                     		eval vcD1R1Unk,d1r1<<5
(2)  804/   74380 :                     		eval vcD1R2Unk,d1r2<<5
(2)  805/   74380 :                     		eval vcD1R3Unk,d1r3<<5
(2)  806/   74380 :                     		eval vcD1R4Unk,d1r4<<5
(2)  807/   74380 :                     	else
