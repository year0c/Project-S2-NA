     959/    1270 :                     ; Subroutine to transfer a plane map to VRAM
     960/    1270 :                     ; ---------------------------------------------------------------------------
     961/    1270 :                     
     962/    1270 :                     ; control register:
     963/    1270 :                     ;    CD1 CD0 A13 A12 A11 A10 A09 A08     (D31-D24)
     964/    1270 :                     ;    A07 A06 A05 A04 A03 A02 A01 A00     (D23-D16)
     965/    1270 :                     ;     ?   ?   ?   ?   ?   ?   ?   ?      (D15-D8)
     966/    1270 :                     ;    CD5 CD4 CD3 CD2  ?   ?  A15 A14     (D7-D0)
     967/    1270 :                     ;
     968/    1270 :                     ;	A00-A15 - address
     969/    1270 :                     ;	CD0-CD3 - code
     970/    1270 :                     ;	CD4 - 1 if VRAM copy DMA mode. 0 otherwise.
     971/    1270 :                     ;	CD5 - DMA operation
     972/    1270 :                     ;
     973/    1270 :                     ;	Bits CD3-CD0:
     974/    1270 :                     ;	0000 - VRAM read
     975/    1270 :                     ;	0001 - VRAM write
     976/    1270 :                     ;	0011 - CRAM write
     977/    1270 :                     ;	0100 - VSRAM read
     978/    1270 :                     ;	0101 - VSRAM write
     979/    1270 :                     ;	1000 - CRAM read
     980/    1270 :                     ;
     981/    1270 :                     ; d0 = control register
     982/    1270 :                     ; d1 = width
     983/    1270 :                     ; d2 = heigth
     984/    1270 :                     ; a1 = source address
     985/    1270 :                     
     986/    1270 :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
     987/    1270 :                     
     988/    1270 :                     ; ShowVDPGraphics: PlaneMapToVRAM:
     989/    1270 :                     PlaneMapToVRAM_H40:
     990/    1270 : 4DF9 00C0 0000      		lea	(vdp_data_port).l,a6
     991/    1276 : 283C 0080 0000      		move.l	#$800000,d4
     992/    127C :                     
     993/    127C :                     PlaneMapToVRAM_H40_LineLoop:
     994/    127C : 2D40 0004           		move.l	d0,4(a6)
     995/    1280 : 3601                		move.w	d1,d3
     996/    1282 :                     
     997/    1282 :                     PlaneMapToVRAM_H40_TileLoop:
     998/    1282 : 3C99                		move.w	(a1)+,(a6)
     999/    1284 : 51CB FFFC           		dbf	d3,PlaneMapToVRAM_H40_TileLoop
    1000/    1288 : D084                		add.l	d4,d0
    1001/    128A : 51CA FFF0           		dbf	d2,PlaneMapToVRAM_H40_LineLoop
    1002/    128E : 4E75                		rts
