    2123/    2AC6 :                     ; Subroutine to calculate sine and cosine of an angle
    2124/    2AC6 :                     ; d0 = input byte = angle (360 degrees == 256)
    2125/    2AC6 :                     ; d0 = output word = 255 * sine(angle)
    2126/    2AC6 :                     ; d1 = output word = 255 * cosine(angle)
    2127/    2AC6 :                     ; ---------------------------------------------------------------------------
    2128/    2AC6 :                     
    2129/    2AC6 :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
