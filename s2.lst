(1)   30/       0 : =$E2682              DEBUGGER__EXTENSIONS__BTN_B_DEBUGGER:	equ		MDDBG__Debugger_Backtrace			; display exception backtrace
(1)   31/       0 : =$0                  DEBUGGER__EXTENSIONS__BTN_C_DEBUGGER:	equ		0		; disabled
