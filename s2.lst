(2)  761/   74380 :                     		smpsFMICommand $88,$0F
(2)  762/   74380 :                     		smpsFMICommand $8C,$0F
(2)  763/   74380 :                     	else
(2)  764/   74380 :                     		dc.b	$F9
(2)  765/   74380 :                     	endif
(2)  766/   74380 :                     	endm
