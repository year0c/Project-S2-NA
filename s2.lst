    6557/    C940 : 7E7F                		moveq	#bytesToXcnt(v_objend-v_objspace,object_size),d7	; run the first $80 objects out of levels
    6558/    C942 : 7000                		moveq	#0,d0
    6559/    C944 : 0C38 0006 C124      		cmpi.b	#6,(v_player+obRoutine).w	; is Sonic dead?
