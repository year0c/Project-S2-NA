(2)  583/   74164 :                     
(2)  584/   74164 :                     ; F3xx - PSG waveform to xx
(2)  585/   74164 :                     smpsPSGform macro form
(2)  586/   74164 :                     	dc.b	$F3,form
(2)  587/   74164 :                     	endm
(2)  588/   74164 :                     
(2)  589/   74164 :                     ; Turn off Modulation
(2)  590/   74164 :                     smpsModOff macro
(2)  591/   74164 :                     	if SonicDriverVer>=3
(2)  592/   74164 :                     		dc.b	$FA
(2)  593/   74164 :                     	else
(2)  594/   74164 :                     		dc.b	$F4
(2)  595/   74164 :                     	endif
(2)  596/   74164 :                     	endm
(2)  597/   74164 :                     
(2)  598/   74164 :                     ; F5xx - PSG voice to xx
(2)  599/   74164 :                     smpsPSGvoice macro voice
(2)  600/   74164 :                     	dc.b	$F5,voice
(2)  601/   74164 :                     	endm
(2)  602/   74164 :                     
(2)  603/   74164 :                     ; F6xxxx - Jump to xxxx
(2)  604/   74164 :                     smpsJump macro loc
(2)  605/   74164 :                     	dc.b	$F6
(2)  606/   74164 :                     	if SonicDriverVer<>1
(2)  607/   74164 :                     		dc.w	z80_ptr(loc)
(2)  608/   74164 :                     	else
(2)  609/   74164 :                     		dc.w	loc-*-1
(2)  610/   74164 :                     	endif
(2)  611/   74164 :                     	endm
(2)  612/   74164 :                     
(2)  613/   74164 :                     ; F7xxyyzzzz - Loop back to zzzz yy times, xx being the loop index for loop recursion fixing
(2)  614/   74164 :                     smpsLoop macro index,loops,loc
(2)  615/   74164 :                     	dc.b	$F7
(2)  616/   74164 :                     	dc.b	index,loops
(2)  617/   74164 :                     	if SonicDriverVer<>1
(2)  618/   74164 :                     		dc.w	z80_ptr(loc)
(2)  619/   74164 :                     	else
(2)  620/   74164 :                     		dc.w	loc-*-1
(2)  621/   74164 :                     	endif
(2)  622/   74164 :                     	endm
(2)  623/   74164 :                     
(2)  624/   74164 :                     ; F8xxxx - Call pattern at xxxx, saving return point
(2)  625/   74164 :                     smpsCall macro loc
(2)  626/   74164 :                     	dc.b	$F8
(2)  627/   74164 :                     	if SonicDriverVer<>1
(2)  628/   74164 :                     		dc.w	z80_ptr(loc)
(2)  629/   74164 :                     	else
(2)  630/   74164 :                     		dc.w	loc-*-1
(2)  631/   74164 :                     	endif
(2)  632/   74164 :                     	endm
(2)  633/   74164 :                     ; ---------------------------------------------------------------------------
(2)  634/   74164 :                     ; Alter Volume
(2)  635/   74164 :                     smpsFMAlterVol macro val1,val2
(2)  636/   74164 :                     	if ("val2"<>"")
(2)  637/   74164 :                     		; S3K's nerfed 'PSG & FM volume' command with broken PSG support.
(2)  638/   74164 :                     		; The first value is completely unused, while the second is for FM tracks.
(2)  639/   74164 :                     		if (SonicDriverVer>=3)
(2)  640/   74164 :                     			dc.b	$E5,val1,val2
(2)  641/   74164 :                     		else
(2)  642/   74164 :                     			dc.b	$E6,val2
(2)  643/   74164 :                     		endif
(2)  644/   74164 :                     	else
(2)  645/   74164 :                     		; Normal, sane command.
(2)  646/   74164 :                     		dc.b	$E6,val1
(2)  647/   74164 :                     	endif
(2)  648/   74164 :                     	endm
