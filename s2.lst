    3850/    5286 :                     SSBGData:	macro time,anim,vram,index,flag1,flag2
    3851/    5286 :                     		dc.b	(time), (anim), ((vram)*tile_size)>>13
    3852/    5286 :                     	if flag1
    3853/    5286 :                     		dc.b	(index)|$80|(flag2)
    3854/    5286 :                     	else
    3855/    5286 :                     		dc.b	(index)*12
    3856/    5286 :                     	endif
    3857/    5286 :                     		endm
