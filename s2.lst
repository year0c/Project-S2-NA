   12594/   1A64C :                     
   12595/   1A64C :                     Dynamic_Normal:
   12596/   1A64C : 47F8 F7F0           		lea	(Anim_Counters).w,a3
   12597/   1A650 : 3C1A                		move.w	(a2)+,d6			; Get number of scripts in list
   12598/   1A652 :                     
   12599/   1A652 :                     loc_1AACA:
   12600/   1A652 : 5313                		subq.b	#1,(a3)				; Tick down frame duration
   12601/   1A654 : 6A42                		bpl.s	loc_1AB10			; If frame isn't over, move on to next script
   12602/   1A656 :                     
   12603/   1A656 : 7000                		moveq	#0,d0
   12604/   1A658 : 102B 0001           		move.b	1(a3),d0			; Get current frame
   12605/   1A65C : B02A 0006           		cmp.b	6(a2),d0			; Have we processed the last frame in the script?
   12606/   1A660 : 6506                		blo.s	loc_1AAE0
   12607/   1A662 : 7000                		moveq	#0,d0				; If so, reset to first frame
   12608/   1A664 : 1740 0001           		move.b	d0,1(a3)
   12609/   1A668 :                     
   12610/   1A668 :                     loc_1AAE0:
   12611/   1A668 : 522B 0001           		addq.b	#1,1(a3)			; Consider this frame processed; set counter to next frame
   12612/   1A66C : 1692                		move.b	(a2),(a3)			; Set frame duration to global duration value
   12613/   1A66E : 6A06                		bpl.s	loc_1AAEE
   12614/   1A670 :                     		; If script uses per-frame durations, use those instead
   12615/   1A670 : D040                		add.w	d0,d0
   12616/   1A672 : 16B2 0009           		move.b	9(a2,d0.w),(a3)			; Set frame duration to current frame's duration value
   12617/   1A676 :                     
   12618/   1A676 :                     loc_1AAEE:
   12619/   1A676 :                     		; Prepare for DMA transfer
   12620/   1A676 :                     		; Get relative address of frame's art
   12621/   1A676 : 1032 0008           		move.b	8(a2,d0.w),d0			; Get tile ID
   12622/   1A67A : EB48                		lsl.w	#5,d0				; Turn it into an offset
   12623/   1A67C :                     		; Get VRAM destination address
   12624/   1A67C : 342A 0004           		move.w	4(a2),d2
   12625/   1A680 :                     		; Get ROM source address
   12626/   1A680 : 2212                		move.l	(a2),d1				; Get start address of animated tile art
   12627/   1A682 : 0281 00FF FFFF      		andi.l	#$FFFFFF,d1
   12628/   1A688 : D280                		add.l	d0,d1				; Offset into art, to get the address of new frame
   12629/   1A68A :                     		; Get size of art to be transferred
   12630/   1A68A : 7600                		moveq	#0,d3
   12631/   1A68C : 162A 0007           		move.b	7(a2),d3
   12632/   1A690 : E94B                		lsl.w	#4,d3				; Turn it into actual size (in words)
   12633/   1A692 :                     		; Use d1, d2 and d3 to queue art for transfer
   12634/   1A692 : 4EB9 0000 1290      		jsr	(QueueDMATransfer).l
   12635/   1A698 :                     
   12636/   1A698 :                     loc_1AB10:
   12637/   1A698 : 102A 0006           		move.b	6(a2),d0			; Get total size of frame data
   12638/   1A69C : 4A12                		tst.b	(a2)				; Is per-frame duration data present?
   12639/   1A69E : 6A02                		bpl.s	loc_1AB1A			; If not, keep the current size; it's correct
   12640/   1A6A0 : D000                		add.b	d0,d0				; Double size to account for the additional frame duration data
   12641/   1A6A2 :                     
   12642/   1A6A2 :                     loc_1AB1A:
   12643/   1A6A2 : 5200                		addq.b	#1,d0
   12644/   1A6A4 : 0240 00FE           		andi.w	#$FE,d0				; Round to next even address, if it isn't already
   12645/   1A6A8 : 45F2 0008           		lea	8(a2,d0.w),a2			; Advance to next script in list
   12646/   1A6AC : 544B                		addq.w	#2,a3				; Advance to next script's slot in a3 (usually Anim_Counters)
   12647/   1A6AE : 51CE FFA2           		dbf	d6,loc_1AACA
   12648/   1A6B2 : 4E75                		rts
