    6586/    C966 : 7E1F                		moveq	#bytesToXcnt(v_lvlobjspace-v_objspace,object_size),d7
    6587/    C968 : 61E2                		bsr.s	RunObject
    6588/    C96A : 7E5F                		moveq	#bytesToXcnt(v_lvlobjend-v_lvlobjspace,object_size),d7
