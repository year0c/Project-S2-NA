    1028/    1312 :                     ; ---------------------------------------------------------------------------
    1029/    1312 :                     ; VDP register settings to use for the game. Do note that a handful of these
    1030/    1312 :                     ; are getting rewritten for every game mode change, though the majority
    1031/    1312 :                     ; will stay at their initial settings defined in this array.
    1032/    1312 :                     ; ---------------------------------------------------------------------------
    1033/    1312 :                     ; See here for details on VDP registers:
    1034/    1312 :                     ; https://segaretro.org/Sega_Mega_Drive/VDP_registers
    1035/    1312 :                     ; ---------------------------------------------------------------------------
    1036/    1312 :                     
    1037/    1312 :                     VDPSetupArray:
    1038/    1312 : 8004                		dc.w $8000|%00000100			; 8-color mode
    1039/    1314 : 8134                		dc.w $8100|%00110100			; vertical interrupts, DMA, Mega Drive display
    1040/    1316 : 8230                		dc.w $8200|(vram_fg>>10)		; foreground nametable address
    1041/    1318 : 8328                		dc.w $8300|($A000>>10)			; window nametable address
    1042/    131A : 8407                		dc.w $8400|(vram_bg>>13)		; background nametable address
    1043/    131C : 857C                		dc.w $8500|(vram_sprites>>9)		; sprite table address
    1044/    131E : 8600                		dc.w $8600				; (unused, only relevant for 128KB VRAM mode)
    1045/    1320 : 8700                		dc.w $8700|$00				; background colour (palette line 0, entry 0)
    1046/    1322 : 8800                		dc.w $8800				; (unused, only relevant for Master System)
    1047/    1324 : 8900                		dc.w $8900				; (unused, only relevant for Master System)
    1048/    1326 : 8A00                		dc.w $8A00|$00				; horizontal interrupt register
    1049/    1328 : 8B00                		dc.w $8B00|%00000000			; full-screen vertical scrolling
    1050/    132A : 8C81                		dc.w $8C00|%10000001			; 40-cell display mode
    1051/    132C : 8D3F                		dc.w $8D00|(vram_hscroll>>10)		; background H-scroll address
    1052/    132E : 8E00                		dc.w $8E00				; (unused, only relevant for 128KB VRAM mode)
    1053/    1330 : 8F02                		dc.w $8F00|$02				; VDP auto-increment size (2)
    1054/    1332 : 9001                		dc.w $9000|%00000001			; 64-cell H-scroll size
    1055/    1334 : 9100                		dc.w $9100				; window horizontal position
    1056/    1336 : 9200                		dc.w $9200				; window vertical position
