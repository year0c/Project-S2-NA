(2)  340/   74380 :                     	PSGPitchConvert pitch
(2)  341/   74380 :                     	dc.b	vol
(2)  342/   74380 :                     	; Frequency envelope
(2)  343/   74380 :                     	if (SonicDriverVer>=3) && (SourceDriver<3)
(2)  344/   74380 :                     		; In SMPS 68k Type 1, this byte is skipped and can contain garbage.
(2)  345/   74380 :                     		; Sonic 2's Oil Ocean Zone and Ending themes set this byte to a non-zero value which
(2)  346/   74380 :                     		; other drivers may try to process as valid data, so manually force it to 0 here.
(2)  347/   74380 :                     		dc.b	0
(2)  348/   74380 :                     	else
(2)  349/   74380 :                     		if (MOMPASS==1) && (SonicDriverVer<3) && (SourceDriver>=3) && (mod<>0)
(2)  350/   74380 :                     			message "This track header specifies a frequency envelope, but this driver does not support them."
(2)  351/   74380 :                     		endif
(2)  352/   74380 :                     		dc.b	mod
(2)  353/   74380 :                     	endif
(2)  354/   74380 :                     	; Volume envelope
(2)  355/   74380 :                     	dc.b	voice
(2)  356/   74380 :                     	endm
(2)  357/   74380 :                     
(2)  358/   74380 :                     ; Header macros for SFX (not for music)
(2)  359/   74380 :                     ; Header - Set up Tempo
(2)  360/   74380 :                     smpsHeaderTempoSFX macro div
(2)  361/   74380 :                     	dc.b	div
(2)  362/   74380 :                     	endm
(2)  363/   74380 :                     
(2)  364/   74380 :                     ; Header - Set up Channel Usage
(2)  365/   74380 :                     smpsHeaderChanSFX macro chan
(2)  366/   74380 :                     	dc.b	chan
(2)  367/   74380 :                     	endm
(2)  368/   74380 :                     
(2)  369/   74380 :                     ; Header - Set up FM Channel
(2)  370/   74380 :                     smpsHeaderSFXChannel macro chanid,loc,pitch,vol
(2)  371/   74380 :                     	if (SonicDriverVer>=3)&&(chanid==cNoise)
(2)  372/   74380 :                     		fatal "Using channel ID of cNoise ($E0) in Sonic 3 driver is dangerous. Fix the song so that it turns into a noise channel instead."
(2)  373/   74380 :                     	elseif (SonicDriverVer<3)&&(chanid==cFM6)
(2)  374/   74380 :                     		fatal "Using channel ID of FM6 ($06) in Sonic 1 or Sonic 2 drivers is unsupported. Change it to another channel."
(2)  375/   74380 :                     	endif
(2)  376/   74380 :                     	dc.b	$80,chanid
(2)  377/   74380 :                     	CheckedChannelPointer loc
(2)  378/   74380 :                     	if (chanid&$80)<>0
(2)  379/   74380 :                     		PSGPitchConvert pitch
(2)  380/   74380 :                     	else
(2)  381/   74380 :                     		dc.b	pitch
(2)  382/   74380 :                     	endif
(2)  383/   74380 :                     	dc.b	vol
(2)  384/   74380 :                     	endm
(2)  385/   74380 :                     ; ---------------------------------------------------------------------------
(2)  386/   74380 :                     ; Co-ord Flag Macros and Equates
(2)  387/   74380 :                     ; E0xx - Panning, AMS, FMS
(2)  388/   74380 :                     smpsPan macro direction,amsfms
(2)  389/   74380 :                     panNone set $00
(2)  390/   74380 :                     panRight set $40
(2)  391/   74380 :                     panLeft set $80
(2)  392/   74380 :                     panCentre set $C0
(2)  393/   74380 :                     panCenter set $C0 ; silly Americans :U
(2)  394/   74380 :                     	dc.b $E0,direction+amsfms
(2)  395/   74380 :                     	endm
(2)  396/   74380 :                     
(2)  397/   74380 :                     ; E1xx - Set channel detune to val
(2)  398/   74380 :                     smpsDetune macro val
(2)  399/   74380 :                     	dc.b	$E1,val
(2)  400/   74380 :                     	endm
(2)  401/   74380 :                     
(2)  402/   74380 :                     ; E2xx - Used for setting a variable which can be read by the game, for synchonisation. Ristar does this.
(2)  403/   74380 :                     smpsNop macro val
(2)  404/   74380 :                     	if (SonicDriverVer>=3) && ((val==$FF) || (val==$29))
(2)  405/   74380 :                     		warning "Values $FF and $29 are reserved in S3K's driver; use a different value or remove this command."
(2)  406/   74380 :                     	endif
(2)  407/   74380 :                     	dc.b	$E2,val
(2)  408/   74380 :                     	endm
(2)  409/   74380 :                     
(2)  410/   74380 :                     ; Return (used after smpsCall)
(2)  411/   74380 :                     smpsReturn macro val
(2)  412/   74380 :                     	if SonicDriverVer>=3
(2)  413/   74380 :                     		dc.b	$F9
(2)  414/   74380 :                     	else
(2)  415/   74380 :                     		dc.b	$E3
(2)  416/   74380 :                     	endif
(2)  417/   74380 :                     	endm
(2)  418/   74380 :                     
(2)  419/   74380 :                     ; Fade in previous song (ie. 1-Up)
(2)  420/   74380 :                     smpsFade macro val
(2)  421/   74380 :                     	if SonicDriverVer>=3
(2)  422/   74380 :                     		dc.b	$E2
(2)  423/   74380 :                     		if ("val"<>"")
(2)  424/   74380 :                     			dc.b	val
(2)  425/   74380 :                     		else
(2)  426/   74380 :                     			dc.b	$FF
(2)  427/   74380 :                     		endif
(2)  428/   74380 :                     		if SourceDriver<3
(2)  429/   74380 :                     			smpsStop
(2)  430/   74380 :                     		endif
(2)  431/   74380 :                     	elseif (SourceDriver>=3) && ("val"<>"") && ("val"<>"$FF")
(2)  432/   74380 :                     		; This is actually a communication byte, not a fade.
(2)  433/   74380 :                     		smpsNop	val
(2)  434/   74380 :                     	else
(2)  435/   74380 :                     		dc.b	$E4
(2)  436/   74380 :                     	endif
(2)  437/   74380 :                     	endm
(2)  438/   74380 :                     
(2)  439/   74380 :                     ; E5xx - Set channel tempo divider to xx
(2)  440/   74380 :                     smpsChanTempoDiv macro val
(2)  441/   74380 :                     	if SonicDriverVer>=5
(2)  442/   74380 :                     		; New flag unique to Flamewing's modified S&K driver
(2)  443/   74380 :                     		dc.b	$FF,$08,val
(2)  444/   74380 :                     	elseif SonicDriverVer==3
(2)  445/   74380 :                     		fatal "Coord. Flag to set tempo divider of a single channel does not exist in S3 driver. Use Flamewing's modified S&K sound driver instead."
(2)  446/   74380 :                     	else
(2)  447/   74380 :                     		dc.b	$E5,val
(2)  448/   74380 :                     	endif
(2)  449/   74380 :                     	endm
(2)  450/   74380 :                     
(2)  451/   74380 :                     ; E6xx - Alter Volume by xx
(2)  452/   74380 :                     smpsAlterVol macro val
(2)  453/   74380 :                     	dc.b	$E6,val
(2)  454/   74380 :                     	endm
(2)  455/   74380 :                     
(2)  456/   74380 :                     ; E7 - Prevent attack of next note
(2)  457/   74380 : =$E7                 smpsNoAttack	EQU $E7
(2)  458/   74380 :                     
(2)  459/   74380 :                     ; E8xx - Set note fill to xx
(2)  460/   74380 :                     smpsNoteFill macro val
(2)  461/   74380 :                     	if (SonicDriverVer>=5)&&(SourceDriver<3)
(2)  462/   74380 :                     		; Unique to Flamewing's modified driver
(2)  463/   74380 :                     		dc.b	$FF,$0A,val
(2)  464/   74380 :                     	else
(2)  465/   74380 :                     		if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  466/   74380 :                     			message "Note fill will not work as intended unless you divide the fill value by the tempo divider or complain to Flamewing to add an appropriate coordination flag for it."
(2)  467/   74380 :                     		elseif (SonicDriverVer<3)&&(SourceDriver>=3)
(2)  468/   74380 :                     			message "Note fill will not work as intended unless you multiply the fill value by the tempo divider or complain to Flamewing to add an appropriate coordination flag for it."
(2)  469/   74380 :                     		endif
(2)  470/   74380 :                     		dc.b	$E8,val
(2)  471/   74380 :                     	endif
(2)  472/   74380 :                     	endm
(2)  473/   74380 :                     
(2)  474/   74380 :                     ; Add xx to channel pitch
(2)  475/   74380 :                     smpsChangeTransposition macro val
(2)  476/   74380 :                     	if SonicDriverVer>=3
(2)  477/   74380 :                     		dc.b	$FB,val
(2)  478/   74380 :                     	else
(2)  479/   74380 :                     		dc.b	$E9,val
(2)  480/   74380 :                     	endif
(2)  481/   74380 :                     	endm
(2)  482/   74380 :                     
(2)  483/   74380 :                     ; Set music tempo modifier to xx
(2)  484/   74380 :                     smpsSetTempoMod macro mod
(2)  485/   74380 :                     	if SonicDriverVer>=3
(2)  486/   74380 :                     		dc.b	$FF,$00
(2)  487/   74380 :                     	else
(2)  488/   74380 :                     		dc.b	$EA
(2)  489/   74380 :                     	endif
(2)  490/   74380 :                     	convertMainTempoMod mod
(2)  491/   74380 :                     	endm
(2)  492/   74380 :                     
(2)  493/   74380 :                     ; Set music tempo divider to xx
(2)  494/   74380 :                     smpsSetTempoDiv macro val
(2)  495/   74380 :                     	if SonicDriverVer>=3
(2)  496/   74380 :                     		dc.b	$FF,$04,val
(2)  497/   74380 :                     	else
(2)  498/   74380 :                     		dc.b	$EB,val
(2)  499/   74380 :                     	endif
(2)  500/   74380 :                     	endm
(2)  501/   74380 :                     
(2)  502/   74380 :                     ; ECxx - Set Volume to xx
(2)  503/   74380 :                     smpsSetVol macro val
(2)  504/   74380 :                     	if SonicDriverVer>=3
(2)  505/   74380 :                     		dc.b	$E4,val
(2)  506/   74380 :                     	else
(2)  507/   74380 :                     		fatal "Coord. Flag to set volume (instead of volume attenuation) does not exist in S1 or S2 drivers. Complain to Flamewing to add it."
(2)  508/   74380 :                     	endif
(2)  509/   74380 :                     	endm
(2)  510/   74380 :                     
(2)  511/   74380 :                     ; Works on all drivers
(2)  512/   74380 :                     smpsPSGAlterVol macro vol
(2)  513/   74380 :                     	dc.b	$EC,vol
(2)  514/   74380 :                     	endm
(2)  515/   74380 :                     
(2)  516/   74380 :                     smpsPSGAlterVolS2 macro vol
(2)  517/   74380 :                     	; Sonic 2's driver allows the FM command to be used on PSG channels, but others do not.
(2)  518/   74380 :                     	if SonicDriverVer==2
(2)  519/   74380 :                     		smpsAlterVol vol
(2)  520/   74380 :                     	else
(2)  521/   74380 :                     		smpsPSGAlterVol vol
(2)  522/   74380 :                     	endif
(2)  523/   74380 :                     	endm
(2)  524/   74380 :                     
(2)  525/   74380 :                     ; Clears pushing sound flag in S1
(2)  526/   74380 :                     smpsClearPush macro
(2)  527/   74380 :                     	if SonicDriverVer==1
(2)  528/   74380 :                     		dc.b	$ED
(2)  529/   74380 :                     	else
(2)  530/   74380 :                     		fatal "Coord. Flag to clear S1 push block flag does not exist in S2 or S3 drivers. Complain to Flamewing to add it."
(2)  531/   74380 :                     	endif
(2)  532/   74380 :                     	endm
(2)  533/   74380 :                     
(2)  534/   74380 :                     ; Stops special SFX (S1 only) and restarts overridden music track
(2)  535/   74380 :                     smpsStopSpecial macro
(2)  536/   74380 :                     	if SonicDriverVer==1
(2)  537/   74380 :                     		dc.b	$EE
(2)  538/   74380 :                     	else
(2)  539/   74380 :                     		message "Coord. Flag to stop special SFX does not exist in S2 or S3 drivers. Complain to Flamewing to add it. With adequate caution, smpsStop can do this job."
(2)  540/   74380 :                     		smpsStop
(2)  541/   74380 :                     	endif
(2)  542/   74380 :                     	endm
(2)  543/   74380 :                     
(2)  544/   74380 :                     ; EFxx[yy] - Set Voice of FM channel to xx; xx < 0 means yy present
(2)  545/   74380 :                     smpsFMvoice macro voice,songID
(2)  546/   74380 :                     	if (SonicDriverVer>=3)&&("songID"<>"")
(2)  547/   74380 :                     		dc.b	$EF,voice|$80,songID+$81
(2)  548/   74380 :                     	else
(2)  549/   74380 :                     		dc.b	$EF,voice
(2)  550/   74380 :                     	endif
(2)  551/   74380 :                     	endm
(2)  552/   74380 :                     
(2)  553/   74380 :                     ; F0wwxxyyzz - Modulation - ww: wait time - xx: modulation speed - yy: change per step - zz: number of steps
(2)  554/   74380 :                     smpsModSet macro wait,speed,change,step
(2)  555/   74380 :                     	dc.b	$F0
(2)  556/   74380 :                     	if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  557/   74380 :                     		dc.b	wait+1,speed,change,((step+1) * speed) & $FF
(2)  558/   74380 :                     	elseif (SonicDriverVer<3)&&(SourceDriver>=3)
(2)  559/   74380 :                     		dc.b	wait-1,speed,change,conv0To256(step)/conv0To256(speed)-1
(2)  560/   74380 :                     	else
(2)  561/   74380 :                     		dc.b	wait,speed,change,step
(2)  562/   74380 :                     	endif
(2)  563/   74380 :                     	;dc.b	speed,change,step
(2)  564/   74380 :                     	endm
(2)  565/   74380 :                     
(2)  566/   74380 :                     ; Turn on Modulation
(2)  567/   74380 :                     smpsModOn macro type
(2)  568/   74380 :                     	if SonicDriverVer>=3
(2)  569/   74380 :                     		if "type"<>""
(2)  570/   74380 :                     			dc.b	$F4,type
(2)  571/   74380 :                     		else
(2)  572/   74380 :                     			dc.b	$F4,$80
(2)  573/   74380 :                     		endif
(2)  574/   74380 :                     	else
(2)  575/   74380 :                     		dc.b	$F1
(2)  576/   74380 :                     	endif
(2)  577/   74380 :                     	endm
(2)  578/   74380 :                     
(2)  579/   74380 :                     ; F2 - End of channel
(2)  580/   74380 :                     smpsStop macro
(2)  581/   74380 :                     	dc.b	$F2
(2)  582/   74380 :                     	endm
(2)  583/   74380 :                     
(2)  584/   74380 :                     ; F3xx - PSG waveform to xx
(2)  585/   74380 :                     smpsPSGform macro form
(2)  586/   74380 :                     	dc.b	$F3,form
(2)  587/   74380 :                     	endm
(2)  588/   74380 :                     
(2)  589/   74380 :                     ; Turn off Modulation
(2)  590/   74380 :                     smpsModOff macro
(2)  591/   74380 :                     	if SonicDriverVer>=3
(2)  592/   74380 :                     		dc.b	$FA
(2)  593/   74380 :                     	else
(2)  594/   74380 :                     		dc.b	$F4
(2)  595/   74380 :                     	endif
(2)  596/   74380 :                     	endm
(2)  597/   74380 :                     
(2)  598/   74380 :                     ; F5xx - PSG voice to xx
(2)  599/   74380 :                     smpsPSGvoice macro voice
(2)  600/   74380 :                     	dc.b	$F5,voice
(2)  601/   74380 :                     	endm
(2)  602/   74380 :                     
(2)  603/   74380 :                     ; F6xxxx - Jump to xxxx
(2)  604/   74380 :                     smpsJump macro loc
(2)  605/   74380 :                     	dc.b	$F6
(2)  606/   74380 :                     	if SonicDriverVer<>1
(2)  607/   74380 :                     		dc.w	z80_ptr(loc)
(2)  608/   74380 :                     	else
(2)  609/   74380 :                     		dc.w	loc-*-1
(2)  610/   74380 :                     	endif
(2)  611/   74380 :                     	endm
(2)  612/   74380 :                     
(2)  613/   74380 :                     ; F7xxyyzzzz - Loop back to zzzz yy times, xx being the loop index for loop recursion fixing
(2)  614/   74380 :                     smpsLoop macro index,loops,loc
(2)  615/   74380 :                     	dc.b	$F7
(2)  616/   74380 :                     	dc.b	index,loops
(2)  617/   74380 :                     	if SonicDriverVer<>1
(2)  618/   74380 :                     		dc.w	z80_ptr(loc)
(2)  619/   74380 :                     	else
(2)  620/   74380 :                     		dc.w	loc-*-1
(2)  621/   74380 :                     	endif
(2)  622/   74380 :                     	endm
(2)  623/   74380 :                     
(2)  624/   74380 :                     ; F8xxxx - Call pattern at xxxx, saving return point
(2)  625/   74380 :                     smpsCall macro loc
(2)  626/   74380 :                     	dc.b	$F8
(2)  627/   74380 :                     	if SonicDriverVer<>1
(2)  628/   74380 :                     		dc.w	z80_ptr(loc)
(2)  629/   74380 :                     	else
(2)  630/   74380 :                     		dc.w	loc-*-1
(2)  631/   74380 :                     	endif
(2)  632/   74380 :                     	endm
(2)  633/   74380 :                     ; ---------------------------------------------------------------------------
(2)  634/   74380 :                     ; Alter Volume
(2)  635/   74380 :                     smpsFMAlterVol macro val1,val2
(2)  636/   74380 :                     	if ("val2"<>"")
(2)  637/   74380 :                     		; S3K's nerfed 'PSG & FM volume' command with broken PSG support.
(2)  638/   74380 :                     		; The first value is completely unused, while the second is for FM tracks.
(2)  639/   74380 :                     		if (SonicDriverVer>=3)
(2)  640/   74380 :                     			dc.b	$E5,val1,val2
(2)  641/   74380 :                     		else
(2)  642/   74380 :                     			dc.b	$E6,val2
(2)  643/   74380 :                     		endif
(2)  644/   74380 :                     	else
(2)  645/   74380 :                     		; Normal, sane command.
(2)  646/   74380 :                     		dc.b	$E6,val1
(2)  647/   74380 :                     	endif
(2)  648/   74380 :                     	endm
(2)  649/   74380 :                     
(2)  650/   74380 :                     ; S3/S&K/S3D-only coordination flags
