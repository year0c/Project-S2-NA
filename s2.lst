    9783/    F3A0 :                     SolidObject_cont:
    9784/    F3A0 :                     		; We now perform the x portion of a bounding box check.  To do this, we assume a
    9785/    F3A0 :                     		; coordinate system where the x origin is at the object's left edge.
    9786/    F3A0 : 3029 0008           		move.w	obX(a1),d0			; load Sonic's x position...
    9787/    F3A4 : 9068 0008           		sub.w	obX(a0),d0			; ... and calculate his x position relative to the object
    9788/    F3A8 : D041                		add.w	d1,d0				; assume object's left edge is at (0,0).  This is also Sonic's distance to the object's left edge.
    9789/    F3AA : 6B00 00C4           		bmi.w	SolidObject_TestClearPush	; branch, if Sonic is outside the object's left edge
    9790/    F3AE : 3601                		move.w	d1,d3
    9791/    F3B0 : D643                		add.w	d3,d3				; calculate object's width
    9792/    F3B2 : B043                		cmp.w	d3,d0
    9793/    F3B4 : 6200 00BA           		bhi.w	SolidObject_TestClearPush	; branch, if Sonic is outside the object's right edge
    9794/    F3B8 :                     		; We now perform the y portion of a bounding box check.  To do this, we assume a
    9795/    F3B8 :                     		; coordinate system where the y origin is at the highest y position relative to the object
    9796/    F3B8 :                     		; at which Sonic would still collide with it.  This point is
    9797/    F3B8 :                     		;   y_pos(object) - width(object)/2 - y_radius(Sonic) - 4,
    9798/    F3B8 :                     		; where object is stored in (a0), Sonic in (a1), and height(object)/2 in d2.  This way
    9799/    F3B8 :                     		; of doing it causes the object's hitbox to be vertically off-center by -4 pixels.
    9800/    F3B8 : 1629 0016           		move.b	obHeight(a1),d3			; load Sonic's y radius
    9801/    F3BC : 4883                		ext.w	d3
    9802/    F3BE : D443                		add.w	d3,d2				; calculate maximum distance for a top collision
    9803/    F3C0 : 3629 000C           		move.w	obY(a1),d3			; load Sonic's y position
    9804/    F3C4 : 9668 000C           		sub.w	obY(a0),d3			; ... and calculate his y position relative to the object
    9805/    F3C8 : 5843                		addq.w	#4,d3				; assume a slightly lower position for Sonic
    9806/    F3CA : D642                		add.w	d2,d3				; assume the highest position where Sonic would still be colliding with the object to be (0,0)
    9807/    F3CC : 6B00 00A2           		bmi.w	SolidObject_TestClearPush	; branch, if Sonic is above this point
    9808/    F3D0 : 3802                		move.w	d2,d4
    9809/    F3D2 : D844                		add.w	d4,d4				; calculate minimum distance for a bottom collision
    9810/    F3D4 : B644                		cmp.w	d4,d3
    9811/    F3D6 : 6400 0098           		bhs.w	SolidObject_TestClearPush	; branch, if Sonic is below this point
