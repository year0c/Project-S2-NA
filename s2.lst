(1) 1774/   72314 :                     ; ===========================================================================
(1) 1775/   72314 :                     ; ---------------------------------------------------------------------------
(1) 1776/   72314 :                     ; FM Note Values: b-0 to a#8
(1) 1777/   72314 :                     ;
(1) 1778/   72314 :                     ; Each row is an octave, starting with B and ending with A-sharp/B-flat.
(1) 1779/   72314 :                     ; Notably, this differs from the PSG frequency table, which starts with C and
(1) 1780/   72314 :                     ; ends with B. This is caused by 'FMSetFreq' subtracting $80 from the note
(1) 1781/   72314 :                     ; instead of $81, meaning that the first frequency in the table ironically
(1) 1782/   72314 :                     ; corresponds to the 'rest' note. The only way to use this frequency in a
(1) 1783/   72314 :                     ; real note is to transpose the channel to a lower semitone.
(1) 1784/   72314 :                     ;
(1) 1785/   72314 :                     ; Rather than use a complete lookup table, other SMPS drivers such as
(1) 1786/   72314 :                     ; Sonic 3's compute the octave, and only store a single octave's worth of
(1) 1787/   72314 :                     ; notes in the table.
(1) 1788/   72314 :                     ;
(1) 1789/   72314 :                     ; Invalid transposition values will cause this table to be overflowed,
(1) 1790/   72314 :                     ; resulting in garbage data being used as frequency values. In drivers that
(1) 1791/   72314 :                     ; compute the octave instead, invalid transposition values merely cause the
(1) 1792/   72314 :                     ; notes to wrap-around (the note below the lowest note will be the highest
(1) 1793/   72314 :                     ; note). It's important to keep this in mind when porting buggy songs.
(1) 1794/   72314 :                     ; ---------------------------------------------------------------------------
(1) 1795/   72314 :                     MakeFMFrequency function frequency,roundFloatToInteger(frequency*1024*1024*2/FM_Sample_Rate)
(1) 1796/   72314 :                     MakeFMFrequenciesOctave macro octave
(1) 1797/   72314 :                     		; Frequencies for the base octave. The first frequency is B, the last frequency is B-flat.
(1) 1798/   72314 :                     		irp op, 15.39, 16.35, 17.34, 18.36, 19.45, 20.64, 21.84, 23.13, 24.51, 25.98, 27.53, 29.15
(1) 1799/   72314 :                     			dc.w MakeFMFrequency(op)+octave*$800
(1) 1800/   72314 :                     		endm
(1) 1801/   72314 :                     	endm
(1) 1802/   72314 :                     
(1) 1803/   72314 :                     ; word_72790: FM_Notes:
(1) 1804/   72314 :                     FMFrequencies:
(1) 1805/   72314 : (MACRO)              		MakeFMFrequenciesOctave 0
(1) 1805/   72314 :                                     ; Frequencies for the base 0. The first frequency is B, the last frequency is B-flat.
(1) 1805/   72314 :                                     irp op, 15.39, 16.35, 17.34, 18.36, 19.45, 20.64, 21.84, 23.13, 24.51, 25.98, 27.53, 29.15
(1) 1805/   72314 :                                             dc.w MakeFMFrequency(op)+0*$800
(1) 1805/   72314 :                                     endm
(1) 1805/   72314 : 025E                                        dc.w MakeFMFrequency(15.39)+0*$800
(1) 1805/   72316 : 0284                                        dc.w MakeFMFrequency(16.35)+0*$800
(1) 1805/   72318 : 02AB                                        dc.w MakeFMFrequency(17.34)+0*$800
