(1)    1/    14AC :                     ; ---------------------------------------------------------------------------
(1)    2/    14AC :                     ; MACRO ResetDMAQueue
(1)    3/    14AC :                     ; Clears the DMA queue, discarding all previously-queued DMAs.
(1)    4/    14AC :                     ; ---------------------------------------------------------------------------
(1)    5/    14AC :                     ; ROUTINE Process_DMA_Queue / ProcessDMAQueue
(1)    6/    14AC :                     ; Performs all queued DMA transfers and clears the DMA queue.
(1)    7/    14AC :                     ;
(1)    8/    14AC :                     ; Output:
(1)    9/    14AC :                     ; 	a1,a5	trashed
(1)   10/    14AC :                     ; ---------------------------------------------------------------------------
(1)   11/    14AC :                     ; ROUTINE InitDMAQueue
(1)   12/    14AC :                     ; Pre-initializes the DMA queue with VDP register numbers in alternating bytes.
(1)   13/    14AC :                     ; Must be called before the queue is used, and the queue expects that only it
(1)   14/    14AC :                     ; write to this region of RAM.
(1)   15/    14AC :                     ;
(1)   16/    14AC :                     ; Output:
(1)   17/    14AC :                     ; 	a0,d0,d1	trashed
(1)   18/    14AC :                     ; ---------------------------------------------------------------------------
(1)   19/    14AC :                     ; ROUTINE Add_To_DMA_Queue / QueueDMATransfer
(1)   20/    14AC :                     ; Queues a DMA with parameters given in registers.
(1)   21/    14AC :                     ;
(1)   22/    14AC :                     ; Options:
(1)   23/    14AC :                     ; 	AssumeSourceAddressInBytes (default 1)
(1)   24/    14AC :                     ; 	AssumeSourceAddressIsRAMSafe (default 0)
(1)   25/    14AC :                     ; 	UseRAMSourceSafeDMA (default 1&(AssumeSourceAddressIsRAMSafe==0))
(1)   26/    14AC :                     ; 	Use128kbSafeDMA (default 0)
(1)   27/    14AC :                     ; 	UseVIntSafeDMA (default 0)
(1)   28/    14AC :                     ; Input:
(1)   29/    14AC :                     ; 	d1	Source address (in bytes, or in words if AssumeSourceAddressInBytes is
(1)   30/    14AC :                     ; 		set to 0)
(1)   31/    14AC :                     ; 	d2	Destination address
(1)   32/    14AC :                     ; 	d3	Transfer length (in words)
(1)   33/    14AC :                     ; Output:
(1)   34/    14AC :                     ; 	d0,d1,d2,d3,a1	trashed
(1)   35/    14AC :                     ;
(1)   36/    14AC :                     ; With the default settings, runs in:
(1)   37/    14AC :                     ; * 48(11/0) cycles if queue is full (DMA discarded)
(1)   38/    14AC :                     ; * 184(29/9) cycles otherwise (DMA queued)
(1)   39/    14AC :                     ;
(1)   40/    14AC :                     ; With Use128kbSafeDMA = 1, runs in:
(1)   41/    14AC :                     ; * 48(11/0) cycles if queue is full at the start (DMA discarded)
(1)   42/    14AC :                     ; * 200(32/9) cycles if the DMA does not cross a 128kB boundary (DMA queued)
(1)   43/    14AC :                     ; * 226(38/9) cycles if the DMA crosses a 128kB boundary, and the first piece
(1)   44/    14AC :                     ;   fills the queue (second piece is discarded)
(1)   45/    14AC :                     ; * 338(56/17) cycles if the DMA crosses a 128kB boundary, and the queue has
(1)   46/    14AC :                     ;   space for both pieces (both pieces queued)
(1)   47/    14AC :                     ;
(1)   48/    14AC :                     ; Setting UseVIntSafeDMA to 1 adds 46(6/1) cycles to all times.
(1)   49/    14AC :                     ;
(1)   50/    14AC :                     ; Setting AssumeSourceAddressInBytes to 0 reduces all times by 10(1/0) cycles,
(1)   51/    14AC :                     ; but only if the DMA is not entirely discarded. However, all callers must be
(1)   52/    14AC :                     ; edited to make sure the adresss given is in the correct form; you can use
(1)   53/    14AC :                     ; the dmaSource function for that, which also sanitizes RAM addresses.
(1)   54/    14AC :                     ;
(1)   55/    14AC :                     ; Setting AssumeSourceAddressIsRAMSafe to 1, or UseRAMSourceSafeDMA to 0,
(1)   56/    14AC :                     ; reduces all times by 14(2/0) cycles, but only if the DMA is not entirely
(1)   57/    14AC :                     ; discarded. However, all callers must be edited to make sure the adresss given
(1)   58/    14AC :                     ; in the correct form.
(1)   59/    14AC :                     ; ---------------------------------------------------------------------------
(1)   60/    14AC :                     ; MACRO QueueStaticDMA
(1)   61/    14AC :                     ; Directly queues a DMA on the spot. Requires all parameters to be known at
(1)   62/    14AC :                     ; assembly time; that is, no registers. Gives assembly errors when the DMA
(1)   63/    14AC :                     ; crosses a 128kB boundary, is at an odd ROM location, or is zero length.
(1)   64/    14AC :                     ;
(1)   65/    14AC :                     ; The destination parameter can be either:
(1)   66/    14AC :                     ; * a VRAM address literal;
(1)   67/    14AC :                     ; * a register initialized with `move.l	#vdpComm(dest,VRAM,DMA)`
(1)   68/    14AC :                     ; * a register initialized with `vdpCommReg <reg>,VRAM,DMA`
(1)   69/    14AC :                     ;
(1)   70/    14AC :                     ; Options:
(1)   71/    14AC :                     ; 	UseVIntSafeDMA (default 0)
(1)   72/    14AC :                     ; Input:
(1)   73/    14AC :                     ; 	Source address (in bytes), transfer length (in bytes), destination address
(1)   74/    14AC :                     ; Output:
(1)   75/    14AC :                     ; 	d0,a1	trashed; avoid using these for passing destination as a register
(1)   76/    14AC :                     ;
(1)   77/    14AC :                     ; With the default settings, runs in:
(1)   78/    14AC :                     ; * 32(7/0) cycles if queue is full (DMA discarded)
(1)   79/    14AC :                     ; * 122(21/8) cycles otherwise (DMA queued)
(1)   80/    14AC :                     ; Passing a register as destination is faster by 8(2/0) when the DMA is queued,
(1)   81/    14AC :                     ; but requires initializing the register elsewhere, which is probably slower.
(1)   82/    14AC :                     ;
(1)   83/    14AC :                     ; Setting UseVIntSafeDMA to 1 adds 46(6/1) cycles to both cases.
(1)   84/    14AC :                     ; ===========================================================================
(1)   85/    14AC :                     ; option: AssumeSourceAddressInBytes
(1)   86/    14AC :                     ;
(1)   87/    14AC :                     ; This option makes the function work as a drop-in replacement of the original
(1)   88/    14AC :                     ; functions. If you modify all callers to supply a position in words instead of
(1)   89/    14AC :                     ; bytes (i.e., divide source address by 2) you can set this to 0 to gain 10(1/0)
(1)   90/    14AC : =$1                  AssumeSourceAddressInBytes = 1
(1)   91/    14AC :                     ; ===========================================================================
(1)   92/    14AC :                     ; option: AssumeSourceAddressIsRAMSafe
(1)   93/    14AC :                     ;
(1)   94/    14AC :                     ; This option (which is disabled by default) makes the DMA queue assume that the
(1)   95/    14AC :                     ; source address is given to the function in a way that makes them safe to use
(1)   96/    14AC :                     ; with RAM sources. You need to edit all callers to ensure this.
(1)   97/    14AC :                     ; Enabling this option turns off UseRAMSourceSafeDMA, and saves 14(2/0).
(1)   98/    14AC : =$0                  AssumeSourceAddressIsRAMSafe = 0
(1)   99/    14AC :                     ; ===========================================================================
(1)  100/    14AC :                     ; option: UseRAMSourceSafeDMA
(1)  101/    14AC :                     ;
(1)  102/    14AC :                     ; This option (which is enabled by default) makes source addresses in RAM safe
(1)  103/    14AC :                     ; at the cost of 14(2/0). If you modify all callers so as to clear the top byte
(1)  104/    14AC :                     ; of source addresses (i.e., by ANDing them with $FFFFFF).
(1)  105/    14AC : =$1                  UseRAMSourceSafeDMA = 1&(AssumeSourceAddressIsRAMSafe==0)
(1)  106/    14AC :                     ; ===========================================================================
(1)  107/    14AC :                     ; option: Use128kbSafeDMA
(1)  108/    14AC :                     ;
(1)  109/    14AC :                     ; This option breaks DMA transfers that crosses a 128kB block into two. It is
(1)  110/    14AC :                     ; disabled by default because you can simply align the art in ROM and avoid the
(1)  111/    14AC :                     ; issue altogether. It is here so that you have a high-performance routine to do
(1)  112/    14AC :                     ; the job in situations where you can't align it in ROM.
(1)  113/    14AC : =$0                  Use128kbSafeDMA = 0
(1)  114/    14AC :                     ; ===========================================================================
(1)  115/    14AC :                     ; option UseVIntSafeDMA
(1)  116/    14AC :                     ;
(1)  117/    14AC :                     ; Option to mask interrupts while updating the DMA queue. This fixes many race
(1)  118/    14AC :                     ; conditions in the DMA funcion, but it costs 46(6/1) cycles. The better way to
(1)  119/    14AC :                     ; handle these race conditions would be to make unsafe callers (such as S3&K's
(1)  120/    14AC :                     ; KosM decoder) prevent these by masking off interrupts before calling and then
(1)  121/    14AC :                     ; restore interrupts after.
(1)  122/    14AC : =$0                  UseVIntSafeDMA = 0
(1)  123/    14AC :                     ; ===========================================================================
(1)  124/    14AC :                     ; Convenience macros, for increased maintainability of the code.
(1)  126/    14AC : =$27                 		equ	DMA,%100111
(1)  129/    14AC : =$21                 		equ	VRAM,%100001
(1)  132/    14AC :                     ; Like vdpComm, but starting from an address contained in a register
(1)  133/    14AC : =$1                  vdpCommReg_defined = 1
(1)  134/    14AC :                     vdpCommReg macro reg,type,rwd,clr
(1)  135/    14AC :                     	lsl.l	#2,reg							; Move high bits into (word-swapped) position, accidentally moving everything else
(1)  136/    14AC :                     	set .upperbits,(type&rwd)&3
(1)  137/    14AC :                     	if .upperbits<>0
(1)  138/    14AC :                     		addq.w	#.upperbits,reg				; Add upper access type bits
(1)  139/    14AC :                     	endif
(1)  140/    14AC :                     	ror.w	#2,reg							; Put upper access type bits into place, also moving all other bits into their correct (word-swapped) places
(1)  141/    14AC :                     	swap	reg								; Put all bits in proper places
(1)  142/    14AC :                     	if clr <> 0
(1)  143/    14AC :                     		andi.w	#3,reg						; Strip whatever junk was in upper word of reg
(1)  144/    14AC :                     	endif
(1)  145/    14AC :                     	set .lowerbits,(type&rwd)&$FC
(1)  146/    14AC :                     	if .lowerbits==$20
(1)  147/    14AC :                     		tas.b	reg							; Add in the DMA flag -- tas fails on memory, but works on registers
(1)  148/    14AC :                     	elseif .lowerbits<>0
(1)  149/    14AC :                     		ori.w	#(.lowerbits<<2),reg		; Add in missing access type bits
(1)  150/    14AC :                     	endif
(1)  151/    14AC :                     	endm
(1)  153/    14AC :                     ; ---------------------------------------------------------------------------
