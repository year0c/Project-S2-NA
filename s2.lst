(1)   68/   71838 :                     ; New tempos for songs during speed shoes
(1)   69/   71838 :                     ; ---------------------------------------------------------------------------
(1)   70/   71838 :                     ; DANGER! several songs will use the first few bytes of MusicIndex as their main
(1)   71/   71838 :                     ; tempos while speed shoes are active. If you don't want that, you should add
(1)   72/   71838 :                     ; their "correct" sped-up main tempos to the list.
(1)   73/   71838 :                     ; byte_71A94:
(1)   74/   71838 :                     SpeedUpIndex:
(1)   75/   71838 : 07                  		dc.b 7		; GHZ
(1)   76/   71839 : 72                  		dc.b $72	; LZ
(1)   77/   7183A : 73                  		dc.b $73	; MZ
(1)   78/   7183B : 26                  		dc.b $26	; SLZ
(1)   79/   7183C : 15                  		dc.b $15	; SYZ
(1)   80/   7183D : 08                  		dc.b 8		; SBZ
(1)   81/   7183E : FF                  		dc.b $FF	; Invincibility
