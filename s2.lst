   16678/   71734 :                     ; Modified Type 1b 68000 Sound Driver
   16679/   71734 :                     ; Same as Sonic 1's, down to its location in the ROM
   16680/   71734 :                     ; ---------------------------------------------------------------------------
   16681/   71734 :                     		include	"s1.sounddriver.asm"
(1)    1/   71734 :                     ; ---------------------------------------------------------------------------
(1)    2/   71734 :                     ; Modified SMPS 68k Type 1b sound driver
(1)    3/   71734 :                     ; The source code to a similar version of the driver can be found here:
(1)    4/   71734 :                     ; https://hiddenpalace.org/News/Sega_of_Japan_Sound_Documents_and_Source_Code
(1)    5/   71734 :                     ; ---------------------------------------------------------------------------
(1)    6/   71734 :                     
(1)    7/   71734 :                     ; Constants
(1)    8/   71734 : =$12                 SMPS_TRACK_COUNT = (SMPS_RAM.v_track_ram_end-SMPS_RAM.v_track_ram)/SMPS_Track.len
(1)    9/   71734 : =$A                  SMPS_MUSIC_TRACK_COUNT = (SMPS_RAM.v_music_track_ram_end-SMPS_RAM.v_music_track_ram)/SMPS_Track.len
(1)   10/   71734 : =$7                  SMPS_MUSIC_FM_DAC_TRACK_COUNT = (SMPS_RAM.v_music_fmdac_tracks_end-SMPS_RAM.v_music_fmdac_tracks)/SMPS_Track.len
(1)   11/   71734 : =$6                  SMPS_MUSIC_FM_TRACK_COUNT = (SMPS_RAM.v_music_fm_tracks_end-SMPS_RAM.v_music_fm_tracks)/SMPS_Track.len
(1)   12/   71734 : =$3                  SMPS_MUSIC_PSG_TRACK_COUNT = (SMPS_RAM.v_music_psg_tracks_end-SMPS_RAM.v_music_psg_tracks)/SMPS_Track.len
(1)   13/   71734 : =$6                  SMPS_SFX_TRACK_COUNT = (SMPS_RAM.v_sfx_track_ram_end-SMPS_RAM.v_sfx_track_ram)/SMPS_Track.len
(1)   14/   71734 : =$3                  SMPS_SFX_FM_TRACK_COUNT = (SMPS_RAM.v_sfx_fm_tracks_end-SMPS_RAM.v_sfx_fm_tracks)/SMPS_Track.len
(1)   15/   71734 : =$3                  SMPS_SFX_PSG_TRACK_COUNT = (SMPS_RAM.v_sfx_psg_tracks_end-SMPS_RAM.v_sfx_psg_tracks)/SMPS_Track.len
(1)   16/   71734 : =$2                  SMPS_SPECIAL_SFX_TRACK_COUNT = (SMPS_RAM.v_spcsfx_track_ram_end-SMPS_RAM.v_spcsfx_track_ram)/SMPS_Track.len
(1)   17/   71734 : =$1                  SMPS_SPECIAL_SFX_FM_TRACK_COUNT = (SMPS_RAM.v_spcsfx_fm_tracks_end-SMPS_RAM.v_spcsfx_fm_tracks)/SMPS_Track.len
(1)   18/   71734 : =$1                  SMPS_SPECIAL_SFX_PSG_TRACK_COUNT = (SMPS_RAM.v_spcsfx_psg_tracks_end-SMPS_RAM.v_spcsfx_psg_tracks)/SMPS_Track.len
(1)   19/   71734 :                     ; ---------------------------------------------------------------------------
(1)   20/   71734 :                     ; Macros
(1)   21/   71734 :                     ; turn a sample rate into a djnz loop counter
(1)   22/   71734 :                     pcmLoopCounterBase function sampleRate,baseCycles, 1+(Z80_Clock/(sampleRate)-(baseCycles)+(13/2))/13
(1)   23/   71734 :                     pcmLoopCounter function sampleRate, pcmLoopCounterBase(sampleRate,90) ; 90 is the number of cycles zPlaySEGAPCMLoop takes to deliver one sample.
(1)   24/   71734 :                     dpcmLoopCounter function sampleRate, pcmLoopCounterBase(sampleRate,301/2) ; 301 is the number of cycles zPlayPCMLoop takes to deliver two samples.
