   15655/   19A4C :                     ; ZONE ANIMATION PROCEDURES AND SCRIPTS
   15656/   19A4C :                     ;
   15657/   19A4C :                     ; Each zone gets two entries in this jump table. The first entry points to the
   15658/   19A4C :                     ; zone's animation procedure (usually Dynamic_Null, AKA none). The second points
   15659/   19A4C :                     ; to the zone's animation script.
   15660/   19A4C :                     ;
   15661/   19A4C :                     ; Seems like stage IDs were already being shifted, since listings for $07-$0F
   15662/   19A4C :                     ; can be found, alongside HPZ's art listed from $08 (its ID in the final).
   15663/   19A4C :                     ; ---------------------------------------------------------------------------
   15664/   19A4C :                     DynArtCue_Index_PB:
   15665/   19A4C : 0042                		dc.w Dynamic_NullGHZ_PB-DynArtCue_Index_PB	; GHZ
   15666/   19A4E : 00AC                		dc.w AnimCue_EHZ_PB-DynArtCue_Index_PB		; GHZ
   15667/   19A50 : 0040                		dc.w Dynamic_Null_PB-DynArtCue_Index_PB		; LZ
   15668/   19A52 : 0136                		dc.w AnimCue_CPZ_Boss_PB-DynArtCue_Index_PB	; LZ
   15669/   19A54 : 0044                		dc.w Dynamic_Normal_PB-DynArtCue_Index_PB		; CPZ
   15670/   19A56 : 0136                		dc.w AnimCue_CPZ_Boss_PB-DynArtCue_Index_PB	; CPZ
   15671/   19A58 : 0044                		dc.w Dynamic_Normal_PB-DynArtCue_Index_PB		; EHZ
   15672/   19A5A : 00AC                		dc.w AnimCue_EHZ_PB-DynArtCue_Index_PB		; EHZ
   15673/   19A5C : 0044                		dc.w Dynamic_Normal_PB-DynArtCue_Index_PB		; HPZ
   15674/   19A5E : 010A                		dc.w AnimCue_HPZ_PB-DynArtCue_Index_PB		; HPZ
   15675/   19A60 : 0040                		dc.w Dynamic_Null_PB-DynArtCue_Index_PB		; HTZ
   15676/   19A62 : 0136                		dc.w AnimCue_CPZ_Boss_PB-DynArtCue_Index_PB		; HTZ
   15677/   19A64 : 0040                		dc.w Dynamic_Null_PB-DynArtCue_Index_PB		; 06
   15678/   19A66 : 0136                		dc.w AnimCue_CPZ_Boss_PB-DynArtCue_Index_PB	; 06
