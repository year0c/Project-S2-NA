(2)  492/   74164 :                     
(2)  493/   74164 :                     ; Set music tempo divider to xx
(2)  494/   74164 :                     smpsSetTempoDiv macro val
(2)  495/   74164 :                     	if SonicDriverVer>=3
(2)  496/   74164 :                     		dc.b	$FF,$04,val
(2)  497/   74164 :                     	else
(2)  498/   74164 :                     		dc.b	$EB,val
(2)  499/   74164 :                     	endif
(2)  500/   74164 :                     	endm
(2)  501/   74164 :                     
(2)  502/   74164 :                     ; ECxx - Set Volume to xx
(2)  503/   74164 :                     smpsSetVol macro val
